# Copia este archivo a "build-secrets.local.ps1" (mismo directorio) y completa los
# valores reales. build-secrets.local.ps1 NO debe subirse nunca a git -- si en algún
# momento esta carpeta raíz pasa a ser un repo, agrégalo a .gitignore de inmediato.
#
# build-all.ps1 lo carga con dot-sourcing (". $root\build-secrets.local.ps1") y falla
# con un mensaje claro si no lo encuentra, en vez de tener las credenciales reales
# hardcodeadas directamente en el script.

$Secrets = @{
    Central = @{
        ConnectionString      = "Server=sqlsap.cdepor.cl,11433;Database=PS_CENTRAL;User Id=saas_temp;Password=CAMBIAR;TrustServerCertificate=True"
        MasterSecretKey       = "CAMBIAR"
        LicensingSigningKey   = "CAMBIAR"
        LicensingPublicKey    = "CAMBIAR"
    }
    ComercialDepor = @{
        ConnectionString      = "Server=sqlsap.cdepor.cl,11433;Database=PS_COMDEPOR;User Id=saas_temp;Password=CAMBIAR;TrustServerCertificate=True"
        MasterSecretKey       = "CAMBIAR"
        LicensingPublicKey    = "CAMBIAR"
    }
}
