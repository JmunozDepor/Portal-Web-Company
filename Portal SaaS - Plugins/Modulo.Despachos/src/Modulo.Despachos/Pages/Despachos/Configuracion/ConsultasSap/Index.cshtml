@page "/despachos/configuracion/consultas-sap"
@model Modulo.Despachos.Pages.Despachos.Configuracion.ConsultasSap.IndexModel
@section Styles {
    <link rel="stylesheet" href="~/css/despachos.css" asp-append-version="true" />
}
@using Modulo.Despachos.Models
@{
    ViewData["Title"] = "Consultas SAP";
    var probed = Model.Probe is not null;
}
@* Mantenedor: una fila por tipo de documento; el SQL se edita en un drawer (textarea monoespaciado).
   "Probar" ejecuta la consulta con un folio y muestra el documento mapeado o los errores;
   "Guardar" solo guarda si la prueba pasa. *@

<div class="card-surface">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-3 flex-wrap">
        <h2 class="mb-0">Consultas SAP</h2>
    </div>

    @if (Model.SuccessMessage is not null)
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <p class="text-muted">
        SQL de solo lectura que busca un documento por folio (parámetro <code>:folio</code>) y devuelve las columnas
        del contrato: <code>doc_entry, doc_num, folio, sii_document_type, document_date, customer_code, customer_name,
        customer_tax_id, destination_address, destination_commune, customer_po, base_order_entry, units, packages,
        total_amount, is_canceled</code> (opcionales: <code>weight_kg, volume_m3</code>). Los nombres de tablas van sin
        esquema: se usa el esquema de la conexión SAP de la compañía.
    </p>
    <p class="text-muted">
        <strong>Líneas de factura</strong> (guías de despacho Res. 154): una fila por línea de la factura con el parámetro
        <code>:doc_entry</code> y las columnas <code>line_num, item_code, item_name, quantity, unit, weight_kg,
        customer_activity, destination_city</code> (giro y ciudad del cliente se repiten en cada fila).
    </p>

    <div class="table-responsive-lg">
        <table class="table-ps" id="tabla-consultas-sap">
            <thead><tr><th>Documento</th><th>Estado</th><th>Última validación</th><th class="col-actions"></th></tr></thead>
            <tbody>
                @foreach (var (kind, q) in Model.Rows)
                {
                    <tr class="@(q is { IsActive: false } ? "row-inactive" : "")">
                        <td>@SapQueryKinds.Label(kind)</td>
                        <td>
                            @if (q is null) { <span class="badge-status badge-status--warning">Sin configurar</span> }
                            else if (!q.IsActive) { <span class="badge-status badge-status--neutral">Inactiva</span> }
                            else { <span class="badge-status badge-status--success">Activa</span> }
                        </td>
                        <td>@(q?.ValidatedAt is { } v ? v.ToString("yyyy-MM-dd HH:mm") + " UTC" : "Nunca (consulta de ejemplo sin probar)")</td>
                        <td class="col-actions">
                            <div class="admin-row-actions">
                                @if (q is null ? Model.CanCreate : Model.CanEdit)
                                {
                                    <button type="button" class="btn-ghost" title="Editar SQL" data-drawer-open="drawer-consultas" data-maestro-edit
                                            data-row="@Model.RowJson(new { Id = q?.Id ?? 0L, DocumentKind = kind, DocumentKindLabel = SapQueryKinds.Label(kind), SqlText = q?.SqlText ?? "", IsActive = q?.IsActive ?? true })"><i class="bi bi-pencil"></i></button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (probed)
{
    var v = Model.Probe!.Validation;
    <div class="card-surface mt-3" id="resultado-prueba">
        <h3>Resultado de la prueba</h3>
        @if (v.IsValid && Model.Probe.Lines is { } ls)
        {
            <div class="alert alert-success">La consulta cumple el contrato: @ls.Lines.Count línea(s).</div>
            <p>Giro del cliente: <strong>@(ls.CustomerActivity ?? "—")</strong> · Ciudad de despacho: <strong>@(ls.DestinationCity ?? "—")</strong></p>
            <div class="table-responsive-lg">
                <table class="table-ps">
                    <thead><tr><th>Línea</th><th>Artículo</th><th>Descripción</th><th class="text-end">Cantidad</th><th>Unidad</th><th class="text-end">Peso (kg)</th></tr></thead>
                    <tbody>
                        @foreach (var l in ls.Lines)
                        {
                            <tr>
                                <td>@l.LineNum</td><td>@l.ItemCode</td><td>@l.ItemName</td>
                                <td class="text-end">@l.Quantity.ToString("0.##")</td><td>@(l.Unit ?? "—")</td>
                                <td class="text-end">@(l.WeightKg?.ToString("0.###") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-muted mt-2 mb-0">Compare artículos, cantidades y pesos con la factura en SAP antes de guardar.</p>
        }
        else if (v.IsValid && Model.Probe.Document is { } d)
        {
            <div class="alert alert-success">La consulta cumple el contrato.</div>
            <div class="table-responsive-lg">
                <table class="table-ps">
                    <tbody>
                        <tr><th>Tipo</th><td>@DocumentKinds.Label(d.DocumentKind) (SII @d.SiiDocumentType)</td><th>Folio</th><td>@d.Folio</td></tr>
                        <tr><th>DocEntry / DocNum</th><td>@d.DocEntry / @d.DocNum</td><th>Fecha</th><td>@d.DocumentDate.ToString("yyyy-MM-dd")</td></tr>
                        <tr><th>Cliente / destino</th><td>@d.CustomerCode - @d.CustomerName</td><th>RUT</th><td>@d.CustomerTaxId</td></tr>
                        <tr><th>Dirección</th><td>@d.DestinationAddress</td><th>Comuna</th><td>@d.DestinationCommune</td></tr>
                        <tr><th>Orden de compra</th><td>@d.CustomerPo</td><th>Pedido base</th><td>@(d.BaseOrderEntry?.ToString() ?? "-")</td></tr>
                        <tr><th>Unidades</th><td>@d.Units.ToString("0.##")</td><th>Bultos</th><td>@d.Packages</td></tr>
                        <tr><th>Monto</th><td>@d.TotalAmount.ToString("N0")</td><th>Anulado</th><td>@(d.IsCanceled ? "Sí" : "No")</td></tr>
                        <tr><th>Peso (kg)</th><td>@(d.WeightKg?.ToString("0.##") ?? "-")</td><th>Volumen (m3)</th><td>@(d.VolumeM3?.ToString("0.##") ?? "-")</td></tr>
                    </tbody>
                </table>
            </div>
            <p class="text-muted mt-2 mb-0">Compare cliente, unidades y bultos con el documento en SAP antes de guardar.</p>
        }
        else if (v.IsValid && Model.Probe.Transfers is { } ts)
        {
            <div class="alert alert-success">La consulta cumple el contrato: @ts.Count transferencia(s).</div>
            <div class="table-responsive-lg">
                <table class="table-ps">
                    <thead><tr><th>DocEntry / DocNum</th><th>Fecha</th><th>LPN</th><th>Bodega destino</th><th>Dirección</th><th>Comuna</th><th class="text-end">Unidades</th><th>Anulada</th></tr></thead>
                    <tbody>
                        @foreach (var t in ts)
                        {
                            <tr>
                                <td>@t.DocEntry / @t.DocNum</td><td>@t.DocumentDate.ToString("yyyy-MM-dd")</td><td>@(t.Lpn ?? "—")</td>
                                <td>@t.WarehouseCode - @t.WarehouseName</td><td>@(t.DestinationAddress ?? "—")</td><td>@(t.DestinationCommune ?? "—")</td>
                                <td class="text-end">@t.Units.ToString("0.##")</td><td>@(t.IsCanceled ? "Sí" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-muted mt-2 mb-0">Compare bodega, LPN y unidades con la transferencia en SAP antes de guardar.</p>
        }
        else if (v.IsValid && Model.Probe.Partner is { } bp)
        {
            <div class="alert alert-success">La consulta cumple el contrato: @bp.CardCode - @bp.Name@(bp.IsActive ? "" : " (inactivo)").</div>
            <p class="mb-2">Giro: @(bp.Activity ?? "—")</p>
            <div class="table-responsive-lg">
                <table class="table-ps">
                    <thead><tr><th>Dirección de despacho</th><th>Calle</th><th>Comuna</th><th>Ciudad</th></tr></thead>
                    <tbody>
                        @foreach (var a in bp.Addresses)
                        {
                            <tr><td>@(a.Name ?? "—")</td><td>@(a.Address ?? "—")</td><td>@(a.Commune ?? "—")</td><td>@(a.City ?? "—")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (v.IsValid && Model.Probe.Warehouses is { } ws)
        {
            <div class="alert alert-success">La consulta cumple el contrato: @ws.Count bodega(s).</div>
            <div class="table-responsive-lg">
                <table class="table-ps">
                    <thead><tr><th>Código</th><th>Nombre</th><th>Dirección</th><th>Comuna</th></tr></thead>
                    <tbody>
                        @foreach (var w in ws)
                        {
                            <tr><td>@w.Code</td><td>@w.Name</td><td>@(w.Address ?? "—")</td><td>@(w.Commune ?? "—")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-danger">@v.Error</div>
            @if (v.MissingColumns.Count > 0)
            {
                <p class="mb-0">Columnas faltantes: <code>@string.Join(", ", v.MissingColumns)</code></p>
            }
        }
    </div>
}

@if (Model.CanCreate || Model.CanEdit)
{
    <button type="button" id="reabrir-drawer" hidden data-drawer-open="drawer-consultas"></button>
    <div id="drawer-consultas" class="drawer-overlay" data-drawer>
        <aside class="drawer-panel">
            <div class="drawer-header">
                <h3 data-drawer-title data-title-new="Consulta SAP" data-title-edit="Editar consulta SAP">Editar consulta SAP</h3>
                <button type="button" class="btn-ghost" data-drawer-close aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <form method="post" asp-page-handler="Save" asp-antiforgery="true" id="form-consultas">
                <div class="drawer-body">
                    <input type="hidden" name="Input.Id" value="@(probed ? Model.Input.Id : 0)" />
                    <input type="hidden" name="Input.DocumentKind" value="@(probed ? Model.Input.DocumentKind : "")" />
                    <div class="mb-3">
                        <label class="form-label" for="f-DocumentKindLabel">Documento</label>
                        <input type="text" id="f-DocumentKindLabel" name="Input.DocumentKindLabel" class="form-control" readonly
                               value="@(probed ? SapQueryKinds.Label(Model.Input.DocumentKind ?? "") : "")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="f-SqlText">SQL (solo SELECT/WITH; parámetros: :folio, :doc_entry en líneas, :lpn, :warehouse y :from_date en transferencias)</label>
                        <textarea id="f-SqlText" name="Input.SqlText" class="form-control" rows="22" spellcheck="false" required
                                  style="font-family:ui-monospace,Consolas,monospace;font-size:.8rem;white-space:pre;">@(probed ? Model.Input.SqlText : "")</textarea>
                    </div>
                    <div class="mb-3 d-flex align-items-end ">
                        <label class="d-flex align-items-center gap-2"><input type="checkbox" name="Input.IsActive" value="true" checked="@(!probed || Model.Input.IsActive)" /> Activa</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="f-Sample">@(probed ? Modulo.Despachos.Pages.Despachos.Configuracion.ConsultasSap.IndexModel.SampleLabel(Model.Input.DocumentKind) : "Muestra de prueba") (folio, DocEntry, LPN o bodega según la consulta)</label>
                        <input type="text" id="f-Sample" name="Input.Sample" class="form-control" placeholder="Un dato real en SAP" autocomplete="off"
                               value="@Model.Input.Sample" />
                    </div>
                </div>
                <div class="drawer-footer">
                    <button type="button" class="btn btn-secondary" data-drawer-close>Cancelar</button>
                    <button type="submit" class="btn btn-secondary" asp-page-handler="Probe" formmethod="post">Probar</button>
                    <button type="submit" class="btn btn-primary" data-submit-label data-label-new="Guardar" data-label-edit="Guardar">Guardar</button>
                </div>
            </form>
        </aside>
    </div>
}

@section Scripts {
    <script src="~/js/table-tools.js"></script>
    <script src="~/js/despachos-maestros.js" asp-append-version="true"></script>
    @if (probed)
    {
        <script>
            // Tras "Probar" la página se recarga: se reabre el drawer con lo digitado.
            document.addEventListener('DOMContentLoaded', function () {
                var b = document.getElementById('reabrir-drawer');
                if (b) { b.click(); }
            });
        </script>
    }
}
