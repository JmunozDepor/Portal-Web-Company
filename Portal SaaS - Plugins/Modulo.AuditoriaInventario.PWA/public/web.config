<?xml version="1.0" encoding="UTF-8"?>
<!--
  Se copia tal cual a dist/ en cada `npm run build` (carpeta public/ de Vite, sin
  configuración extra). Pensado para la IIS Application hermana de "/Depor" descripta
  en docs/10-RUNBOOK-IIS-PILOTO.md ("Portal SaaS - Core"): NO necesita AspNetCoreModule,
  esto es contenido 100% estático (HTML/JS/CSS + service worker), no hay proceso .NET
  detrás de esta Application.

  Requiere el módulo "URL Rewrite" de IIS (gratuito, de Microsoft) para la regla de
  abajo: sin él, recargar una ruta interna de React (ej. /sesiones) da 404 en vez de
  servir index.html y dejar que react-router tome el control.

  IMPORTANTE: un comentario XML nunca puede contener dos guiones seguidos, en ningún
  lado del texto. IIS lo rechaza con 500.19 al arrancar (bug real encontrado acá
  mismo, 2026-10-14). Revisar esto antes de agregar texto nuevo a este archivo.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- IIS no trae .webmanifest registrado por defecto: sin esto, el manifest se
           sirve como texto plano y el navegador no ofrece "instalar" la PWA. -->
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <rewrite>
      <rules>
        <!-- SPA fallback: cualquier URL que no sea un archivo/carpeta físico real
             (ej. /sesiones, /mantenedor, cualquier ruta interna de react-router)
             sirve index.html en su lugar, y react-router toma el control desde ahí
             del lado del cliente. El "url" es relativo a ESTA IIS Application, no
             hace falta repetir el alias de la aplicación. -->
        <rule name="SPA fallback a index.html" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <!-- Sin barra inicial a proposito: con "/index.html" IIS interpreta la ruta
               como absoluta desde la raiz del SITIO (Default Web Site), no desde esta
               Application ("/Depor_pwa"). Como no hay index.html en la raiz del
               sitio, cualquier URL que caiga en este fallback (ej. /login) terminaba
               en 404 real, aunque "/Depor_pwa/" (que sirve el documento default
               directamente, sin pasar por este rewrite) cargaba bien. Bug real
               encontrado en logs de IIS, 2026-10-14, ver u_ex261014.log. -->
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>

  <!-- index.html y el service worker NUNCA deben quedar cacheados por el
       navegador/proxy intermedio: son los dos archivos que "apuntan" a la versión
       nueva del build (el resto de los assets llevan hash en el nombre, esos sí
       pueden cachearse para siempre sin riesgo). Sin esto, un capturador puede
       seguir viendo una versión vieja de la PWA después de un despliegue nuevo
       hasta que el navegador decida revalidar solo. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="sw.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
