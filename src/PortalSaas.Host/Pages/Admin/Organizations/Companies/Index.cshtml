@page "{organizationId:guid}"
@model PortalSaas.Host.Pages.Admin.Organizations.Companies.IndexModel
@{
    ViewData["Title"] = $"Compañías · {Model.Organization.LegalName}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Compañías de @Model.Organization.LegalName</h1>
        <a asp-page="/Admin/Organizations/Index">Volver a organizaciones</a>
    </div>
    @if (Model.TieneInstancias)
    {
        <a asp-page="/Admin/Organizations/Companies/Create" asp-route-organizationId="@Model.Organization.Id" class="btn btn-primary">Nueva compañía</a>
    }
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (!Model.TieneInstancias)
{
    <p class="text-warning">
        Esta organización todavía no tiene ninguna instancia. Crea una
        <a asp-page="/Admin/Organizations/Instances/Index" asp-route-organizationId="@Model.Organization.Id">acá</a>
        antes de poder agregar una compañía.
    </p>
}

<div class="document-list-table-wrapper">
    <table class="table document-list-table">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Instancia</th>
            <th>Base de datos</th>
            <th>País</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var company in Model.Companies)
        {
            <tr>
                <td>@company.Code</td>
                <td>@company.Name</td>
                <td>@company.Instance.Name</td>
                <td>@company.DatabaseName</td>
                <td>@company.Country</td>
                <td>@(company.IsActive ? "Activa" : "Inactiva")</td>
                <td>
                    <a asp-page="/Admin/Organizations/Companies/Edit" asp-route-id="@company.Id">Editar</a>
                    ·
                    <a asp-page="/Admin/Organizations/Companies/ExternalConnections/Index" asp-route-companyId="@company.Id">Conexiones externas</a>
                    ·
                    <form method="post" asp-page-handler="TestConnection" asp-route-organizationId="@Model.Organization.Id" asp-route-companyId="@company.Id" class="d-inline">
                        <button type="submit" class="btn btn-link p-0 align-baseline">Probar conexión</button>
                    </form>
                    ·
                    <form asp-page="./Index" asp-page-handler="Delete" asp-route-organizationId="@Model.Organization.Id" asp-route-id="@company.Id" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar la compañía @company.Code?');">
                        <button type="submit" class="btn btn-link text-danger p-0 align-baseline">Eliminar</button>
                    </form>
                </td>
            </tr>
            @if (Model.TestedCompanyId == company.Id && Model.TestResult is not null)
            {
                <tr>
                    <td colspan="7">
                        <div class="alert @(Model.TestResult.DatabaseSuccess && Model.TestResult.ServiceLayerSuccess ? "alert-success" : "alert-warning") mb-0">
                            <div>
                                Base de datos (@company.Instance.EngineType):
                                @if (Model.TestResult.DatabaseSuccess)
                                {
                                    <strong class="text-success">OK</strong>
                                }
                                else
                                {
                                    <strong class="text-danger">FALLÓ</strong> <span>&mdash;</span> <code>@Model.TestResult.DatabaseError</code>
                                }
                            </div>
                            <div>
                                Service Layer:
                                @if (Model.TestResult.ServiceLayerSuccess)
                                {
                                    <strong class="text-success">OK</strong>
                                }
                                else
                                {
                                    <strong class="text-danger">FALLÓ</strong> <span>&mdash;</span> <code>@Model.TestResult.ServiceLayerError</code>
                                }
                            </div>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
</div>

@if (Model.Companies.Count == 0)
{
    <p class="text-muted">Todavía no hay compañías para esta organización.</p>
}
