@model PortalSaas.Abstractions.Modelos.MenuNodeDto
@{
    var isFolder = Model.PagePath is null;
    var currentPath = Context.Request.Path.Value ?? "/";

    // Capturado en una variable local ANTES de limpiar ViewData -- Default.cshtml solo
    // fija esto para el nodo raíz (colorIndex), y <partial> sin view-data explícito
    // hereda el ViewData actual por referencia -- sin limpiarlo acá, un subgrupo
    // anidado (nivel > 0) heredaría el mismo chip de color de su carpeta raíz (bug
    // real que la referencia evita a propósito, ver theme.css: "Subgrupo anidado...
    // sin chip, visualmente subordinado a su carpeta raíz").
    var rootIconStyle = ViewData["RootIconStyle"] as string;
    ViewData["RootIconStyle"] = null;
    var esGrupoRaiz = rootIconStyle is not null;

    // Acota el accordion de Bootstrap (data-bs-parent) al contenedor <ul> INMEDIATO
    // de este nodo -- así abrir una carpeta cierra automáticamente sus carpetas
    // HERMANAS (mismo nivel, mismo padre) al hacer click, sin tocar carpetas de otras
    // ramas del árbol. Qué queda abierto al CARGAR la página ya no depende de nada del
    // navegador (ver ContieneRutaActiva más abajo y sidebar.js) -- es el servidor el
    // que decide, en cada request, según la ruta activa. sidebar.js ya NO persiste
    // grupos abiertos en localStorage (bug real que eso causaba: click en un submenú
    // reabría OTRO grupo sin relación, "recordado" de una exploración anterior en la
    // misma sesión del navegador -- confirmado con curl que el servidor ya devolvía el
    // HTML correcto, el problema era 100% esa persistencia del lado del cliente).
    var parentContainerId = ViewData["ParentContainerId"] as string;
}
@if (isFolder)
{
    var collapseId = $"menu-node-{Model.Id}";
    var childrenContainerId = $"menu-children-{Model.Id}";

    // Server-side: si la página activa está en algún nivel de este árbol, la carpeta
    // arranca YA abierta (class="show" + aria-expanded="true"). Sin esto, el <div
    // class="collapse"> arranca cerrado en cada request (esta app recarga la página
    // entera en cada navegación) y sidebar.js recién lo abre después del DOMContentLoaded
    // -- visible como el submenú "cerrándose y volviendo a abrirse" con la animación de
    // Bootstrap en cada click (bug real reportado, "el menú se recarga" -- no era la
    // navegación en sí, era esta animación de apertura tardía).
    var estaActivo = ContieneRutaActiva(Model, currentPath);
    var collapseClass = estaActivo ? "collapse show" : "collapse";
    <li class="sidebar-nav-item">
        <a class="sidebar-nav-grupo @(esGrupoRaiz ? "sidebar-nav-grupo-raiz" : "")" data-bs-toggle="collapse" href="#@collapseId" role="button"
           aria-expanded="@(estaActivo ? "true" : "false")" aria-controls="@collapseId" data-bs-parent="@(parentContainerId is not null ? "#" + parentContainerId : null)" style="@rootIconStyle">
            <span class="nav-icon"><i class="@(Model.Icon ?? "bi bi-folder")"></i></span>
            <span class="nav-texto">@Model.Name</span>
            <i class="bi bi-chevron-down sidebar-grupo-chevron"></i>
        </a>
        <div class="@collapseClass" id="@collapseId">
            <ul class="sidebar-nav sidebar-nav-sub" id="@childrenContainerId">
                @{ ViewData["ParentContainerId"] = childrenContainerId; }
                @foreach (var child in Model.Children)
                {
                    <partial name="~/Pages/Shared/Components/SidebarMenu/_MenuNode.cshtml" model="child" />
                }
            </ul>
        </div>
    </li>
}
else
{
    var href = Url.Content("~" + Model.PagePath);
    <li>
        <a href="@href" class="@(EsRutaActivaOSubruta(Model.PagePath, currentPath) ? "active" : "")">
            <span class="nav-icon"><i class="@(Model.Icon ?? "bi bi-circle")"></i></span>
            <span class="nav-texto">@Model.Name</span>
        </a>
    </li>
}
@functions {
    private static bool ContieneRutaActiva(PortalSaas.Abstractions.Modelos.MenuNodeDto node, string currentPath)
    {
        if (EsRutaActivaOSubruta(node.PagePath, currentPath))
        {
            return true;
        }

        foreach (var child in node.Children)
        {
            if (ContieneRutaActiva(child, currentPath))
            {
                return true;
            }
        }

        return false;
    }

    // Por igualdad exacta sola, el detalle de un documento (ej. "/ventas/ordenes/61065")
    // nunca calzaba con la ruta registrada del menú (el listado, "/ventas/ordenes") --
    // el grupo se veía como "no activo" apenas se entraba al detalle, y sidebar.js lo
    // volvía a abrir con animación después de cargar (bug real reportado: "si entro al
    // detalle de un pedido, el menú se recarga/parpadea" -- pasaba SOLO al entrar al
    // detalle, nunca al quedarse en el listado, justo el patrón de un match por
    // igualdad exacta fallando en la subruta).
    private static bool EsRutaActivaOSubruta(string? pagePath, string currentPath)
    {
        if (pagePath is null)
        {
            return false;
        }

        return currentPath.Equals(pagePath, StringComparison.OrdinalIgnoreCase)
            || currentPath.StartsWith(pagePath + "/", StringComparison.OrdinalIgnoreCase);
    }
}
