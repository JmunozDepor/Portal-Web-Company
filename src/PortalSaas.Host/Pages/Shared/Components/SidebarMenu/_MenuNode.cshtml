@model PortalSaas.Abstractions.Modelos.MenuNodeDto
@{
    var isFolder = Model.PagePath is null;
    var currentPath = Context.Request.Path.Value ?? "/";

    // Capturado en una variable local ANTES de limpiar ViewData -- Default.cshtml solo
    // fija esto para el nodo raíz (colorIndex), y <partial> sin view-data explícito
    // hereda el ViewData actual por referencia -- sin limpiarlo acá, un subgrupo
    // anidado (nivel > 0) heredaría el mismo chip de color de su carpeta raíz (bug
    // real que la referencia evita a propósito, ver theme.css: "Subgrupo anidado...
    // sin chip, visualmente subordinado a su carpeta raíz").
    var rootIconStyle = ViewData["RootIconStyle"] as string;
    ViewData["RootIconStyle"] = null;
    var esGrupoRaiz = rootIconStyle is not null;

    // Acota el accordion de Bootstrap (data-bs-parent) al contenedor <ul> INMEDIATO
    // de este nodo -- así abrir una carpeta cierra automáticamente sus carpetas
    // HERMANAS (mismo nivel, mismo padre), sin tocar carpetas de otras ramas del
    // árbol. Bug real que esto corrige: sin data-bs-parent, Bootstrap nunca cierra
    // nada solo -- y como sidebar.js persiste en localStorage cada grupo que
    // alguna vez se mostró (esta app recarga la página entera en cada navegación,
    // no es una SPA), con el tiempo terminaban quedando "recordados" como
    // expandidos varios subgrupos hermanos a la vez (ej. Rendidor/Aprobador/
    // Administrador de Modulo.Rendiciones todos abiertos juntos, aunque el click
    // actual solo pedía abrir uno). Con el accordion real, Bootstrap dispara
    // hidden.bs.collapse sobre los hermanos que cierra, y sidebar.js ya los saca
    // solo de localStorage (ver su listener existente) -- autocorrige el estado
    // viejo con el uso normal, sin necesitar limpiar nada a mano.
    var parentContainerId = ViewData["ParentContainerId"] as string;
}
@if (isFolder)
{
    var collapseId = $"menu-node-{Model.Id}";
    var childrenContainerId = $"menu-children-{Model.Id}";
    <li class="sidebar-nav-item">
        <a class="sidebar-nav-grupo @(esGrupoRaiz ? "sidebar-nav-grupo-raiz" : "")" data-bs-toggle="collapse" href="#@collapseId" role="button"
           aria-expanded="false" aria-controls="@collapseId" data-bs-parent="@(parentContainerId is not null ? "#" + parentContainerId : null)" style="@rootIconStyle">
            <span class="nav-icon"><i class="@(Model.Icon ?? "bi bi-folder")"></i></span>
            <span class="nav-texto">@Model.Name</span>
            <i class="bi bi-chevron-down sidebar-grupo-chevron"></i>
        </a>
        <div class="collapse" id="@collapseId">
            <ul class="sidebar-nav sidebar-nav-sub" id="@childrenContainerId">
                @{ ViewData["ParentContainerId"] = childrenContainerId; }
                @foreach (var child in Model.Children)
                {
                    <partial name="~/Pages/Shared/Components/SidebarMenu/_MenuNode.cshtml" model="child" />
                }
            </ul>
        </div>
    </li>
}
else
{
    var href = Url.Content("~" + Model.PagePath);
    <li>
        <a href="@href" class="@(currentPath == Model.PagePath ? "active" : "")">
            <span class="nav-icon"><i class="@(Model.Icon ?? "bi bi-circle")"></i></span>
            <span class="nav-texto">@Model.Name</span>
        </a>
    </li>
}
