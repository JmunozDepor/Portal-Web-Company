@page "/rendiciones/gastos/detalle/{id:long?}"
@model Modulo.Rendiciones.Pages.Gastos.DetalleModel
@using Modulo.Rendiciones.Pages
@{
    ViewData["Title"] = Model.IsNew ? "Nuevo gasto" : "Editar gasto";
}
@section Styles {
    <link rel="stylesheet" href="~/css/rendiciones.css" asp-append-version="true" />
}

<div class="card-ps admin-card rnd-detalle-card">
    <div class="admin-card-header">
        <h2>@(Model.IsNew ? "Nuevo gasto" : "Editar gasto")</h2>
        <a asp-page="/Gastos/Importar" class="btn-module-action">Importar con OCR (PDF/foto)</a>
    </div>

@if (Model.SuccessMessage is not null)
{
    <div class="admin-alert admin-alert-success">@Model.SuccessMessage</div>
}
@if (Model.WarningMessage is not null)
{
    <div class="admin-alert admin-alert-warning">@Model.WarningMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="admin-alert admin-alert-danger">@Model.ErrorMessage</div>
}

@if (Model.Expense is not null && Model.Expense.Status != "Loose")
{
    var e = Model.Expense;
    var status = Modulo.Rendiciones.Pages.Gastos.IndexModel.StatusToShow(e);
    var hasReceiptView = e.ExpenseReceiptId is not null;
    var receiptViewUrl = hasReceiptView ? Url.Page("./Comprobante", new { id = e.Id }) : null;
    <p class="admin-muted"><i class="bi bi-info-circle"></i> Este gasto ya pertenece a un informe -- desvinculalo desde el informe primero para poder editarlo. Por ahora podés revisarlo:</p>

    <div class="@(hasReceiptView ? "rnd-gasto-split" : "")">
        <div class="rnd-gasto-view">
            <div class="rnd-view-top">
                <span class="rnd-view-date">Fecha: @e.Date.ToString("dd/MM/yyyy")</span>
                <span class="rnd-badge @RendicionesUi.BadgeClass(status)">@status</span>
            </div>
            <div class="rnd-view-header">
                <h3>@(e.SupplierName ?? e.ExpenseType?.Name ?? "Gasto")</h3>
                <span class="rnd-view-amount">@e.Currency @e.Amount.ToString("N0")</span>
            </div>

            @if (Model.PolicyLabel is not null)
            {
                <div class="rnd-view-policy"><i class="bi bi-shield-check"></i> Política: <strong>@Model.PolicyLabel</strong></div>
            }

            <div class="rnd-view-grid">
                <div class="rnd-view-field">
                    <span class="rnd-view-label">Neto</span>
                    <span class="rnd-view-value">@((e.Amount - (e.TaxAmount ?? 0)).ToString("N0")) @e.Currency</span>
                </div>
                <div class="rnd-view-field">
                    <span class="rnd-view-label">Impuesto</span>
                    <span class="rnd-view-value">@((e.TaxAmount ?? 0).ToString("N0")) @e.Currency</span>
                </div>
                <div class="rnd-view-field">
                    <span class="rnd-view-label">Categoría</span>
                    <span class="rnd-view-value">@(e.ExpenseType?.Name ?? "—")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(e.ExpenseType?.SapGlAccount))
                {
                    <div class="rnd-view-field">
                        <span class="rnd-view-label">Cuenta contable</span>
                        <span class="rnd-view-value">@e.ExpenseType!.SapGlAccount</span>
                    </div>
                }
                <div class="rnd-view-field">
                    <span class="rnd-view-label">Tipo de documento</span>
                    <span class="rnd-view-value">@(e.DocumentType?.Name ?? "—")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(e.DocumentNumber))
                {
                    <div class="rnd-view-field">
                        <span class="rnd-view-label">Número de documento</span>
                        <span class="rnd-view-value">@e.DocumentNumber</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(e.SupplierTaxId))
                {
                    <div class="rnd-view-field">
                        <span class="rnd-view-label">RUT proveedor</span>
                        <span class="rnd-view-value">@e.SupplierTaxId</span>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(e.Notes))
            {
                <div class="rnd-view-notes">
                    <span class="rnd-view-label">Nota</span>
                    <p>@e.Notes</p>
                </div>
            }
        </div>
        @if (hasReceiptView)
        {
            <div class="rnd-gasto-visor">
                <div class="rnd-gasto-visor-header">
                    <span><i class="bi bi-paperclip"></i> Comprobante</span>
                    <div class="rnd-visor-actions">
                        <a href="@receiptViewUrl" target="_blank" title="Expandir / abrir visor completo"><i class="bi bi-arrows-fullscreen"></i></a>
                        <a href="@Url.Page("./ComprobanteArchivo", new { id = e.Id })" download title="Descargar"><i class="bi bi-download"></i></a>
                    </div>
                </div>
                <iframe src="@receiptViewUrl" title="Comprobante"></iframe>
            </div>
        }
    </div>
}
else
{
    var hasReceipt = Model.Expense?.ExpenseReceiptId is not null;
    var receiptUrl = hasReceipt ? Url.Page("./Comprobante", new { id = Model.Expense!.Id }) : null;
    <div class="@(hasReceipt ? "rnd-gasto-split" : "")">
        <div class="rnd-gasto-form">
            <div class="rnd-policy-chip">
                <span class="rnd-policy-chip-label"><i class="bi bi-shield-check"></i> Política</span>
                <span class="rnd-policy-chip-value">@Model.ApprovalGroupSummary</span>
                <span class="rnd-policy-chip-sub">Centros de costo: @Model.CostCenterSummary</span>
            </div>
            <form method="post" asp-page-handler="Guardar" enctype="multipart/form-data">
                @* id vía input oculto, no asp-route-id -- asp-route-id="@Model.Expense?.Id" con
                   valor null (gasto nuevo) rompía el FormTagHelper por completo: ni action ni
                   el token antiforgery se generaban, el POST caía en la URL base sin handler
                   y la página se re-renderizaba sin ejecutar ningún código, en silencio. *@
                @if (Model.Expense is not null)
                {
                    <input type="hidden" name="id" value="@Model.Expense.Id" />
                }
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="Input.ExpenseTypeId">Categoría del gasto</label>
                    <select asp-for="Input.ExpenseTypeId" class="form-control" id="rnd-select-tipo-gasto">
                        <option value="">-- Seleccionar --</option>
                        @foreach (var t in Model.ExpenseTypes)
                        {
                            <option value="@t.Id" data-es-kilometraje="@t.IsMileage.ToString().ToLowerInvariant()">@t.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Input.ExpenseTypeId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.DocumentTypeId">Tipo de documento</label>
                    <select asp-for="Input.DocumentTypeId" class="form-control">
                        <option value="">-- Sin especificar --</option>
                        @foreach (var t in Model.DocumentTypes)
                        {
                            <option value="@t.Id">@t.Name @(t.AppliesTax ? $"(IVA {t.TaxPercentage}%)" : "")</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Date">Fecha</label>
                    <input asp-for="Input.Date" class="form-control" />
                </div>

                <div id="rnd-campos-km" style="display:none;">
                    <div class="form-group">
                        <label asp-for="Input.Origin">Origen</label>
                        <input asp-for="Input.Origin" class="form-control" placeholder="Ej. Av. Providencia 1234, Providencia" />
                        <span asp-validation-for="Input.Origin" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Input.Destination">Destino</label>
                        <input asp-for="Input.Destination" class="form-control" placeholder="Ej. Av. Apoquindo 4501, Las Condes" />
                        <span asp-validation-for="Input.Destination" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <button type="button" id="rnd-btn-calcular-ruta" class="btn-module-action">Calcular ruta</button>
                        <p id="rnd-resultado-ruta" class="text-muted mt-2"></p>
                    </div>
                </div>

                <div id="rnd-campos-normales">
                    <div class="form-group">
                        <label asp-for="Input.Amount">Monto total</label>
                        <input asp-for="Input.Amount" class="form-control" />
                        <span asp-validation-for="Input.Amount" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Input.TaxAmount">Monto IVA</label>
                        <input asp-for="Input.TaxAmount" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Input.Currency">Moneda</label>
                        <input asp-for="Input.Currency" class="form-control" maxlength="3" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Input.DocumentNumber">Folio</label>
                        <input asp-for="Input.DocumentNumber" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Input.SupplierTaxId">RUT proveedor</label>
                        <input asp-for="Input.SupplierTaxId" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Input.SupplierName">Proveedor</label>
                        <input asp-for="Input.SupplierName" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Input.Receipt">Comprobante (boleta/factura)</label>
                        <input asp-for="Input.Receipt" type="file" class="form-control" accept="image/*,application/pdf" capture="environment" />
                        @if (hasReceipt)
                        {
                            <div class="form-text">Ya tiene un comprobante cargado -- subí uno nuevo solo si querés reemplazarlo.</div>
                        }
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Notes">Glosa</label>
                    <input asp-for="Input.Notes" class="form-control" />
                </div>

                <button type="submit" class="btn-erp-primary">Guardar gasto</button>
                @if (!Model.IsNew)
                {
                    <button type="submit" asp-page="./Detalle" asp-page-handler="Eliminar" asp-route-id="@Model.Expense!.Id" class="btn-module-action btn-module-danger"
                            onclick="return confirm('¿Eliminar este gasto? No se puede deshacer.');">
                        Eliminar
                    </button>
                }
            </form>
        </div>
        @if (hasReceipt)
        {
            <div class="rnd-gasto-visor">
                <div class="rnd-gasto-visor-header">
                    <span><i class="bi bi-paperclip"></i> Comprobante</span>
                    <div class="rnd-visor-actions">
                        <button type="button" class="rnd-visor-action-btn" id="rnd-btn-reemplazar-comprobante" title="Cargar nueva imagen">
                            <i class="bi bi-upload"></i>
                        </button>
                        <a href="@receiptUrl" target="_blank" title="Expandir / abrir visor completo"><i class="bi bi-arrows-fullscreen"></i></a>
                        <a href="@Url.Page("./ComprobanteArchivo", new { id = Model.Expense!.Id })" download title="Descargar"><i class="bi bi-download"></i></a>
                        <button type="submit" form="rnd-form-eliminar-comprobante" class="rnd-visor-action-btn rnd-visor-action-danger" title="Eliminar comprobante"
                                onclick="return confirm('¿Eliminar el comprobante de este gasto?');">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
                <iframe src="@receiptUrl" title="Comprobante"></iframe>
            </div>
            <form method="post" asp-page-handler="EliminarComprobante" asp-route-id="@Model.Expense!.Id" id="rnd-form-eliminar-comprobante"></form>
        }
    </div>
}
</div>

<script>
    (function () {
        var selectTipo = document.getElementById('rnd-select-tipo-gasto');
        var camposKm = document.getElementById('rnd-campos-km');
        var camposNormales = document.getElementById('rnd-campos-normales');
        var btnCalcular = document.getElementById('rnd-btn-calcular-ruta');
        var resultadoEl = document.getElementById('rnd-resultado-ruta');
        if (!selectTipo) return;

        function esKilometraje() {
            var opcion = selectTipo.options[selectTipo.selectedIndex];
            return !!opcion && opcion.dataset.esKilometraje === 'true';
        }

        function actualizarVisibilidad() {
            var esKm = esKilometraje();
            camposKm.style.display = esKm ? '' : 'none';
            camposNormales.style.display = esKm ? 'none' : '';
        }

        selectTipo.addEventListener('change', actualizarVisibilidad);
        actualizarVisibilidad();

        // Botón "Cargar nueva imagen" del visor -- reusa el <input type="file"> ya presente
        // en el formulario de metadatos (Input.Receipt) en vez de duplicar la lógica de
        // subida; al elegir el archivo, se envía el formulario completo de una (mismos datos
        // ya cargados desde OnGetAsync, el usuario no pierde nada de lo tipeado).
        var btnReemplazar = document.getElementById('rnd-btn-reemplazar-comprobante');
        var inputComprobante = document.querySelector('input[name="Input.Receipt"]');
        if (btnReemplazar && inputComprobante) {
            btnReemplazar.addEventListener('click', function () { inputComprobante.click(); });
            inputComprobante.addEventListener('change', function () {
                if (inputComprobante.files.length > 0) {
                    inputComprobante.closest('form').submit();
                }
            });
        }

        if (btnCalcular) {
            btnCalcular.addEventListener('click', function () {
                var origen = document.querySelector('[name="Input.Origin"]').value;
                var destino = document.querySelector('[name="Input.Destination"]').value;
                var tipoGastoId = selectTipo.value;
                if (!origen || !destino || !tipoGastoId) {
                    resultadoEl.textContent = 'Completá tipo de gasto, origen y destino.';
                    return;
                }

                resultadoEl.textContent = 'Calculando...';
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var body = new URLSearchParams({
                    __RequestVerificationToken: token,
                    expenseTypeId: tipoGastoId,
                    origen: origen,
                    destino: destino
                });

                fetch(window.location.pathname + '?handler=PrevisualizarRuta', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: body
                })
                    .then(function (resp) { return resp.json(); })
                    .then(function (datos) {
                        if (datos.ok) {
                            resultadoEl.textContent = 'Distancia: ' + datos.distanciaKm + ' km -- Monto estimado: $' + datos.monto.toLocaleString('es-CL');
                        } else {
                            resultadoEl.textContent = datos.error;
                        }
                    })
                    .catch(function () {
                        resultadoEl.textContent = 'No se pudo calcular la ruta.';
                    });
            });
        }
    })();
</script>
