@page
@model PortalSaas.Host.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-3">Iniciar sesión</h1>

        @if (Model.ErrorMessage is not null)
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form method="post">
            <input type="hidden" asp-for="Input.ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Input.OrganizationSlug" class="form-label"></label>
                <input asp-for="Input.OrganizationSlug" class="form-control" autocomplete="organization" autofocus />
                <span asp-validation-for="Input.OrganizationSlug" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.EmailOrUsername" class="form-label"></label>
                <input asp-for="Input.EmailOrUsername" class="form-control" autocomplete="username" />
                <span asp-validation-for="Input.EmailOrUsername" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Entrar</button>
        </form>

        <p class="mt-3">
            <a asp-page="/Account/ForgotPassword">¿Olvidaste tu contraseña?</a>
        </p>
    </div>
</div>
