@page "/wms/mapeo-campos"
@model Modulo.Wms.Pages.MapeoCampos.IndexModel
@{
    ViewData["Title"] = "Mapeo de Campos";
}
@* Migrado al Design System unificado (2026-08-19). *@

<div class="card-surface">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
        <h2 class="mb-0">Mapeo de Campos</h2>
        <button type="button" class="btn-primary" data-drawer-open="drawer-nuevo-mapeo">+ Nuevo mapeo</button>
    </div>

@if (Model.SuccessMessage is not null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<table class="table-ps">
    <thead><tr><th>Documento</th><th>Campo UDF</th><th>Valor / Plantilla</th><th>Estado</th><th>Actualizado</th><th class="col-actions"></th></tr></thead>
    <tbody>
        @foreach (var m in Model.Mappings)
        {
            var formId = $"mapeo-{m.Id}";
            <tr class="@(m.IsActive ? "" : "row-inactive")">
                <td>@(Model.MapperKeyLabels.GetValueOrDefault(m.MapperKey, m.MapperKey))</td>
                <td><code>@m.FieldName</code></td>
                <td><input type="text" name="valueTemplate" value="@m.ValueTemplate" class="form-control" form="@formId" /></td>
                <td>
                    <input type="hidden" name="activo" value="@(m.IsActive ? "true" : "false")" form="@formId" />
                    @if (m.IsActive)
                    {
                        <span class="badge-status badge-status--success">Activo</span>
                    }
                    else
                    {
                        <span class="badge-status badge-status--neutral">Inactivo</span>
                    }
                </td>
                <td>@m.UpdatedAt.ToString("yyyy-MM-dd HH:mm") @(m.UpdatedBy is not null ? $"({m.UpdatedBy})" : "")</td>
                <td class="col-actions">
                    <div class="admin-row-actions">
                        <button type="submit" class="btn-ghost" title="Guardar" form="@formId"><i class="bi bi-check-lg"></i></button>
                        @if (m.IsActive)
                        {
                            <form asp-page="./Index" asp-page-handler="Desactivar" asp-route-id="@m.Id" asp-route-valueTemplate="@m.ValueTemplate" method="post" class="d-inline-block">
                                <button type="submit" class="btn-ghost btn-ghost--danger" title="Desactivar"><i class="bi bi-slash-circle"></i></button>
                            </form>
                        }
                        else
                        {
                            <form asp-page="./Index" asp-page-handler="Activar" asp-route-id="@m.Id" asp-route-valueTemplate="@m.ValueTemplate" method="post" class="d-inline-block">
                                <button type="submit" class="btn-ghost" title="Activar"><i class="bi bi-check-circle"></i></button>
                            </form>
                        }
                    </div>
                </td>
            </tr>
        }
        @if (Model.Mappings.Count == 0)
        {
            <tr><td colspan="6" class="text-muted">Sin mapeos todavía.</td></tr>
        }
    </tbody>
</table>

@foreach (var m in Model.Mappings)
{
    <form id="mapeo-@m.Id" asp-page="./Index" asp-page-handler="Guardar" asp-route-id="@m.Id"></form>
}
</div>

<datalist id="tipos-gasto-cuentas-datalist"></datalist>

@{ var mapeoDrawerAbierto = !ViewData.ModelState.IsValid; }
<div id="drawer-nuevo-mapeo" class="drawer-overlay @(mapeoDrawerAbierto ? "is-open" : "")" data-drawer>
    <aside class="drawer-panel @(mapeoDrawerAbierto ? "is-open" : "")">
        <div class="drawer-header">
            <h3>Nuevo mapeo</h3>
            <button type="button" class="btn-ghost" data-drawer-close aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
        </div>
        <form method="post" asp-page-handler="Crear">
            <div class="drawer-body">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="New.MapperKey" class="form-label">Documento</label>
                    <select asp-for="New.MapperKey" class="form-select">
                        @foreach (var kv in Model.MapperKeyLabels)
                        {
                            <option value="@kv.Key">@kv.Value</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="New.FieldName" class="form-label">Campo UDF</label>
                    <input asp-for="New.FieldName" class="form-control" placeholder="U_..." />
                </div>
                <div class="mb-3">
                    <label asp-for="New.ValueTemplate" class="form-label">Valor / Plantilla</label>
                    <input asp-for="New.ValueTemplate" class="form-control" placeholder="Ej: Y (literal) o {lpn} / {header.MessageId}" />
                </div>
                <div class="mb-3 d-flex align-items-center gap-2">
                    <label class="d-flex align-items-center gap-2"><input asp-for="New.IsActive" type="checkbox" /> Activo (se envía a SAP)</label>
                </div>
                <p class="text-muted">
                    Literal (ej. <code>Y</code>) o plantilla con placeholders: <code>{lpn}</code> / <code>{shipmentNbr}</code>
                    / <code>{header.NombreColumna}</code> (cualquier columna de la fila de staging origen).
                </p>
            </div>
            <div class="drawer-footer">
                <button type="button" class="btn-secondary" data-drawer-close>Cancelar</button>
                <button type="submit" class="btn-primary">Crear</button>
            </div>
        </form>
    </aside>
</div>
