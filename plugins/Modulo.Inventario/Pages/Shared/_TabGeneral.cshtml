@model Modulo.Inventario.Pages.DetailGenericInventoryDocumentModelBase
@{
    var readOnly = Model.Document.ReadOnly;
}

@if (!Model.IsNew)
{
    <div class="row mb-3">
        <div class="col-md-3">
            <label class="form-label">N° documento</label>
            <input class="form-control" value="@Model.DocNum" disabled />
        </div>
    </div>
}

<div class="row mb-3">
    <div class="col-md-6">
        <label asp-for="Input.FromWarehouseCode" class="form-label"></label>
        <select asp-for="Input.FromWarehouseCode" asp-items="Model.Warehouses" class="form-select" disabled="@readOnly">
            <option value="">Seleccionar…</option>
        </select>
        <span asp-validation-for="Input.FromWarehouseCode" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.ToWarehouseCode" class="form-label"></label>
        <select asp-for="Input.ToWarehouseCode" asp-items="Model.Warehouses" class="form-select" disabled="@readOnly">
            <option value="">Seleccionar…</option>
        </select>
        <span asp-validation-for="Input.ToWarehouseCode" class="text-danger"></span>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-4">
        <label asp-for="Input.DocDate" class="form-label"></label>
        <input asp-for="Input.DocDate" type="date" class="form-control" disabled="@readOnly" />
    </div>
    <div class="col-md-4">
        <label asp-for="Input.DocDueDate" class="form-label"></label>
        <input asp-for="Input.DocDueDate" type="date" class="form-control" disabled="@readOnly" />
    </div>
</div>

<div class="mb-3">
    <label asp-for="Input.Comments" class="form-label"></label>
    <textarea asp-for="Input.Comments" class="form-control" rows="3" disabled="@readOnly"></textarea>
</div>
