@page "/auditoria-inventario/productos"
@model Modulo.AuditoriaInventario.Pages.MaestroProductos.IndexModel
@{
    ViewData["Title"] = "Maestro de Productos";

    string ConstruirUrlPagina(int pagina) =>
        $"~/auditoria-inventario/productos?pagina={pagina}&tamanoPagina={Model.TamanoPagina}&buscar={Uri.EscapeDataString(Model.Buscar ?? string.Empty)}";
}

<div class="card-surface">
    <h2 class="mb-1">Maestro de Productos</h2>
    <p class="text-muted mb-3">
        Catálogo de códigos de barra (EAN) que la PWA de captura sincroniza a cada
        equipo para validar los escaneos contra el maestro.
    </p>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.SyncStatus is { EnCurso: true } enCurso)
    {
        <meta http-equiv="refresh" content="5" />
        <div class="alert alert-info">
            Sincronización con SAP en curso desde las @enCurso.IniciadoEn.ToLocalTime().ToString("HH:mm")
            -- @enCurso.Procesados.ToString("N0") artículo(s) procesados hasta ahora.
            Esta página se actualiza sola cada 5 segundos.
        </div>
    }
    else if (Model.SyncStatus is { Error: true } fallo)
    {
        <div class="alert alert-danger">@fallo.Mensaje</div>
    }
    else if (Model.SyncStatus is { Mensaje: not null } ok)
    {
        <div class="alert alert-success">@ok.Mensaje</div>
    }

    <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
        <form method="post" asp-page-handler="SincronizarSap">
            <button type="submit" class="btn-primary d-inline-flex align-items-center gap-2" disabled="@(Model.SyncStatus?.EnCurso == true)">
                <i class="bi bi-cloud-arrow-down"></i>
                @(Model.SyncStatus?.EnCurso == true ? "Sincronizando…" : "Sincronizar desde SAP")
            </button>
        </form>
        <a class="btn-secondary d-inline-flex align-items-center gap-2" asp-page-handler="DescargarJson">
            <i class="bi bi-filetype-json"></i>
            Descargar maestro (JSON)
        </a>
        <span class="text-muted ms-2">@Model.TotalProductos.ToString("N0") producto(s) cargado(s) en total.</span>
    </div>
    <p class="text-muted mb-4" style="margin-top:-0.5rem;">
        El JSON descargado se copia al equipo y se carga desde la PWA en Mantenedor →
        "Cargar desde archivo (JSON)", para aprovisionar sin conectividad.
    </p>

    <form method="get" class="d-flex align-items-end gap-3 flex-wrap mb-3">
        <div class="mb-0 flex-grow-1" style="max-width:360px;">
            <label for="buscar" class="form-label">Buscar</label>
            <input id="buscar" name="Buscar" class="form-control" value="@Model.Buscar" placeholder="Código de barra, código de producto o descripción..." />
        </div>
        <div class="mb-0" style="min-width:120px;">
            <label for="tamano-pagina" class="form-label">Por página</label>
            <select id="tamano-pagina" name="TamanoPagina" class="form-select">
                @foreach (var tamano in Model.TamanosDisponibles)
                {
                    <option value="@tamano" selected="@(tamano == Model.TamanoPagina)">@tamano</option>
                }
            </select>
        </div>
        <button type="submit" class="btn-secondary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(Model.Buscar))
        {
            <a href="~/auditoria-inventario/productos" class="btn-ghost">Limpiar</a>
        }
    </form>

    @if (Model.TotalFiltrado == 0)
    {
        <p class="text-muted">
            @(string.IsNullOrWhiteSpace(Model.Buscar) ? "Todavía no hay productos cargados." : $"Ningún producto coincide con \"{Model.Buscar}\".")
        </p>
    }
    else
    {
        <p class="text-muted mb-2">
            @Model.TotalFiltrado.ToString("N0") producto(s)@(string.IsNullOrWhiteSpace(Model.Buscar) ? "" : " encontrados") ·
            página @Model.Pagina de @Model.TotalPaginas
        </p>
        <div class="document-list-table-wrapper">
            <table class="table document-list-table mb-0">
                <thead>
                    <tr>
                        <th>Código de barra</th>
                        <th>Código de producto</th>
                        <th>Descripción</th>
                        <th>Origen</th>
                        <th>Cargado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Productos)
                    {
                        <tr>
                            <td>@p.Barcode</td>
                            <td>@p.ProductCode</td>
                            <td>@p.Description</td>
                            <td>@p.Source</td>
                            <td>@p.LoadedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex align-items-center justify-content-center gap-3 mt-3">
            <a class="btn-secondary @(Model.Pagina <= 1 ? "disabled" : "")"
               href="@(Model.Pagina <= 1 ? "#" : ConstruirUrlPagina(Model.Pagina - 1))">« Anterior</a>
            <span class="text-muted">Página @Model.Pagina de @Model.TotalPaginas</span>
            <a class="btn-secondary @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")"
               href="@(Model.Pagina >= Model.TotalPaginas ? "#" : ConstruirUrlPagina(Model.Pagina + 1))">Siguiente »</a>
        </div>
    }
</div>
