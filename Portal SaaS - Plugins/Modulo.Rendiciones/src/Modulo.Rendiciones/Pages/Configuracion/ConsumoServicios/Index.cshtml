@page "/rendiciones/configuracion/consumo-servicios"
@model Modulo.Rendiciones.Pages.Configuracion.ConsumoServicios.IndexModel
@{
    ViewData["Title"] = "Consumo de servicios externos";
}
@section Styles {
    <link rel="stylesheet" href="~/css/rendiciones.css" asp-append-version="true" />
}

<div class="card-surface">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-1">
        <h2 class="mb-0">Consumo de servicios externos</h2>
        <a asp-page="/Configuracion/Proveedores/Index" class="btn-secondary">Administrar proveedores</a>
    </div>

<p class="text-muted mb-3">
    Uso del período de cuota vigente de cada proveedor configurado -- por <strong>mes</strong> para
    Azure, por <strong>día</strong> para Google Gemini (capa gratuita ~1500/día, se reinicia a
    medianoche hora del Pacífico). Podés tener más de una cuenta por servicio (ver
    "Administrar proveedores"): al llegar al límite de una, el servicio pasa automáticamente a
    la siguiente por prioridad -- solo cuando TODAS las cuentas de un mismo servicio están al
    límite se deshabilita esa funcionalidad hasta el próximo período (no se cobra de más ni se
    corta el resto del módulo).
</p>
@* Nota de alcance: las .rnd-consumo-tile/.rnd-progreso (barra de progreso por
   proveedor) siguen viniendo de rendiciones.css a propósito -- son un
   componente visual (tile con barra de uso) sin equivalente en el set
   cerrado de 5 componentes; agregarlo ahí sería inventar un componente nuevo
   fuera de esta pasada de migración. El resto de la página (card/alert/texto)
   ya usa el Design System unificado. *@

<div class="rnd-consumo-lista">
    @foreach (var c in Model.Usages)
    {
        var estado = c.LimitReached ? "rnd-consumo-danger" : c.PercentageUsed >= 80 ? "rnd-consumo-warning" : "";
        <div class="rnd-consumo-tile @estado">
            <div class="rnd-consumo-header">
                <span class="rnd-consumo-nombre">
                    @Model.DisplayName(c.ServiceType) — @c.ProviderName
                    @if (!c.IsActive)
                    {
                        <span class="text-muted">(inactivo)</span>
                    }
                </span>
                <span class="rnd-consumo-cifras">@c.Used.ToString("N0") / @c.Limit.ToString("N0") @Model.DisplayUnit(c.ServiceType) por @c.PeriodLabel</span>
            </div>
            <div class="rnd-progreso">
                <div class="rnd-progreso-relleno" style="width:@(Math.Round(c.PercentageUsed, 1).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
            </div>
            @if (c.LimitReached)
            {
                <p class="rnd-consumo-mensaje">Límite alcanzado -- este proveedor queda deshabilitado hasta el próximo @c.PeriodLabel.</p>
            }
        </div>
    }
    @if (Model.Usages.Count == 0)
    {
        <p class="text-muted">No hay proveedores configurados todavía -- agregá uno en "Administrar proveedores".</p>
    }
</div>
</div>
