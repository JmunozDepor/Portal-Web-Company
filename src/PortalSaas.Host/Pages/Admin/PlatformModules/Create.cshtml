@page
@model PortalSaas.Host.Pages.Admin.PlatformModules.CreateModel
@{
    ViewData["Title"] = "Nuevo módulo";
}

<div class="card-ps doc-form doc-tab-seccion mb-4">
    <div class="doc-form-header">
        <h2>Nuevo módulo</h2>
    </div>
    <form method="post" asp-antiforgery="true">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Input.Code" class="form-label"></label>
                @if (Model.AvailablePlugins.Count > 0)
                {
                    <select asp-for="Input.Code" class="form-select" autofocus>
                        <option value="">Seleccionar…</option>
                        @foreach (var plugin in Model.AvailablePlugins)
                        {
                            <option value="@plugin.ModuleCode">@plugin.ModuleCode — @plugin.Name</option>
                        }
                    </select>
                }
                else
                {
                    <p class="text-muted small mb-0">
                        No hay plugins cargados sin módulo comercial todavía (todos los cargados ya
                        tienen fila acá, o no hay ninguno cargado en este proceso).
                    </p>
                }
                <span asp-validation-for="Input.Code" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>

            <div class="form-group form-check">
                <input asp-for="Input.IsCore" class="form-check-input" />
                <label asp-for="Input.IsCore" class="form-check-label"></label>
            </div>

            <div class="form-group form-group-ancho-completo">
                <label asp-for="Input.ExclusiveOrganizationId" class="form-label"></label>
                <select asp-for="Input.ExclusiveOrganizationId" class="form-select">
                    <option value="">— Ninguna (vendible a cualquier organización) —</option>
                    @foreach (var org in Model.Organizations)
                    {
                        <option value="@org.Id">@org.LegalName</option>
                    }
                </select>
            </div>
        </div>

        <button type="submit" class="btn btn-primary mt-3">Crear</button>
        <a asp-page="/Admin/PlatformModules/Index" class="btn btn-link mt-3">Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
