@page "/wms/dashboard"
@model Modulo.Wms.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard WMS";
}
@* Migrado al Design System unificado (2026-09-07): sin paleta --wms-* con hex a
   fuego, todo el color sale de design-tokens.css. El <style> de abajo es SOLO ajuste
   de densidad/legibilidad de esta pantalla (scoped a .wms-dashboard, no toca el CSS
   compartido del Host) -- pedido explícito: el dashboard del WMS original se leía más
   grande y las 2 tablas del medio tenían alto de fila desparejo. *@

<style>
    /* --- Ajustes locales del Dashboard WMS (2026-09-07) --- */
    .wms-dashboard .kpi-tile-value { font-size: 30px; }
    .wms-dashboard .kpi-tile-label { font-size: 11.5px; }

    /* Tipografía de tabla un punto más grande que el default del DS (13px). */
    .wms-dashboard .line-items-table { font-size: 14px; }
    .wms-dashboard .line-items-table thead th { font-size: 11.5px; }

    /* Alto de fila idéntico en "Transacciones por tipo" y "Panorama general": la
       primera tiene pill de estado (más alta que texto plano) y en columna angosta
       llegaba a envolver en 2 líneas. Padding vertical fijo + pill en una sola línea. */
    .wms-dashboard .line-items-table td { padding-top: .6rem; padding-bottom: .6rem; line-height: 1.45; }
    .wms-dashboard .line-items-table tbody tr { height: 46px; }
    .wms-dashboard .badge-status { white-space: nowrap; }

    /* Barra de período + botón de refresco (como el dashboard original). */
    .wms-dashboard .dash-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .wms-dashboard .dash-updated { font-size: 12px; color: var(--text-muted); white-space: nowrap; }
    .wms-dashboard .dash-refresh {
        display: inline-flex; align-items: center; justify-content: center;
        width: 32px; height: 32px; border-radius: var(--radius-sm);
        border: 1px solid var(--card-border); background: var(--card-bg);
        color: var(--text-main); text-decoration: none; font-size: 16px; line-height: 1;
    }
    .wms-dashboard .dash-refresh:hover { background: color-mix(in srgb, var(--bs-primary) 8%, transparent); }
</style>

<div class="wms-dashboard">

<div class="doc-list-header">
    <h2 class="h4 mb-0">Dashboard de Integración WMS</h2>
    <div class="dash-toolbar">
        <span class="dash-updated">Actualizado @DateTime.Now.ToString("HH:mm:ss")</span>
        <div class="btn-group">
            <a class="btn btn-sm @(Model.DiasAtras == 1 ? "btn-primary" : "btn-secondary")" asp-route-DiasAtras="1">Hoy</a>
            <a class="btn btn-sm @(Model.DiasAtras == 7 ? "btn-primary" : "btn-secondary")" asp-route-DiasAtras="7">7 días</a>
            <a class="btn btn-sm @(Model.DiasAtras == 30 ? "btn-primary" : "btn-secondary")" asp-route-DiasAtras="30">30 días</a>
        </div>
        <a class="dash-refresh" asp-route-DiasAtras="@Model.DiasAtras" title="Actualizar" aria-label="Actualizar">&#x21bb;</a>
    </div>
</div>

@if (Model.Resumen.ItemsEnviadosSinConfirmarProximosAFallar > 0)
{
    <div class="alert alert-warning d-flex gap-2 py-2 px-3 small mb-3">
        <span>&#9888;</span>
        <div>
            <strong>@Model.Resumen.ItemsEnviadosSinConfirmarProximosAFallar producto(s) enviados</strong> siguen sin confirmación
            de Oracle WMS Cloud tras 15 o más reintentos (de 20 máximo) &mdash; puede ser backlog normal de Oracle procesando el
            envío, pero si llegan a 20 intentos pasan automáticamente a <strong>Error WMS</strong>.
            <a asp-page="/Transacciones/Index" asp-route-Tipo="EnvioProducto" asp-route-Estado="Enviado">Ver en Transacciones</a>.
        </div>
    </div>
}

<div class="kpi-row">
    <div class="kpi-tile" style="--kpi-accent: var(--text-muted);">
        <p class="kpi-tile-label">Total transacciones</p>
        <div class="kpi-tile-value">@Model.Resumen.TotalTransacciones.ToString("N0")</div>
    </div>
    <div class="kpi-tile" style="--kpi-accent: var(--bs-success);">
        <p class="kpi-tile-label">Confirmadas en WMS</p>
        <div class="kpi-tile-value text-success">@Model.Resumen.TotalOk.ToString("N0")</div>
    </div>
    <div class="kpi-tile" style="--kpi-accent: var(--accent);">
        <p class="kpi-tile-label">Enviadas, sin confirmar</p>
        <div class="kpi-tile-value" style="color: var(--accent);">@Model.Resumen.TotalEnviado.ToString("N0")</div>
    </div>
    <div class="kpi-tile" style="--kpi-accent: var(--bs-warning);">
        <p class="kpi-tile-label">Pendientes de enviar</p>
        <div class="kpi-tile-value text-warning">@Model.Resumen.TotalPendiente.ToString("N0")</div>
    </div>
    <div class="kpi-tile" style="--kpi-accent: var(--bs-danger);">
        <p class="kpi-tile-label">Con error</p>
        <div class="kpi-tile-value text-danger">@Model.Resumen.TotalError.ToString("N0")</div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="card-ps h-100">
            <div class="doc-list-header mb-2">
                <h3 class="h6 mb-0">Transacciones por tipo</h3>
                <span class="doc-list-contador mb-0">@(Model.DiasAtras == 1 ? "Hoy" : $"últimos {Model.DiasAtras} días")</span>
            </div>
            <div class="table-responsive">
                <table class="table table-striped document-list-table line-items-table align-middle mb-0">
                    <thead><tr><th>Tipo</th><th class="text-end">OK</th><th class="text-end">Enviado</th><th class="text-end">Error</th><th class="text-end">Pend.</th><th>Últ. ejec.</th></tr></thead>
                    <tbody>
                    @foreach (var fila in Model.Resumen.PorTipo)
                    {
                        <tr>
                            <td>@fila.Label</td>
                            <td class="text-end text-success">@fila.Ok.ToString("N0")</td>
                            <td class="text-end" style="color: var(--accent);">@fila.Enviado.ToString("N0")</td>
                            <td class="text-end text-danger">@fila.Error.ToString("N0")</td>
                            <td class="text-end text-warning">@fila.Pendiente.ToString("N0")</td>
                            <td>
                                @if (fila.UltimaEjecucion is null)
                                {
                                    <span class="badge-status badge-status--neutral">sin datos</span>
                                }
                                else if (fila.UltimoEstado == "ERROR")
                                {
                                    <span class="badge-status badge-status--danger">error &middot; @fila.UltimaEjecucion.Value.ToLocalTime().ToString("dd-MM HH:mm")</span>
                                }
                                else if (fila.Total == 0)
                                {
                                    <span class="badge-status badge-status--neutral">sin actividad &middot; @fila.UltimaEjecucion.Value.ToLocalTime().ToString("dd-MM HH:mm")</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-status--success">@fila.UltimaEjecucion.Value.ToLocalTime().ToString("dd-MM HH:mm")</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card-ps h-100">
            <div class="doc-list-header mb-2">
                <h3 class="h6 mb-0">Panorama general</h3>
                <span class="doc-list-contador mb-0">todo el histórico</span>
            </div>
            <div class="table-responsive">
                <table class="table table-striped document-list-table line-items-table align-middle mb-0">
                    <thead><tr><th>Tipo</th><th class="text-end">Confirmado</th><th class="text-end">Enviado</th><th class="text-end">Error</th><th class="text-end">Pend.</th></tr></thead>
                    <tbody>
                    @foreach (var fila in Model.Historico.PorTipo)
                    {
                        <tr>
                            <td>@fila.Label</td>
                            <td class="text-end text-success">@fila.Ok.ToString("N0")</td>
                            <td class="text-end" style="color: var(--accent);">@fila.Enviado.ToString("N0")</td>
                            <td class="text-end text-danger">@fila.Error.ToString("N0")</td>
                            <td class="text-end text-warning">@fila.Pendiente.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="card-ps">
    <div class="doc-list-header mb-2">
        <h3 class="h6 mb-0">Estado de los procesadores</h3>
        <span class="doc-list-contador mb-0">procesos del módulo WMS &middot; heartbeat en vivo</span>
    </div>
    <div class="row g-2">
        @foreach (var proc in Model.Resumen.Procesadores)
        {
            var esError = string.Equals(proc.Status, "ERROR", StringComparison.OrdinalIgnoreCase);
            var sinConfig = string.Equals(proc.Status, "SIN_CONFIG", StringComparison.OrdinalIgnoreCase);
            var accent = proc.SinEjecutar ? "var(--text-muted)"
                : esError ? "var(--bs-danger)"
                : sinConfig ? "var(--bs-warning)"
                : "var(--bs-success)";
            var badgeClase = proc.SinEjecutar ? "badge-status--neutral"
                : esError ? "badge-status--danger"
                : sinConfig ? "badge-status--warning"
                : "badge-status--success";
            var badgeTexto = proc.SinEjecutar ? "sin ejecutar" : sinConfig ? "sin config" : (proc.Status ?? "—");
            <div class="col-md-6 col-lg-3">
                <div class="kpi-tile h-100" style="--kpi-accent: @accent;">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <span class="small fw-semibold">@proc.Nombre</span>
                        <span class="badge-status @badgeClase">@badgeTexto</span>
                    </div>
                    <div class="text-muted mt-1" style="font-size: 11px; font-family: var(--wms-mono, ui-monospace, monospace);">
                        @proc.ProcessorKey &middot; cada @proc.CadaSegundos s
                    </div>
                    <div class="small text-muted mt-1">
                        @(proc.LastRunAt?.ToLocalTime().ToString("dd-MM HH:mm:ss") ?? "nunca corrió en esta compañía")
                        <span class="badge-status badge-status--neutral ms-1">@proc.Etapa</span>
                    </div>
                    @if (esError && !string.IsNullOrEmpty(proc.LastError))
                    {
                        <div class="text-danger small mt-1">@proc.LastError</div>
                    }
                </div>
            </div>
        }
    </div>
    <p class="text-muted mt-2 mb-0" style="font-size: 11px;">
        El envío SAP&nbsp;&rarr;&nbsp;WMS Cloud (Bajada/Subida) lo programa el motor de Integraciones de la plataforma
        y no se lista acá &mdash; su bitácora está en <em>Admin &rsaquo; Integraciones</em>.
    </p>
</div>

</div>
