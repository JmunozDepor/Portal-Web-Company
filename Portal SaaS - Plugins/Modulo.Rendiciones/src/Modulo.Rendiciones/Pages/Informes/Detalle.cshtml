@page "/rendiciones/informes/{id:long}"
@using Modulo.Rendiciones.Models
@model Modulo.Rendiciones.Pages.Informes.DetalleModel
@{
    ViewData["Title"] = $"Informe #{Model.Report.Id}";

    // Cada gasto del informe se muestra con el MISMO formulario de "Nuevo/Editar gasto"
    // pero bloqueado (fieldset disabled), para identificar de un vistazo los valores
    // cargados -- pedido explícito. Función local para no depender de un partial (las
    // vistas del plugin se cargan por AssemblyLoadContext).
    void RenderLineReview(ExpenseReportLine d)
    {
        var esKm = d.ExpenseType?.IsMileage == true;
        var hasReceipt = d.ExpenseReceiptId is not null;
        var receiptUrl = hasReceipt ? Url.Page("/Gastos/Comprobante", new { id = d.Id }) : null;
        <div class="@(hasReceipt ? "rnd-gasto-split" : "")">
            <div class="rnd-gasto-form rnd-review">
                <fieldset disabled>
                    <div class="form-group"><label>Categoría del gasto</label><input class="form-control" value="@(d.ExpenseType?.Name ?? "")" /></div>
                    <div class="form-group"><label>Tipo de documento</label><input class="form-control" value="@(d.DocumentType?.Name ?? "")" /></div>
                    <div class="form-group"><label>Fecha</label><input class="form-control" value="@d.Date.ToString("dd-MM-yyyy")" /></div>
                    <div class="form-group"><label>Hora</label><input class="form-control" value="@(d.TransactionTime?.ToString("HH:mm") ?? "")" /></div>
                    @if (esKm)
                    {
                        <div class="form-group"><label>Origen</label><input class="form-control" value="@d.Origin" /></div>
                        <div class="form-group"><label>Destino</label><input class="form-control" value="@d.Destination" /></div>
                        <div class="form-group"><label>Distancia (km)</label><input class="form-control" value="@(d.DistanceKm?.ToString("N2") ?? "")" /></div>
                        <div class="form-group"><label>Tarifa por km</label><input class="form-control" value="@(d.AppliedRatePerKm?.ToString("N2") ?? "")" /></div>
                    }
                    <div class="form-group"><label>Monto total</label><input class="form-control" value="@d.Amount.ToString("N2")" /></div>
                    @if (!esKm)
                    {
                        <div class="form-group"><label>Monto neto / afecto</label><input class="form-control" value="@(d.NetAmount?.ToString("N2") ?? "")" /></div>
                        <div class="form-group"><label>Monto exento</label><input class="form-control" value="@(d.ExemptAmount?.ToString("N2") ?? "")" /></div>
                        <div class="form-group"><label>Monto IVA</label><input class="form-control" value="@(d.TaxAmount?.ToString("N2") ?? "")" /></div>
                    }
                    <div class="form-group"><label>Moneda</label><input class="form-control" value="@d.Currency" /></div>
                    <div class="form-group"><label>Folio</label><input class="form-control" value="@d.DocumentNumber" /></div>
                    <div class="form-group"><label>RUT proveedor</label><input class="form-control" value="@d.SupplierTaxId" /></div>
                    <div class="form-group"><label>Proveedor</label><input class="form-control" value="@d.SupplierName" /></div>
                    <div class="form-group"><label>Glosa</label><input class="form-control" value="@d.Notes" /></div>
                </fieldset>
            </div>
            @if (hasReceipt)
            {
                <div class="rnd-gasto-visor">
                    <div class="rnd-gasto-visor-header">
                        <span><i class="bi bi-paperclip"></i> Comprobante</span>
                        <div class="rnd-visor-actions">
                            <a href="@receiptUrl" target="_blank" title="Expandir / abrir visor completo"><i class="bi bi-arrows-fullscreen"></i></a>
                            <a href="@Url.Page("/Gastos/ComprobanteArchivo", new { id = d.Id })" download title="Descargar"><i class="bi bi-download"></i></a>
                        </div>
                    </div>
                    <iframe src="@receiptUrl" title="Comprobante" loading="lazy"></iframe>
                </div>
            }
        </div>
    }
}
@section Styles {
    <link rel="stylesheet" href="~/css/rendiciones.css" asp-append-version="true" />
}

<div class="card-ps admin-card">
    <div class="admin-card-header">
        <h2>
            Informe #@Model.Report.Id
            @if (!string.IsNullOrWhiteSpace(Model.Report.InternalNumber))
            {
                <span class="admin-muted">· N.º interno @Model.Report.InternalNumber</span>
            }
        </h2>
        <a asp-page="./Index" class="btn-module-action">&larr; Volver</a>
        <span class="admin-muted">@Model.Report.Status @(Model.Report.Round > 1 ? $"· ronda {Model.Report.Round}" : "")</span>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Report.Purpose))
    {
        <p class="admin-muted" style="margin-top:-4px;"><i class="bi bi-tag"></i> @Model.Report.Purpose</p>
    }

@if (Model.SuccessMessage is not null)
{
    <div class="admin-alert admin-alert-success">@Model.SuccessMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="admin-alert admin-alert-danger">@Model.ErrorMessage</div>
}

<div class="admin-subcard">
    <h3>Cabecera</h3>
    <form method="post" asp-page-handler="GuardarCabecera" asp-route-id="@Model.Report.Id">
        <div class="form-group">
            <label asp-for="Header.Purpose">Glosa / concepto del informe</label>
            <input asp-for="Header.Purpose" class="form-control" maxlength="500"
                   placeholder="Ej. Viaje a Antofagasta - visita a cliente" disabled="@(!Model.IsEditable)" />
            <span asp-validation-for="Header.Purpose" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Header.InternalNumber">Número interno de reporte</label>
            <input asp-for="Header.InternalNumber" class="form-control" maxlength="50"
                   placeholder="El que usa la empresa (distinto del #@Model.Report.Id)" disabled="@(!Model.IsEditable)" />
            <span asp-validation-for="Header.InternalNumber" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Header.CostCenterCode">Centro de costo</label>
            <select asp-for="Header.CostCenterCode" class="form-control" disabled="@(!Model.IsEditable)">
                <option value="">-- Sin especificar --</option>
                @foreach (var c in Model.CostCenters)
                {
                    <option value="@c.Code">@c.Code - @c.Name</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label asp-for="Header.ExpenseFundId">Fondo por rendir asociado</label>
            <select asp-for="Header.ExpenseFundId" class="form-control" disabled="@(!Model.IsEditable)">
                <option value="">-- Sin fondo (reembolso directo) --</option>
                @foreach (var f in Model.OpenFunds)
                {
                    <option value="@f.Id">@f.Currency @f.Amount.ToString("N2") - @f.DeliveredAt.ToString("dd-MM-yyyy")</option>
                }
            </select>
        </div>
        @if (Model.IsEditable)
        {
            <button type="submit" class="btn-module-action">Guardar cabecera</button>
        }
    </form>
</div>

<div class="admin-subcard">
    <h3>Gastos incluidos</h3>

    @if (Model.Report.Lines.Count == 0)
    {
        <p class="admin-muted">Sin gastos todavía.</p>
    }
    else
    {
        <div class="rnd-review-list">
            @foreach (var d in Model.Report.Lines.OrderBy(x => x.Date))
            {
                <details class="rnd-review-line" open>
                    <summary>
                        <span class="rnd-review-sum-main">
                            <strong>@d.Date.ToString("dd-MM-yyyy")</strong>
                            <span>· @(d.ExpenseType?.Name ?? "Sin categoría")</span>
                            <span class="admin-muted">· @(d.SupplierName ?? "sin proveedor")</span>
                        </span>
                        <span class="rnd-review-sum-amount">@d.Currency @d.Amount.ToString("N2")</span>
                    </summary>
                    <div class="rnd-review-body">
                        @{ RenderLineReview(d); }
                        <div class="rnd-review-actions">
                            @if (d.ExpenseReceiptId is not null)
                            {
                                <a asp-page="/Gastos/Comprobante" asp-route-id="@d.Id" target="_blank" class="btn-module-action"><i class="bi bi-paperclip"></i> Ver comprobante</a>
                            }
                            else
                            {
                                <span class="admin-muted"><i class="bi bi-paperclip"></i> Sin comprobante adjunto</span>
                            }
                            @if (Model.IsEditable)
                            {
                                @if (d.ExpenseReceiptId is not null)
                                {
                                    <form asp-page="./Detalle" asp-page-handler="QuitarComprobante" asp-route-id="@Model.Report.Id" asp-route-lineId="@d.Id" method="post" style="display:inline-block;"
                                          onsubmit="return confirm('¿Quitar el documento adjunto de este gasto?');">
                                        <button type="submit" class="btn-module-action btn-module-danger"><i class="bi bi-x"></i> Quitar documento</button>
                                    </form>
                                }
                                <form asp-page="./Detalle" asp-page-handler="DesvincularGasto" asp-route-id="@Model.Report.Id" asp-route-lineId="@d.Id" method="post" style="display:inline-block;">
                                    <button type="submit" class="btn-module-action btn-module-danger">Quitar del informe</button>
                                </form>
                            }
                        </div>
                    </div>
                </details>
            }
        </div>
        <div class="rnd-review-total">
            <span>Total</span>
            <strong>@Model.Report.Lines.Sum(d => d.Amount).ToString("N2")</strong>
        </div>
    }

    @if (Model.IsEditable)
    {
        <div class="admin-subcard">
            <h4>Agregar gastos sueltos</h4>
            @if (Model.LooseExpensesToAdd.Count > 0)
            {
                <form method="post" asp-page-handler="AgregarGastos" asp-route-id="@Model.Report.Id">
                    <table class="admin-table">
                        <thead><tr><th></th><th>Fecha</th><th>Categoría</th><th>Proveedor</th><th>Monto</th></tr></thead>
                        <tbody>
                            @foreach (var g in Model.LooseExpensesToAdd)
                            {
                                <tr>
                                    <td><input type="checkbox" name="ExpenseIdsToAdd" value="@g.Id" /></td>
                                    <td>@g.Date.ToString("dd-MM-yyyy")</td>
                                    <td>@(g.ExpenseType?.Name ?? "—")</td>
                                    <td>@g.SupplierName</td>
                                    <td>@g.Currency @g.Amount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button type="submit" class="btn-module-action">+ Agregar seleccionados</button>
                </form>
            }
            else
            {
                <p class="admin-muted">No tenés más gastos sueltos para agregar -- registrá uno nuevo en "Mis Gastos".</p>
            }
        </div>
    }
</div>

@if (Model.IsEditable)
{
    <div class="admin-row-actions">
        <form method="post" asp-page-handler="Enviar" asp-route-id="@Model.Report.Id"
              onsubmit="return confirm('¿Enviar el informe a aprobación? No vas a poder editarlo mientras esté pendiente.');" style="display:inline-block;">
            <button type="submit" class="btn-erp-primary">Enviar a aprobación</button>
        </form>
        @if (Model.IsOwner)
        {
            <form method="post" asp-page-handler="Eliminar" asp-route-id="@Model.Report.Id"
                  onsubmit="return confirm('¿Eliminar este informe borrador? Los gastos incluidos volverán a \"Mis Gastos\" como sueltos.');" style="display:inline-block;">
                <button type="submit" class="btn-module-action btn-module-danger">Eliminar informe</button>
            </form>
        }
    </div>
}

@if (Model.IsCurrentApprover)
{
    <div class="admin-subcard">
        <h3>Decisión — nivel @Model.Report.CurrentLevel</h3>
        <div class="admin-row-actions">
            <form method="post" asp-page-handler="Aprobar" asp-route-id="@Model.Report.Id">
                <div class="form-group">
                    <label>Comentario (opcional)</label>
                    <input name="Comment" class="form-control" />
                </div>
                <button type="submit" class="btn-erp-primary">Aprobar</button>
            </form>
            <form method="post" asp-page-handler="Rechazar" asp-route-id="@Model.Report.Id"
                  onsubmit="return confirm('¿Rechazar este informe? El dueño va a poder corregirlo y reenviarlo.');">
                <div class="form-group">
                    <label>Comentario (opcional)</label>
                    <input name="Comment" class="form-control" />
                </div>
                <button type="submit" class="btn-module-action btn-module-danger">Rechazar</button>
            </form>
        </div>
    </div>
}

@if (Model.CanReopen)
{
    <form method="post" asp-page-handler="Reabrir" asp-route-id="@Model.Report.Id">
        <button type="submit" class="btn-module-action">Corregir y reenviar</button>
    </form>
}

@if (Model.History.Count > 0)
{
    <div class="admin-subcard">
        <h3>Historial de aprobación</h3>
        <table class="admin-table">
            <thead><tr><th>Fecha</th><th>Nivel</th><th>Decisión</th><th>Comentario</th></tr></thead>
            <tbody>
                @foreach (var a in Model.History)
                {
                    <tr>
                        <td>@a.OccurredAt.ToString("dd-MM-yyyy HH:mm")</td>
                        <td>@a.Level</td>
                        <td>@a.Decision</td>
                        <td>@a.Comment</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</div>
