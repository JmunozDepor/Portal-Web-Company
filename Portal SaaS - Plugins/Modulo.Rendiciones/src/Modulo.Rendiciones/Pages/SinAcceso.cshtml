@page "/rendiciones/sin-acceso"
@model Modulo.Rendiciones.Pages.SinAccesoModel
@{
    ViewData["Title"] = "Rendiciones";
}

<div class="card-surface" style="max-width:600px;">
    <h2 class="h5 mb-2"><i class="bi bi-shield-lock"></i> No formás parte del proceso de Rendiciones</h2>
    <p class="text-muted mb-3">
        Tu usuario todavía no fue agregado al proceso de Rendiciones de esta compañía, así que
        no podés declarar gastos, aprobar informes ni administrar el módulo.
    </p>
    <p class="text-muted mb-3">
        Para sumarte, un <strong>administrador del módulo</strong> tiene que agregarte desde
        <strong>Configuración › Usuarios y roles</strong> y asignarte un rol (Rendidor, Aprobador o Administrador).
    </p>
    <a href="~/" class="btn-secondary">Volver al inicio</a>
</div>
