@page
@model PortalSaas.Host.Pages.Admin.Plans.IndexModel
@{
    ViewData["Title"] = "Planes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Planes</h1>
    <a asp-page="/Admin/Plans/Create" class="btn btn-primary">Nuevo plan</a>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="document-list-table-wrapper">
    <table class="table document-list-table">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Límite usuarios</th>
            <th>Límite compañías</th>
            <th>Límite transacciones/mes</th>
            <th>Precio mensual</th>
            <th>Activo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var plan in Model.Plans)
        {
            <tr>
                <td>@plan.Code</td>
                <td>@plan.Name</td>
                <td>@(plan.UserLimit?.ToString() ?? "Ilimitado")</td>
                <td>@(plan.CompanyLimit?.ToString() ?? "Ilimitado")</td>
                <td>@(plan.MonthlyTransactionLimit?.ToString() ?? "Ilimitado")</td>
                <td>@(plan.MonthlyPrice is null ? "—" : $"{plan.MonthlyPrice:N0} {plan.Currency}")</td>
                <td>@(plan.IsActive ? "Sí" : "No")</td>
                <td>
                    <a asp-page="/Admin/Plans/Edit" asp-route-id="@plan.Id">Editar</a>
                    ·
                    <form asp-page="./Index" asp-page-handler="Delete" asp-route-id="@plan.Id" method="post" style="display:inline"
                          onsubmit="return confirm('¿Eliminar el plan @plan.Code?');">
                        <button type="submit" class="btn btn-link text-danger p-0">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@if (Model.Plans.Count == 0)
{
    <p class="text-muted">Todavía no hay planes.</p>
}
