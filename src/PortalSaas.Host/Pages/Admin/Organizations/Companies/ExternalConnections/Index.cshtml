@page "{companyId:guid}"
@model PortalSaas.Host.Pages.Admin.Organizations.Companies.ExternalConnections.IndexModel
@{
    ViewData["Title"] = $"Conexiones externas · {Model.Company.Code}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Conexiones externas de @Model.Company.Code &mdash; @Model.Company.Name</h1>
        <a asp-page="/Admin/Organizations/Companies/Index" asp-route-organizationId="@Model.Company.OrganizationId">Volver a compañías</a>
    </div>
    <a asp-page="/Admin/Organizations/Companies/ExternalConnections/Create" asp-route-companyId="@Model.Company.Id" class="btn btn-primary">Nueva conexión</a>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<p class="text-muted">
    Conexión propia de un plugin a una base de datos EXTERNA (ajena al SAP de la
    organización) -- ej. <code>GestionGastos</code>, <code>Rendiciones</code>. El
    código de módulo debe coincidir exactamente con el <code>ModuleCode</code> del
    plugin que la resuelve.
</p>

<div class="document-list-table-wrapper">
    <table class="table document-list-table">
    <thead>
        <tr>
            <th>Módulo</th>
            <th>Motor</th>
            <th>Host</th>
            <th>Puerto</th>
            <th>Base de datos</th>
            <th>Usuario técnico</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var connection in Model.Connections)
        {
            <tr>
                <td>@connection.ModuleCode</td>
                <td>@connection.EngineType</td>
                <td>@connection.Host</td>
                <td>@connection.Port</td>
                <td>@connection.DatabaseName</td>
                <td>@connection.TechnicalUsername</td>
                <td>@(connection.IsActive ? "Activa" : "Inactiva")</td>
                <td>
                    <a asp-page="/Admin/Organizations/Companies/ExternalConnections/Edit" asp-route-id="@connection.Id">Editar</a>
                    ·
                    <form method="post" asp-page-handler="TestConnection" asp-route-companyId="@Model.Company.Id" asp-route-id="@connection.Id" class="d-inline">
                        <button type="submit" class="btn btn-link p-0 align-baseline">Probar conexión</button>
                    </form>
                    ·
                    <form asp-page="./Index" asp-page-handler="Delete" asp-route-companyId="@Model.Company.Id" asp-route-id="@connection.Id" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar la conexión @connection.ModuleCode?');">
                        <button type="submit" class="btn btn-link text-danger p-0 align-baseline">Eliminar</button>
                    </form>
                </td>
            </tr>
            @if (Model.TestedConnectionId == connection.Id && Model.TestSuccess is not null)
            {
                <tr>
                    <td colspan="8">
                        <div class="alert @(Model.TestSuccess == true ? "alert-success" : "alert-warning") mb-0">
                            @if (Model.TestSuccess == true)
                            {
                                <strong class="text-success">OK</strong> <span>&mdash; conexión abierta correctamente.</span>
                            }
                            else
                            {
                                <strong class="text-danger">FALLÓ</strong> <span>&mdash;</span> <code>@Model.TestError</code>
                            }
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
</div>

@if (Model.Connections.Count == 0)
{
    <p class="text-muted">Todavía no hay conexiones externas para esta compañía.</p>
}
