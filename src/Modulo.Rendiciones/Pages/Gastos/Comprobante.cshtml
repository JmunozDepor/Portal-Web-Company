@page "/rendiciones/gastos/comprobante/{id:long}"
@model Modulo.Rendiciones.Pages.Gastos.ComprobanteModel
@{
    Layout = null;
    var fileUrl = Url.Page("/Gastos/ComprobanteArchivo", new { id = Model.ExpenseId });
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.FileName</title>
    <style>
        html, body { margin: 0; height: 100%; background: #1a1a1a; font-family: "Segoe UI", -apple-system, sans-serif; overflow: hidden; }
        .barra {
            position: fixed; top: 0; left: 0; right: 0; height: 48px; z-index: 2;
            display: flex; align-items: center; gap: 8px; padding: 0 14px;
            background: rgba(20, 20, 20, .92); color: #eee;
        }
        .barra .nombre { flex: 1 1 auto; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; opacity: .85; }
        .barra button {
            background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.18); color: #eee;
            border-radius: 6px; width: 34px; height: 34px; cursor: pointer; font-size: 14px;
        }
        .barra button:hover { background: rgba(255,255,255,.18); }
        .barra a.descargar { color: #eee; text-decoration: none; display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; }
        #visor {
            position: absolute; inset: 48px 0 0 0; overflow: auto; cursor: grab;
            display: flex; align-items: center; justify-content: center;
        }
        #visor.arrastrando { cursor: grabbing; }
        #visor img { max-width: none; transition: transform .05s linear; user-select: none; -webkit-user-drag: none; box-shadow: 0 12px 40px rgba(0,0,0,.5); }
        #visor iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    </style>
</head>
<body>
    <div class="barra">
        @if (!Model.IsPdf)
        {
            <button type="button" id="zoom-out" title="Alejar">−</button>
            <button type="button" id="zoom-in" title="Acercar">+</button>
            <button type="button" id="rotar" title="Rotar">⟳</button>
            <button type="button" id="reset" title="Restablecer">⤾</button>
        }
        <button type="button" id="fullscreen" title="Pantalla completa">⛶</button>
        <span class="nombre">@Model.FileName</span>
        <a class="descargar" href="@fileUrl" download="@Model.FileName" title="Descargar">⬇</a>
    </div>

    <div id="visor">
        @if (Model.IsPdf)
        {
            <iframe src="@fileUrl"></iframe>
        }
        else
        {
            <img id="imagen" src="@fileUrl" alt="@Model.FileName" />
        }
    </div>

    <script>
        document.getElementById('fullscreen').addEventListener('click', function () {
            var visor = document.getElementById('visor');
            if (!document.fullscreenElement) {
                visor.requestFullscreen();
            } else {
                document.exitFullscreen();
            }
        });
    </script>

    @if (!Model.IsPdf)
    {
        <script>
            (function () {
                var img = document.getElementById('imagen');
                var visor = document.getElementById('visor');
                var escala = 1, rotacion = 0;

                function aplicar() {
                    img.style.transform = 'scale(' + escala + ') rotate(' + rotacion + 'deg)';
                }

                document.getElementById('zoom-in').addEventListener('click', function () {
                    escala = Math.min(escala + 0.25, 6);
                    aplicar();
                });
                document.getElementById('zoom-out').addEventListener('click', function () {
                    escala = Math.max(escala - 0.25, 0.25);
                    aplicar();
                });
                document.getElementById('rotar').addEventListener('click', function () {
                    rotacion = (rotacion + 90) % 360;
                    aplicar();
                });
                document.getElementById('reset').addEventListener('click', function () {
                    escala = 1;
                    rotacion = 0;
                    aplicar();
                    visor.scrollTo(0, 0);
                });

                visor.addEventListener('wheel', function (e) {
                    e.preventDefault();
                    escala = Math.min(Math.max(escala + (e.deltaY < 0 ? 0.15 : -0.15), 0.25), 6);
                    aplicar();
                }, { passive: false });

                var arrastrando = false, inicioX, inicioY, scrollInicioX, scrollInicioY;
                visor.addEventListener('mousedown', function (e) {
                    arrastrando = true;
                    visor.classList.add('arrastrando');
                    inicioX = e.pageX;
                    inicioY = e.pageY;
                    scrollInicioX = visor.scrollLeft;
                    scrollInicioY = visor.scrollTop;
                });
                window.addEventListener('mouseup', function () {
                    arrastrando = false;
                    visor.classList.remove('arrastrando');
                });
                visor.addEventListener('mousemove', function (e) {
                    if (!arrastrando) return;
                    e.preventDefault();
                    visor.scrollLeft = scrollInicioX - (e.pageX - inicioX);
                    visor.scrollTop = scrollInicioY - (e.pageY - inicioY);
                });
            })();
        </script>
    }
</body>
</html>
