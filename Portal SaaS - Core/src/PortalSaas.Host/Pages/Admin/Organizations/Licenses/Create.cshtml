@page "{organizationId:guid}"
@model PortalSaas.Host.Pages.Admin.Organizations.Licenses.CreateModel
@{
    ViewData["Title"] = $"Emitir licencia · {Model.Organization.LegalName}";
}

<partial name="~/Pages/Admin/Organizations/_OrganizationSubnav.cshtml" model="@(new OrganizationSubnavViewModel { OrganizationId = Model.Organization.Id, OrganizationName = Model.Organization.LegalName, Mode = Model.Organization.Mode, ActivePage = "License" })" />

<div class="card-surface mb-4">
    <h2 class="h5 mb-3">Emitir licencia para @Model.Organization.LegalName</h2>
    <p class="text-muted">La clave de activación se genera automáticamente al guardar -- no se elige a mano.</p>
    <form method="post" asp-antiforgery="true">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Input.PlanId" class="form-label"></label>
                <select asp-for="Input.PlanId" class="form-select" asp-items="Model.Plans"></select>
                <span asp-validation-for="Input.PlanId" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Input.ExpiresAt" class="form-label"></label>
                <input asp-for="Input.ExpiresAt" type="date" class="form-control" />
                <span asp-validation-for="Input.ExpiresAt" class="text-danger"></span>
            </div>

            <div class="col-md-5">
                <label asp-for="Input.InstallationFingerprint" class="form-label"></label>
                <input asp-for="Input.InstallationFingerprint" class="form-control" />
                <span asp-validation-for="Input.InstallationFingerprint" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-primary">Emitir</button>
            <a asp-page="/Admin/Organizations/Licenses/Index" asp-route-organizationId="@Model.Organization.Id" class="btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
