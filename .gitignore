bin/
obj/
*.user
.vs/
**/TestResults/

# Output de build de plugins (target PublicarComoPlugin, ver plugins/*/*.csproj) --
# regenerable con `dotnet build`, no es código fuente.
artifacts/

# appsettings.Development.json SÍ se versiona -- solo trae credenciales de
# docker-compose.yml (desarrollo local, no secretos reales). appsettings.Production.json
# y cualquier override personal *.local.json nunca se versionan.
appsettings.Production.json
appsettings.*.local.json

# Copia de solo lectura de PortalSAP_v2/WMS_Suite para consulta al portar código
# (ver CLAUDE.md) -- no es código de este producto, no se versiona acá.
referencia-original/

# Caché local de extracción semántica de graphify -- regenerable, no se versiona.
graphify-out/cache/

# --- OPTIMIZACIÓN DE TOKENS PARA CLAUDE CODE ---
# Bloquea las librerías estáticas locales de PortalSaas.Host para que Claude no las lea en cada consulta
**/wwwroot/lib/bootstrap/
**/wwwroot/lib/jquery/
**/wwwroot/lib/jquery-validation/
**/wwwroot/lib/jquery-validation-unobtrusive/

# Estado interno de Claude Code (lock de sesión, tareas programadas) -- efímero, nunca
# se versiona.
.claude/*.lock
