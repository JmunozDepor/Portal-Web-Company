<?xml version="1.0" encoding="utf-8"?>
<!--
  Base para el web.config que genera "dotnet publish": el SDK web (Microsoft.NET.Sdk.Web)
  detecta este archivo en el proyecto y lo usa como plantilla (solo reescribe el nodo
  aspNetCore, respeta el resto), en vez de generar uno desde cero. Sin este archivo,
  cada publish pisa cualquier configuración manual hecha directo en el web.config del
  servidor IIS.

  requestLimits/maxAllowedContentLength: el default de IIS (~28.6MB) es una capa de
  filtrado de IIS independiente del límite de ASP.NET Core (ver Program.cs,
  IISServerOptions.MaxRequestBodySize); hay que subir los dos, o el de IIS sigue
  cortando antes de que la app vea el request. Bug real: Rendiciones/Gastos/Importar
  (OCR) sube hasta 5 fotos de celular por vez y devolvía HTTP 400 al pasarse del límite.

  serverRuntime/uploadReadAheadSize: default de IIS son 49152 bytes (48KB) — la
  cantidad de bytes del body que IIS lee de forma síncrona ANTES de pasarle el resto
  al módulo in-process de ASP.NET Core. Un POST más grande que eso puede cortarse con
  un HTTP 400 crudo (sin log de la app — IIS nunca llega a despachar el request al
  proceso .NET) aunque maxAllowedContentLength/MaxRequestBodySize estén altos, porque
  es una capa totalmente distinta. Bug real encontrado 2026-08-13 en el piloto:
  Modulo.GestionDistribucionGastos, pantalla CuentasPendientes/Detalle — una cuenta
  con 1072 líneas postea ~6 campos por línea (~80-100KB) y fallaba sistemáticamente,
  mientras cuentas chicas (bajo 48KB) guardaban bien. Confirmado con el log W3C de IIS
  (cs-bytes truncado justo arriba de 48KB, sc-status 400, sc-bytes de respuesta
  mínimo, time-taken de milisegundos — consistente con corte antes de leer el body
  completo, no con una excepción real de la app).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\PortalSaas.Host.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>
      <serverRuntime uploadReadAheadSize="104857600" />
    </system.webServer>
  </location>
</configuration>
