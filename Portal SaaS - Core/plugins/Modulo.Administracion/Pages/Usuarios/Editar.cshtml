@page "/organizacion/usuarios/editar/{id:guid?}"
@model Modulo.Administracion.Pages.Usuarios.EditarModel
@{
    ViewData["Title"] = Model.EsNuevo ? "Nuevo usuario" : $"Editar · {Model.Detalle?.Username}";
    var iniciales = Model.EsNuevo ? "+" : (Model.Detalle?.Username.Length > 0 ? Model.Detalle.Username[0].ToString().ToUpperInvariant() : "?");
}
@* Mockup confirmado (2026-08-19, ver .design-audit/mockups/mockup-organizacion-usuarios-editar.html):
   reemplaza las 3 tarjetas apiladas (Editar usuario / Compañía por defecto / Permisos --
   pantalla "muy extensa", subgrupos de funciones que deberían estar separados) por
   pestañas -- una sección visible a la vez, no todo el formulario de una sola vez.
   Mismo componente .doc-tabs/.doc-tab-btn ya usado en los motores de documento, pero
   SIN el modo "todas las secciones apiladas, tabs como ancla de scroll" (eso aplica a
   un documento con tabs Logística/Finanzas que son parte del MISMO registro; acá son 3
   tareas administrativas independientes -- Datos/Compañía/Permisos -- que no necesitan
   verse a la vez). data-tab-panel/data-tab-btn son un patrón nuevo, chico, solo para
   este caso -- ver el script al final. *@

<a href="~/organizacion/usuarios" class="doc-form-volver"><i class="bi bi-arrow-left"></i> Volver a usuarios</a>

@if (Model.MensajeExito is not null)
{
    <div class="alert alert-success">@Model.MensajeExito</div>
}
@if (Model.MensajeError is not null)
{
    <div class="alert alert-danger">@Model.MensajeError</div>
}

@if (!Model.EsNuevo)
{
    <div class="card-surface mb-3 d-flex align-items-center gap-3">
        <div class="d-flex align-items-center justify-content-center flex-shrink-0"
             style="width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent-2));color:var(--on-accent);font-size:20px;font-weight:700;">
            @iniciales
        </div>
        <div class="flex-grow-1">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h1 class="h4 mb-0">@Model.Detalle!.Username</h1>
                @if (Model.Detalle.IsActive)
                {
                    <span class="badge-status badge-status--success">Activo</span>
                }
                else
                {
                    <span class="badge-status badge-status--neutral">Inactivo</span>
                }
                @if (Model.Detalle.IsAdmin)
                {
                    <span class="badge-status badge-status--warning">Administrador</span>
                }
            </div>
            <p class="text-muted mb-0" style="font-size:13px;">@Model.Detalle.Email</p>
        </div>
    </div>
}

<div class="doc-tabs" style="position:static;display:inline-flex;width:auto;">
    <button type="button" class="doc-tab-btn active" data-tab-btn="datos">Datos</button>
    @if (!Model.EsNuevo)
    {
        <button type="button" class="doc-tab-btn" data-tab-btn="compania">Compañía por defecto</button>
        <button type="button" class="doc-tab-btn" data-tab-btn="permisos">Permisos</button>
    }
</div>

<div data-tab-panel="datos" class="card-surface" style="max-width:640px;">
    <h2 class="h5 mb-3">@(Model.EsNuevo ? "Nuevo usuario" : "Datos de la cuenta")</h2>
    <form method="post" asp-page-handler="Guardar">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="drawer-grid">
            <div class="mb-3">
                <label asp-for="Input.Username" class="form-label"></label>
                <input asp-for="Input.Username" class="form-control" />
                <span asp-validation-for="Input.Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            @if (Model.EsNuevo)
            {
                <div class="mb-3">
                    <p class="text-muted mb-0">Se le enviará un correo de invitación para que elija su propia contraseña.</p>
                </div>
            }
        </div>

        <div class="d-flex flex-wrap gap-4 pt-2 mt-2 border-top">
            <label class="d-flex align-items-center gap-2 mt-3"><input asp-for="Input.IsAdmin" type="checkbox" /> Administrador de la organización</label>
            @if (!Model.EsNuevo)
            {
                <label class="d-flex align-items-center gap-2 mt-3"><input asp-for="Input.IsActive" type="checkbox" /> Activo</label>
                <label class="d-flex align-items-center gap-2 mt-3"><input asp-for="Input.IsLocked" type="checkbox" /> Bloqueado</label>
            }
        </div>

        <button type="submit" class="btn-primary mt-3">@(Model.EsNuevo ? "Crear usuario" : "Guardar cambios")</button>
    </form>

    @if (!Model.EsNuevo)
    {
        <hr class="my-4" />
        <h2 class="h5 mb-1">Contraseña</h2>
        <p class="text-muted mb-3">Genera una contraseña nueva que cumple la política de seguridad (mínimo 10 caracteres, mayúscula, minúscula, número y símbolo).</p>
        <div class="d-flex flex-wrap gap-2">
            <form method="post" asp-page-handler="GenerarPassword" asp-route-id="@Model.Detalle!.Id">
                <input type="hidden" name="enviarPorCorreo" value="true" />
                <button type="submit" class="btn-secondary">Enviar contraseña nueva por correo</button>
            </form>
            <form method="post" asp-page-handler="GenerarPassword" asp-route-id="@Model.Detalle!.Id">
                <input type="hidden" name="enviarPorCorreo" value="false" />
                <button type="submit" class="btn-secondary">Generar y mostrar contraseña</button>
            </form>
        </div>
    }
</div>

@if (!Model.EsNuevo)
{
    <div data-tab-panel="compania" class="card-surface" style="max-width:640px;display:none;">
        <h2 class="h5 mb-1">Compañía por defecto</h2>
        <p class="text-muted mb-3">Con qué compañía entra automáticamente este usuario al loguearse, sin tener que elegirla cada vez.</p>

        @if (!Model.TieneCompanies)
        {
            <p class="text-warning">Tu organización todavía no tiene ninguna compañía configurada.</p>
        }
        else
        {
            <form method="post" asp-page-handler="GuardarCompaniaDefault" asp-route-id="@Model.Detalle!.Id" class="d-flex align-items-end gap-3">
                <div class="mb-0 flex-grow-1">
                    <label class="form-label">Compañía</label>
                    <select name="DefaultCompanyId" class="form-select">
                        <option value="">Sin compañía por defecto (elige cada vez)</option>
                        @foreach (var company in Model.Companies)
                        {
                            <option value="@company.Value" selected="@(company.Value == Model.DefaultCompanyId?.ToString())">@company.Text</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn-primary">Guardar</button>
            </form>
        }
    </div>

    <div data-tab-panel="permisos" class="card-surface" style="display:none;">
        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-3">
            <div>
                <h2 class="h5 mb-1">Permisos por compañía</h2>
                <p class="text-muted mb-0">El acceso se asigna compañía por compañía dentro de la organización.</p>
            </div>
            @if (Model.TieneCompanies)
            {
                <form method="get" style="width:260px;">
                    <input type="hidden" name="id" value="@Model.Detalle!.Id" />
                    @* Sin esto, el GET que dispara el <select> recarga la página y el
                       script de pestañas vuelve a arrancar en "Datos" -- el usuario
                       perdía la pestaña Permisos en cada cambio de compañía. *@
                    <input type="hidden" name="tab" value="permisos" />
                    <label class="form-label">Compañía</label>
                    <select name="companyId" class="form-select" onchange="this.form.submit()">
                        @foreach (var company in Model.Companies)
                        {
                            <option value="@company.Value" selected="@(company.Value == Model.SelectedCompanyId.ToString())">@company.Text</option>
                        }
                    </select>
                </form>
            }
        </div>

        @if (!Model.TieneCompanies)
        {
            <p class="text-warning">Tu organización todavía no tiene ninguna compañía configurada.</p>
        }
        else
        {
            <form method="post" asp-page-handler="GuardarPermisos" asp-route-id="@Model.Detalle!.Id">
                <input type="hidden" asp-for="Permissions.CompanyId" />

                <span class="d-block mb-2 fw-semibold" style="font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--text-muted);">Grupos de menú</span>
                @if (Model.AllMenuGroups.Count == 0)
                {
                    <p class="text-muted">Todavía no hay grupos de menú creados (los crea el operador de plataforma).</p>
                }
                else
                {
                    <div class="menu-perfil-panel mb-3">
                        @foreach (var group in Model.AllMenuGroups)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Permissions.SelectedMenuGroupIds" value="@group.Id"
                                       id="group-@group.Id" checked="@Model.Permissions.SelectedMenuGroupIds.Contains(group.Id)" />
                                <label class="form-check-label" for="group-@group.Id">@group.Name</label>
                            </div>
                        }
                    </div>
                }

                <span class="d-block mb-2 fw-semibold" style="font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--text-muted);">Permisos por pantalla</span>
                <p class="text-muted" style="font-size:12.5px;">
                    El árbol refleja el menú de la aplicación. Asigná un perfil a cada pantalla que este
                    usuario deba usar en
                    <strong>@(Model.Companies.FirstOrDefault(c => c.Value == Model.SelectedCompanyId.ToString())?.Text ?? "esta compañía")</strong>.
                    En una carpeta, elegir un perfil lo aplica <strong>en cascada</strong> a todas sus pantallas
                    (podés ajustar cualquiera después). El guardado solo persiste el perfil de cada pantalla,
                    no el de las carpetas.
                </p>
                @if (Model.MenuTree.Count == 0)
                {
                    <p class="text-muted">Todavía no hay nodos de menú.</p>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2 mb-2" style="font-size:12.5px;">
                        <label for="perfil-todas" class="text-muted mb-0">Aplicar a TODAS las pantallas:</label>
                        <select id="perfil-todas" class="form-select form-select-sm" style="width:auto;">
                            <option value="__skip__" selected>— elegir —</option>
                            @foreach (var profile in Model.ProfileOptions)
                            {
                                <option value="@profile.Value">@profile.Text</option>
                            }
                            <option value="">Sin asignar (limpiar todo)</option>
                        </select>
                    </div>
                    <table class="table-ps" id="tabla-permisos-arbol">
                        <thead><tr><th>Pantalla</th><th style="width:240px;">Perfil</th></tr></thead>
                        <tbody>
                            @foreach (var nodo in Model.MenuTree)
                            {
                                var esCarpeta = nodo.PagePath is null;
                                var actual = Model.Permissions.ProfileByMenu.GetValueOrDefault(nodo.Id);
                                <tr data-menu-id="@nodo.Id" data-parent-id="@(nodo.Level == 0 ? "" : nodo.ParentMenuId?.ToString())" data-carpeta="@(esCarpeta ? "1" : "0")"
                                    style="@(esCarpeta ? "background:color-mix(in srgb, var(--bs-primary) 4%, transparent);" : "")">
                                    <td>
                                        <span style="display:inline-block;width:@(nodo.Level * 20)px;"></span>
                                        <i class="bi @(nodo.Icon ?? (esCarpeta ? "bi-folder2" : "bi-dot"))"></i>
                                        <span class="@(esCarpeta ? "fw-semibold" : "")">@nodo.Name</span>
                                        @if (!esCarpeta)
                                        {
                                            <span class="text-muted" style="font-size:11px;">(@($"{nodo.OriginModule}.{nodo.Code}"))</span>
                                        }
                                    </td>
                                    <td>
                                        @if (esCarpeta)
                                        {
                                            <select class="form-select form-select-sm perfil-cascada" data-menu-id="@nodo.Id" title="Aplica el perfil a todas las pantallas de esta carpeta">
                                                <option value="__skip__" selected>— heredar en pantallas —</option>
                                                @foreach (var profile in Model.ProfileOptions)
                                                {
                                                    <option value="@profile.Value">@profile.Text</option>
                                                }
                                                <option value="">Sin asignar (limpiar)</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <select name="Permissions.ProfileByMenu[@nodo.Id]" class="form-select form-select-sm perfil-hoja">
                                                <option value="" selected="@(actual is null or 0)">Sin asignar</option>
                                                @foreach (var profile in Model.ProfileOptions)
                                                {
                                                    <option value="@profile.Value" selected="@(profile.Value == actual?.ToString())">@profile.Text</option>
                                                }
                                            </select>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <button type="submit" class="btn-primary mt-3">Guardar permisos</button>
            </form>
        }
    </div>
}

@if (Model.NuevaPasswordGenerada is not null)
{
    <div class="modal-backdrop-custom" id="modal-nueva-password" style="position:fixed;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;z-index:1050;">
        <div class="card-surface" style="max-width:420px;width:90%;">
            <h2 class="h5 mb-2">Contraseña generada</h2>
            <p class="text-muted mb-3">Cópiala ahora: por seguridad, no se volverá a mostrar.</p>
            <div class="d-flex align-items-center gap-2 mb-3">
                <input id="input-nueva-password" type="text" class="form-control" value="@Model.NuevaPasswordGenerada" readonly />
                <button type="button" class="btn-secondary" onclick="copiarPassword()">Copiar</button>
            </div>
            <button type="button" class="btn-primary" onclick="document.getElementById('modal-nueva-password').remove()">Cerrar</button>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Pestañas independientes (Datos/Compañía/Permisos) -- una sola visible a
        // la vez, sin scroll compartido. Patrón chico y local a esta página: NO
        // reusa doc-tabs.js (ese hace scroll-into-view + scrollspy porque ahí TODAS
        // las secciones están apiladas y visibles a la vez; acá son 3 tareas
        // independientes que se ocultan entre sí).
        (function () {
            var botones = document.querySelectorAll('[data-tab-btn]');

            function activar(nombre) {
                var destino = null;
                botones.forEach(function (b) {
                    var esEste = b.dataset.tabBtn === nombre;
                    b.classList.toggle('active', esEste);
                    if (esEste) { destino = b; }
                });
                if (destino === null) { return false; }
                document.querySelectorAll('[data-tab-panel]').forEach(function (p) {
                    p.style.display = (p.getAttribute('data-tab-panel') === nombre) ? 'block' : 'none';
                });
                return true;
            }

            botones.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    activar(btn.dataset.tabBtn);
                    // Deja la pestaña en el hash para que un F5 no la pierda.
                    history.replaceState(null, '', '#' + btn.dataset.tabBtn);
                });
            });

            // Al cargar: respeta ?tab=... (lo manda el selector de compañía de Permisos
            // en su GET) o el #hash de un F5; si no, queda "datos" como en el markup.
            var params = new URLSearchParams(window.location.search);
            var inicial = params.get('tab') || window.location.hash.replace('#', '');
            if (inicial) { activar(inicial); }
        })();

        function copiarPassword() {
            var input = document.getElementById('input-nueva-password');
            input.select();
            navigator.clipboard.writeText(input.value);
        }

        // Cascada de perfil en el árbol de permisos: elegir un perfil en la fila de una
        // carpeta lo aplica a TODAS las pantallas (hojas) de su subárbol; el <select>
        // "Aplicar a TODAS" hace lo mismo sobre el árbol entero. Solo toca los <select>
        // de las hojas (los únicos con name -> son los que se postean); las carpetas no
        // persisten perfil. El valor "__skip__" no hace nada (placeholder).
        (function () {
            var tabla = document.getElementById('tabla-permisos-arbol');
            if (!tabla) { return; }

            var filas = Array.prototype.slice.call(tabla.querySelectorAll('tr[data-menu-id]'));
            var hijosPorPadre = {};
            filas.forEach(function (fila) {
                var padre = fila.getAttribute('data-parent-id') || '';
                (hijosPorPadre[padre] = hijosPorPadre[padre] || []).push(fila);
            });

            function selectsHojaBajo(menuId) {
                var out = [];
                (function bajar(id) {
                    (hijosPorPadre[id] || []).forEach(function (fila) {
                        var sel = fila.querySelector('select.perfil-hoja');
                        if (sel) { out.push(sel); }
                        bajar(fila.getAttribute('data-menu-id'));
                    });
                })(menuId);
                return out;
            }

            function aplicar(selects, valor) {
                selects.forEach(function (sel) {
                    sel.value = valor;
                    sel.dispatchEvent(new Event('change', { bubbles: false }));
                });
            }

            tabla.querySelectorAll('select.perfil-cascada').forEach(function (sel) {
                sel.addEventListener('change', function () {
                    if (sel.value === '__skip__') { return; }
                    aplicar(selectsHojaBajo(sel.getAttribute('data-menu-id')), sel.value);
                    sel.value = '__skip__';
                });
            });

            var todas = document.getElementById('perfil-todas');
            if (todas) {
                todas.addEventListener('change', function () {
                    if (todas.value === '__skip__') { return; }
                    aplicar(Array.prototype.slice.call(tabla.querySelectorAll('select.perfil-hoja')), todas.value);
                    todas.value = '__skip__';
                });
            }
        })();
    </script>
}
