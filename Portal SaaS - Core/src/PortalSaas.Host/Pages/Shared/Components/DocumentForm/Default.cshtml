@model PortalSaas.Abstractions.Componentes.DocumentFormViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var formDefinition = Model.FormKey is null ? null : PortalSaas.Abstractions.Componentes.DocumentFormFieldCatalog.Find(Model.FormKey);
    var hiddenCount = Model.FormLayout.HiddenFields.Count;
    // Token en un data-attribute (no en un <input name>) -- en un documento nuevo el panel
    // vive dentro del <form> de creación y un segundo __RequestVerificationToken lo rompería.
    var antiforgeryToken = formDefinition is null ? null : Antiforgery.GetAndStoreTokens(ViewContext.HttpContext).RequestToken;
}

@* Campos ocultos por el formulario personalizado -- claves ya filtradas contra
   DocumentFormFieldCatalog ([a-z0-9-]), seguras dentro de un selector CSS. form-layout.js
   reescribe este mismo <style> al marcar/desmarcar. *@
@if (formDefinition is not null)
{
    <style id="doc-form-layout-style">
        @foreach (var key in Model.FormLayout.HiddenFields)
        {
            @:.doc-form [data-form-field="@key"] { display: none !important; }
        }
    </style>
    <script src="~/js/form-layout.js" asp-append-version="true"></script>
}

@* Tabs como anclas de scroll, NUNCA como toggles que ocultan secciones -- portado tal
   cual de referencia-original/PortalSAP_v2 (DocumentForm/Default.cshtml): el documento
   completo se ve de una sola vez hacia abajo, doc-tabs.js hace el scroll suave al click
   y resalta la pestaña activa por scrollspy (IntersectionObserver). La entrega anterior
   había usado tabs reales de Bootstrap (data-bs-toggle="tab", ocultando el resto) --
   corregido acá, mismo componente compartido por los 3 motores genéricos (Venta/Compra/
   Inventario), así que el fix alcanza a los 3 sin tocar nada más. *@

@* "Volver" propio ELIMINADO (2026-08-19, "el volver se repite... solo existir una
   ruta") -- Model.BackUrl ahora se consume desde _ModuloBackLink.cshtml (breadcrumb
   único del layout, ver ViewData["ModuleBreadcrumbBackUrl"] en
   DetailGeneric*ModelBase.BuildDocumentViewModel), no acá. La propiedad BackUrl del
   view model se conserva -- sigue siendo la fuente real del dato, solo cambió quién
   la renderiza. *@
<div class="card-ps doc-form">
    @* Título + tabs comparten UN SOLO contenedor sticky (.doc-form-sticky) -- antes
       cada uno tenía su propio "top: 0" (el título no era sticky y .doc-tabs sí),
       así que al scrollear el título se iba de la pantalla mientras las filas de la
       tabla de abajo quedaban visibles "detrás" del borde superior de .doc-tabs
       (bug real reportado, 2026-08-20: "el título debe quedar justo en el borde
       superior, hoy queda sobrepuesto y se ve el detalle detrás al hacer scroll").
       Un solo wrapper sticky con fondo sólido evita el hueco donde el contenido se
       veía pasar por encima. *@
    <div class="doc-form-sticky">
        <div class="doc-form-header">
            <h2>@Model.Title</h2>
            @if (Model.StatusText is not null)
            {
                <span class="badge doc-status-badge @(Model.StatusClass ?? "bg-secondary")">@Model.StatusText</span>
            }
            @if (formDefinition is not null)
            {
                @* Formulario personalizado: cada casilla muestra/oculta los elementos con
                   data-form-field="clave" y se guarda en la cuenta (por compañía), ver
                   form-layout.js. Las casillas NO tienen name a propósito: en un documento
                   nuevo este panel queda dentro del <form> de creación y no debe postearse. *@
                <div class="dropdown doc-form-layout ms-auto">
                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown"
                            data-bs-auto-close="outside" aria-expanded="false">
                        <i class="bi bi-sliders"></i> Personalizar
                        <span class="badge bg-secondary doc-form-layout-count" @(hiddenCount == 0 ? "hidden" : null)>@hiddenCount</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end doc-form-layout-panel"
                         data-form-key="@Model.FormKey" data-token="@antiforgeryToken"
                         data-base-hidden="@string.Join(",", Model.FormLayout.BaseHiddenFields)">
                        <div class="doc-form-layout-title">Campos visibles</div>
                        <p class="doc-form-layout-hint">Desmarcá lo que no usás. Se guarda en tu cuenta para esta compañía.</p>
                        @foreach (var fieldGroup in formDefinition.Fields.GroupBy(f => f.Section))
                        {
                            <div class="doc-form-layout-section">@fieldGroup.Key</div>
                            @foreach (var field in fieldGroup)
                            {
                                <label class="doc-form-layout-option">
                                    <input type="checkbox" class="form-check-input" value="@field.Key"
                                           checked="@(!Model.FormLayout.HiddenFields.Contains(field.Key))" />
                                    <span>@field.Label</span>
                                </label>
                            }
                        }
                        <div class="doc-form-layout-footer">
                            <button type="button" class="btn btn-sm btn-link doc-form-layout-reset" @(Model.FormLayout.HasUserOverride ? null : "hidden")>
                                Restablecer al formulario de la empresa
                            </button>
                            <span class="doc-form-layout-status text-muted"></span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (TempData["DocumentActionMessage"] is string actionMessage)
        {
            <div class="alert @(TempData["DocumentActionMessageType"] as string ?? "alert-success") mb-3">@actionMessage</div>
        }

        <div class="doc-tabs">
            <a href="#doc-tab-general" class="doc-tab-btn active" data-tab-anchor="doc-tab-general">General</a>
            <a href="#doc-tab-content" class="doc-tab-btn" data-tab-anchor="doc-tab-content">Contenido</a>
            @if (Model.LogisticsView is not null)
            {
                <a href="#doc-tab-logistics" class="doc-tab-btn" data-tab-anchor="doc-tab-logistics">Logística</a>
            }
            @if (Model.AccountingView is not null)
            {
                <a href="#doc-tab-accounting" class="doc-tab-btn" data-tab-anchor="doc-tab-accounting">@Model.AccountingTitle</a>
            }
            @if (Model.UserFieldsView is not null)
            {
                <a href="#doc-tab-userfields" class="doc-tab-btn" data-tab-anchor="doc-tab-userfields">Campos de usuario</a>
            }
        </div>
    </div>

    <section id="doc-tab-general" class="doc-tab-seccion">
        <span class="doc-resumen-total-titulo">General</span>
        @await Html.PartialAsync(Model.GeneralView, Model.Model)
    </section>

    <section id="doc-tab-content" class="doc-tab-seccion">
        <span class="doc-resumen-total-titulo">Contenido</span>
        @await Html.PartialAsync(Model.ContentView, Model.Model)
    </section>

    @if (Model.LogisticsView is not null)
    {
        <section id="doc-tab-logistics" class="doc-tab-seccion">
            <span class="doc-resumen-total-titulo">Logística</span>
            @await Html.PartialAsync(Model.LogisticsView, Model.Model)
        </section>
    }
    @if (Model.AccountingView is not null)
    {
        <section id="doc-tab-accounting" class="doc-tab-seccion">
            <span class="doc-resumen-total-titulo">@Model.AccountingTitle</span>
            @await Html.PartialAsync(Model.AccountingView, Model.Model)
        </section>
    }
    @if (Model.UserFieldsView is not null)
    {
        <section id="doc-tab-userfields" class="doc-tab-seccion">
            <span class="doc-resumen-total-titulo">Campos de usuario</span>
            @await Html.PartialAsync(Model.UserFieldsView, Model.Model)
        </section>
    }

    @if (Model.CanClose || Model.CanCancel)
    {
        <div class="doc-tab-seccion admin-row-actions">
            @if (Model.CanClose)
            {
                <form method="post" asp-page-handler="Close" asp-route-id="@Model.DocEntry">
                    <button type="submit" class="btn btn-outline-secondary"
                            onclick="return confirm('¿Cerrar @Model.Title? El documento sigue existiendo en SAP, sin acciones pendientes.');">
                        Cerrar
                    </button>
                </form>
            }
            @if (Model.CanCancel)
            {
                <form method="post" asp-page-handler="Cancel" asp-route-id="@Model.DocEntry">
                    <button type="submit" class="btn btn-outline-danger"
                            onclick="return confirm('¿Cancelar @Model.Title? Esta acción anula el documento en SAP con rastro de auditoría.');">
                        Cancelar
                    </button>
                </form>
            }
        </div>
    }
</div>
