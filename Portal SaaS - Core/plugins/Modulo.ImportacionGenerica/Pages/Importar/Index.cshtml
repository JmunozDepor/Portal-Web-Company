@page "/importacion-generica/importar"
@using PortalSaas.Abstractions.Modelos
@model Modulo.ImportacionGenerica.Pages.Importar.IndexModel
@{
    ViewData["Title"] = "Importar documentos";
}

<h1 class="h3 mb-3">Importar documentos</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<div class="card-ps doc-tab-seccion mb-4">
    <span class="doc-resumen-total-titulo">Parámetros</span>
    <form method="post" asp-page-handler="Process" enctype="multipart/form-data" asp-antiforgery="true">
        <input type="hidden" asp-for="Input.Base64File" />
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Input.Module" class="form-label"></label>
                <select asp-for="Input.Module" asp-items="Model.Modules" class="form-select" onchange="mostrarTipoDocumento(this.value)"></select>
            </div>
            <div class="form-group" id="tipo-doc-sales">
                <label asp-for="Input.SalesDocumentType" class="form-label"></label>
                <select asp-for="Input.SalesDocumentType" asp-items="Model.SalesDocumentTypes" class="form-select">
                    <option value="">Seleccionar…</option>
                </select>
            </div>
            <div class="form-group" id="tipo-doc-purchase" style="display:none">
                <label asp-for="Input.PurchaseDocumentType" class="form-label"></label>
                <select asp-for="Input.PurchaseDocumentType" asp-items="Model.PurchaseDocumentTypes" class="form-select">
                    <option value="">Seleccionar…</option>
                </select>
            </div>
            <div class="form-group" id="tipo-doc-inventory" style="display:none">
                <label asp-for="Input.InventoryDocumentType" class="form-label"></label>
                <select asp-for="Input.InventoryDocumentType" asp-items="Model.InventoryDocumentTypes" class="form-select">
                    <option value="">Seleccionar…</option>
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Input.LineType" class="form-label"></label>
                <select asp-for="Input.LineType" asp-items="Model.LineTypes" class="form-select"></select>
            </div>
            <div class="form-group">
                <label asp-for="Input.BusinessPartnerCardCode" class="form-label"></label>
                <input asp-for="Input.BusinessPartnerCardCode" class="form-control import-business-partner-code" list="import-business-partners-datalist" autocomplete="off" disabled="@Model.BusinessPartnerFromFile" />
                <datalist id="import-business-partners-datalist"></datalist>
                @if (Model.BusinessPartnerFromFile)
                {
                    <div class="form-text text-warning">Carga multi-socio -- dejá este campo vacío, cada fila del Excel trae su propio socio de negocio.</div>
                }
            </div>
        </div>
        <div class="form-row">
            <div class="form-group form-group-ancho-completo">
                <label class="form-label">Archivo (.xlsx)</label>
                <input type="file" name="file" class="form-control" accept=".xlsx,.xls" />
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Procesar (vista previa)</button>
        @* GET puro (OnGetTemplateAsync ya existe en el codebehind, portado del módulo
           original -- "Formato para importar" según Módulo+Tipo de documento+Tipo de
           línea) -- botón type="button" a propósito, no puede ir dentro de este mismo
           submit porque dispara una descarga, no un POST de Procesar. La URL se arma en
           JS con los valores ACTUALES del formulario (btnDescargarFormato más abajo),
           nunca con un <a href> fijo -- el tipo de documento depende del <select> visible
           según el Módulo elegido (mostrarTipoDocumento). *@
        <button type="button" id="btnDescargarFormato" class="btn btn-outline-secondary">Descargar formato para importar</button>
    </form>
</div>

@if (Model.PreviewResult is not null)
{
    if (!Model.PreviewResult.HasValidConfig)
    {
        <div class="alert alert-warning">@Model.PreviewResult.ErrorMessage</div>
    }
    else
    {
        <div class="card-ps doc-tab-seccion mb-4">
            <span class="doc-resumen-total-titulo">Vista previa -- @Model.PreviewResult.Documents.Count documento(s)</span>
            @foreach (var document in Model.PreviewResult.Documents)
            {
                // Resumen colapsable por documento -- <details>/<summary> nativo del
                // navegador, sin JS (mismo criterio que el original, sección 7.7).
                // Colapsado por defecto: con archivos de miles de filas, tener las
                // tablas de todos los documentos expandidas a la vez vuelve la vista
                // previa impracticable de recorrer.
                var cantidadTotal = document.Rows.Sum(r => r.Quantity ?? 0);
                // Solo líneas que traen precio propio -- las que dejan que SAP asigne
                // el de la lista del socio no entran en la suma (no hay forma de saber
                // ese monto antes de crear el documento en SAP).
                var lineasConPrecio = document.Rows.Where(r => r.UnitPrice is not null).ToList();
                var montoTotal = lineasConPrecio.Sum(r => (r.Quantity ?? 0) * (r.UnitPrice ?? 0));
                var lineasSinPrecio = document.Rows.Count - lineasConPrecio.Count;
                var muestraMonto = Model.Input.Module != GenericImportModule.Inventory;
                // Carga multi-socio: todas las filas del grupo ya comparten socio por
                // construcción (ver GenericImportService.ProcessRow), alcanza con mirar
                // la primera para saber de qué socio es este documento.
                var socioDelGrupo = document.Rows[0].BusinessPartnerName ?? document.Rows[0].BusinessPartnerCardCode;

                <details class="mt-3" open="@(!document.CanCreate)">
                    <summary style="cursor:pointer">
                        <strong>Grupo "@document.GroupingKey"</strong> --
                        @(document.CanCreate ? "listo para crear" : "con errores, no se creará")
                        @if (socioDelGrupo is not null)
                        {
                            <text> · Socio: @socioDelGrupo</text>
                        }
                        · @document.Rows.Count fila(s) · Cantidad total: @cantidadTotal.ToString("N2")
                        @{
                            var advertenciasCount = document.Rows.Sum(r => r.Warnings.Count);
                        }
                        @if (advertenciasCount > 0)
                        {
                            <text> · @advertenciasCount advertencia(s)</text>
                        }
                        @if (muestraMonto)
                        {
                            <text> · Monto total: @montoTotal.ToString("N2")</text>
                            if (lineasSinPrecio > 0)
                            {
                                <text> (@lineasSinPrecio línea(s) sin precio propio, las asigna SAP -- no entran en esta suma)</text>
                            }
                        }
                    </summary>
                    <table class="table table-sm mt-2">
                        <thead>
                            <tr>
                                <th>Fila</th>
                                <th>Artículo</th>
                                <th>Cantidad</th>
                                <th>Errores</th>
                                <th>Advertencias</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in document.Rows)
                            {
                                // Cascada hasta el valor crudo del Excel cuando ItemName/ItemCode/
                                // Description vienen null (típico en una fila con error -- la
                                // resolución contra SAP falló) -- antes mostraba "-" sin decir cuál
                                // era el código/descripción que no existía.
                                var articuloMostrado = row.ItemName ?? row.ItemCode ?? row.Description
                                    ?? row.RawValues.GetValueOrDefault(GenericImportLogicalField.ItemCode)
                                    ?? row.RawValues.GetValueOrDefault(GenericImportLogicalField.Description);
                                <tr class="@(row.IsValid ? (row.Warnings.Count > 0 ? "table-warning" : "") : "table-danger")">
                                    <td>@row.RowNumber</td>
                                    <td>@articuloMostrado</td>
                                    <td>@row.Quantity</td>
                                    <td>@string.Join("; ", row.Errors)</td>
                                    <td class="text-warning">@string.Join("; ", row.Warnings)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </details>
            }

            @if (Model.PreviewResult.Documents.Any(d => d.CanCreate))
            {
                @* asp-antiforgery="true" NO alcanza acá -- confirmado en vivo (DevTools,
                   Elements): sin asp-page/asp-action/asp-page-handler en el mismo <form>
                   (este es un fetch manual, no un submit real, así que nunca los tuvo),
                   FormTagHelper no emite el <input __RequestVerificationToken> pese al
                   atributo explícito -- causa real del HTTP 400 vacío al confirmar
                   (antiforgery). @Html.AntiForgeryToken() no depende de esa lógica de
                   ruteo, genera el campo oculto siempre. Mismo criterio a futuro para
                   cualquier <form> puramente-fetch sin atributos de ruteo. *@
                <form id="formConfirmar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Input.Module" />
                    <input type="hidden" asp-for="Input.SalesDocumentType" />
                    <input type="hidden" asp-for="Input.PurchaseDocumentType" />
                    <input type="hidden" asp-for="Input.InventoryDocumentType" />
                    <input type="hidden" asp-for="Input.LineType" />
                    <input type="hidden" asp-for="Input.BusinessPartnerCardCode" />
                    <input type="hidden" asp-for="Input.Base64File" />
                </form>
                <button type="button" class="btn btn-success" id="btnConfirmar">Confirmar creación en SAP</button>
                <div id="progresoConfirmar" class="mt-3" style="display:none">
                    <div class="progress" style="height: 1.5rem">
                        <div id="progresoConfirmarBarra" class="progress-bar" role="progressbar" style="width: 0%">0%</div>
                    </div>
                    <div id="progresoConfirmarMensaje" class="text-muted mt-1 small"></div>
                </div>
            }

            @* Reporte de validación pre-carga -- disponible siempre que haya vista previa,
               no solo cuando hay errores (a diferencia de "Descargar archivo con errores"). *@
            <form method="post" asp-page-handler="DownloadValidationReport" asp-antiforgery="true" class="mt-2 d-inline-block">
                <input type="hidden" asp-for="Input.Module" />
                <input type="hidden" asp-for="Input.SalesDocumentType" />
                <input type="hidden" asp-for="Input.PurchaseDocumentType" />
                <input type="hidden" asp-for="Input.InventoryDocumentType" />
                <input type="hidden" asp-for="Input.LineType" />
                <input type="hidden" asp-for="Input.BusinessPartnerCardCode" />
                <input type="hidden" asp-for="Input.Base64File" />
                <button type="submit" class="btn btn-outline-secondary">Descargar reporte de validación</button>
            </form>

            @if (Model.PreviewResult.Documents.Any(d => !d.CanCreate))
            {
                @* Descarga de archivo = navegación normal, no fetch -- <form> aparte del
                   de Confirmar, con method="post" real (un <a> no puede mandar
                   Base64File si el archivo es grande, por eso POST y no querystring). *@
                <form method="post" asp-page-handler="DownloadWithErrors" asp-antiforgery="true" class="mt-2 d-inline-block">
                    <input type="hidden" asp-for="Input.Module" />
                    <input type="hidden" asp-for="Input.SalesDocumentType" />
                    <input type="hidden" asp-for="Input.PurchaseDocumentType" />
                    <input type="hidden" asp-for="Input.InventoryDocumentType" />
                    <input type="hidden" asp-for="Input.LineType" />
                    <input type="hidden" asp-for="Input.BusinessPartnerCardCode" />
                    <input type="hidden" asp-for="Input.Base64File" />
                    <button type="submit" class="btn btn-outline-secondary">Descargar archivo con errores</button>
                </form>
            }
        </div>
    }
}

<div id="resultadoConfirmar"></div>

<script>
    // Confirmar es un fetch, no un submit de página completa -- con archivos de miles
    // de filas, un postback tradicional deja la pestaña sin ningún indicio de avance
    // durante todo el proceso (ver IndexModel.OnPostConfirmAsync). El jobId lo genera
    // el cliente y viaja tanto al POST de Confirmar como al polling de Progreso, para
    // que ambos apunten al mismo trabajo en IGenericImportProgressStore.
    (function () {
        var btnConfirmar = document.getElementById('btnConfirmar');
        if (!btnConfirmar) {
            return;
        }

        var formConfirmar = document.getElementById('formConfirmar');
        var progresoDiv = document.getElementById('progresoConfirmar');
        var progresoBarra = document.getElementById('progresoConfirmarBarra');
        var progresoMensaje = document.getElementById('progresoConfirmarMensaje');
        var resultadoDiv = document.getElementById('resultadoConfirmar');
        var pollingActivo = false;

        function generarJobId() {
            return 'job-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2);
        }

        function actualizarBarra(progreso) {
            var porcentaje = progreso.total > 0 ? Math.round((progreso.current / progreso.total) * 100) : 0;
            progresoBarra.style.width = porcentaje + '%';
            progresoBarra.textContent = porcentaje + '%';
            progresoMensaje.textContent = progreso.message || '';
        }

        function escaparHtml(texto) {
            var div = document.createElement('div');
            div.textContent = texto == null ? '' : String(texto);
            return div.innerHTML;
        }

        function mostrarResultado(progreso) {
            var filas = (progreso.results || []).map(function (r) {
                var claseFila = r.success ? '' : ' class="table-danger"';
                return '<tr' + claseFila + '>' +
                    '<td>' + escaparHtml(r.groupingKey) + '</td>' +
                    '<td>' + (r.success ? 'OK' : 'Error') + '</td>' +
                    '<td>' + (r.success ? escaparHtml(r.docNum) : '-') + '</td>' +
                    '<td>' + escaparHtml(r.message) + '</td>' +
                    '</tr>';
            }).join('');

            var tabla = filas
                ? '<table class="table table-sm"><thead><tr><th>Grupo</th><th>Resultado</th><th>N° documento</th><th>Mensaje</th></tr></thead><tbody>' + filas + '</tbody></table>'
                : '';

            resultadoDiv.innerHTML =
                '<div class="alert ' + (progreso.success ? 'alert-success' : 'alert-warning') + '">' + escaparHtml(progreso.message) + '</div>' + tabla;
        }

        function consultarProgreso(jobId) {
            if (!pollingActivo) {
                return;
            }
            fetch('?handler=Progress&jobId=' + encodeURIComponent(jobId))
                .then(function (respuesta) { return respuesta.ok ? respuesta.json() : null; })
                .then(function (progreso) {
                    if (!progreso) {
                        setTimeout(function () { consultarProgreso(jobId); }, 1500);
                        return;
                    }
                    actualizarBarra(progreso);
                    if (progreso.finished) {
                        pollingActivo = false;
                        return;
                    }
                    setTimeout(function () { consultarProgreso(jobId); }, 1500);
                })
                .catch(function () {
                    setTimeout(function () { consultarProgreso(jobId); }, 3000);
                });
        }

        btnConfirmar.addEventListener('click', function () {
            btnConfirmar.disabled = true;
            resultadoDiv.innerHTML = '';
            progresoDiv.style.display = '';
            actualizarBarra({ current: 0, total: 0, message: 'Iniciando…' });

            var jobId = generarJobId();
            // new FormData(formConfirmar) ya incluye TODOS los campos con name del form,
            // el oculto de @Html.AntiForgeryToken() incluido -- agregarlo de nuevo acá
            // (como hacía antes esta línea) lo duplicaba: dos valores idénticos bajo el
            // mismo nombre "__RequestVerificationToken" en el mismo POST, y
            // Antiforgery.ValidateRequestAsync rechaza eso con un 400 vacío en vez de
            // tomar el primero -- causa real confirmada viendo el payload real de la
            // request en DevTools (bug encontrado 2026-09-04, ver CLAUDE.md). Solo se
            // valida acá que el campo esté, sin volver a agregarlo.
            var formData = new FormData(formConfirmar);
            formData.append('jobId', jobId);

            if (!formConfirmar.querySelector('input[name="__RequestVerificationToken"]')) {
                console.warn('formConfirmar no tiene __RequestVerificationToken -- la confirmación va a fallar con 400 (antiforgery).');
            }

            pollingActivo = true;
            consultarProgreso(jobId);

            fetch('?handler=Confirm', { method: 'POST', body: formData })
                // Se lee SIEMPRE como texto primero (nunca respuesta.json() directo) --
                // un 400 de la validación automática de antiforgery de Razor Pages (que
                // corre ANTES de que OnPostConfirmAsync llegue a ejecutarse, así que el
                // try/catch de ese método no lo alcanza a atrapar) devuelve texto plano/
                // HTML, no JSON -- respuesta.json() directo tira una excepción de parseo
                // y el .catch() de abajo mostraba siempre el mismo mensaje genérico sin
                // importar la causa real. Acá se intenta parsear como JSON (el caso
                // normal, controlado por OnPostConfirmAsync) y, si falla, se muestra el
                // status HTTP + el texto crudo -- así cualquier falla de infraestructura
                // (antiforgery, tamaño de archivo, error 500 no capturado) se ve en
                // pantalla en vez de quedar oculta.
                .then(function (respuesta) {
                    return respuesta.text().then(function (texto) {
                        var data;
                        try {
                            data = JSON.parse(texto);
                        } catch (parseErr) {
                            throw new Error('HTTP ' + respuesta.status + ' ' + respuesta.statusText + ' -- ' + texto.slice(0, 500));
                        }
                        return { ok: respuesta.ok, data: data };
                    });
                })
                .then(function (resultado) {
                    pollingActivo = false;
                    actualizarBarra(resultado.data);
                    mostrarResultado(resultado.data);
                })
                .catch(function (err) {
                    pollingActivo = false;
                    console.error('Confirmar importación: fallo al confirmar', err);
                    resultadoDiv.innerHTML = '<div class="alert alert-danger">No se pudo confirmar la importación -- ' + escaparHtml(err.message || 'revisá la conexión e intentá de nuevo.') + '</div>';
                })
                .finally(function () {
                    btnConfirmar.disabled = false;
                });
        });
    })();
</script>

<script>
    function mostrarTipoDocumento(modulo) {
        document.getElementById('tipo-doc-sales').style.display = modulo === 'Sales' ? '' : 'none';
        document.getElementById('tipo-doc-purchase').style.display = modulo === 'Purchase' ? '' : 'none';
        document.getElementById('tipo-doc-inventory').style.display = modulo === 'Inventory' ? '' : 'none';
    }
    mostrarTipoDocumento(document.querySelector('[name="Input.Module"]').value);
</script>

<script>
    // "Descargar formato para importar" -- OnGetTemplateAsync (Index.cshtml.cs) ya
    // existe y genera el .xlsx en base a la configuración vigente para
    // Módulo+Tipo de documento+Tipo de línea (GenericImportService.GenerateTemplateAsync);
    // acá solo faltaba el disparador en la UI. Es un GET puro (sin antiforgery, sin
    // efectos secundarios) -- alcanza con navegar a la URL, no hace falta fetch.
    (function () {
        var btnDescargarFormato = document.getElementById('btnDescargarFormato');
        if (!btnDescargarFormato) {
            return;
        }

        btnDescargarFormato.addEventListener('click', function () {
            var modulo = document.querySelector('[name="Input.Module"]').value;
            // Mismo criterio que mostrarTipoDocumento -- el <select> real depende del
            // Módulo elegido, los otros dos quedan ocultos pero igual existen en el DOM.
            var tipoDocumentoSelectName = modulo === 'Sales' ? 'Input.SalesDocumentType'
                : modulo === 'Purchase' ? 'Input.PurchaseDocumentType'
                : 'Input.InventoryDocumentType';
            var tipoDocumento = document.querySelector('[name="' + tipoDocumentoSelectName + '"]').value;
            var tipoLinea = document.querySelector('[name="Input.LineType"]').value;
            var socio = document.querySelector('[name="Input.BusinessPartnerCardCode"]').value;

            if (!modulo || !tipoDocumento) {
                alert('Elegí Módulo y Tipo de documento antes de descargar el formato.');
                return;
            }

            var params = new URLSearchParams({
                handler: 'Template',
                module: modulo,
                documentType: tipoDocumento,
                lineType: tipoLinea,
            });
            if (socio) {
                params.append('businessPartnerCardCode', socio);
            }
            window.location.href = '?' + params.toString();
        });
    })();
</script>

<script src="~/js/catalog-search.js"></script>
<script>
    // Cliente si el Módulo elegido es Venta, Proveedor en cualquier otro caso (Compra/
    // Inventario) -- ver el comentario completo en OnGetSearchBusinessPartnersAsync.
    wireCatalogSearch({
        inputSelector: '.import-business-partner-code',
        datalistId: 'import-business-partners-datalist',
        handlerName: 'SearchBusinessPartners',
        minChars: 2,
        extraParams: function () { return { module: document.querySelector('[name="Input.Module"]').value }; },
        getValue: function (item) { return item.cardCode; },
        getLabel: function (item) { return item.cardCode + ' — ' + item.cardName; },
    });
</script>
