@page "/sellout/gruposretail"
@model Modulo.SellOut.Pages.GruposRetail.IndexModel
@{
    ViewData["Title"] = "Grupos retail";
    var puedeAbrirFormulario = Model.PuedeVer && (Model.PuedeCrear || Model.PuedeEditar);
    var formularioAbierto = Model.EditandoId is not null || !ViewData.ModelState.IsValid;
}

<div class="card-surface">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
        <h2 class="mb-0">Grupos retail</h2>
        @if (Model.PuedeVer && Model.PuedeCrear)
        {
            <button type="button" class="btn-primary" data-drawer-open="drawer-grupo-retail">+ Nuevo grupo retail</button>
        }
    </div>

    <partial name="_MensajesSellOut" model="Model" />

    @if (!Model.PuedeVer)
    {
        <p class="text-muted">No tenés permiso para ver esta pantalla.</p>
    }
    else
    {
        <form method="get" class="d-flex align-items-end gap-3 flex-wrap mb-3">
            <div class="mb-0 flex-grow-1" style="max-width:320px;">
                <label for="filtro-texto" class="form-label">Buscar</label>
                <input id="filtro-texto" name="FiltroTexto" class="form-control" value="@Model.FiltroTexto" placeholder="Nombre o propietario..." />
            </div>
            <div class="mb-0" style="min-width:220px;">
                <label for="filtro-localizacion" class="form-label">Localización</label>
                <select id="filtro-localizacion" name="FiltroIdLocalizacion" class="form-select" asp-items="Model.LocalizacionesDisponibles">
                    <option value="">Todas</option>
                </select>
            </div>
            <button type="submit" class="btn-secondary">Buscar</button>
            <a href="~/sellout/gruposretail" class="btn-ghost">Limpiar</a>
        </form>

        <table class="table-ps">
            <thead><tr><th>ID</th><th>Nombre</th><th>Propietario</th><th>Localización</th><th class="col-actions"></th></tr></thead>
            <tbody>
                @foreach (var g in Model.Grupos)
                {
                    <tr>
                        <td>@g.IDGrupoRetail</td>
                        <td>@g.NombreGrupoRetail</td>
                        <td>@g.Propietario</td>
                        <td>@g.Ciudad</td>
                        <td class="col-actions">
                            @if (Model.PuedeEditar)
                            {
                                <a href="~/sellout/gruposretail?editando=@g.IDGrupoRetail&filtroTexto=@Model.FiltroTexto&filtroIdLocalizacion=@Model.FiltroIdLocalizacion" class="btn-ghost" title="Editar"><i class="bi bi-pencil"></i></a>
                            }
                            @if (Model.PuedeEliminar)
                            {
                                <form asp-page="./Index" asp-page-handler="Eliminar" asp-route-id="@g.IDGrupoRetail" method="post" class="d-inline-block"
                                      onsubmit="return confirm('¿Eliminar el grupo retail &quot;@g.NombreGrupoRetail&quot;?');">
                                    <button type="submit" class="btn-ghost btn-ghost--danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Grupos.Count == 0)
                {
                    <tr><td colspan="5" class="text-muted">Sin grupos retail todavía.</td></tr>
                }
            </tbody>
        </table>
    }

    @if (puedeAbrirFormulario)
    {
        <div id="drawer-grupo-retail" class="drawer-overlay @(formularioAbierto ? "is-open" : "")" data-drawer>
            <aside class="drawer-panel @(formularioAbierto ? "is-open" : "")">
                <div class="drawer-header">
                    <h3>@(Model.EditandoId is null ? "Nuevo grupo retail" : $"Editar grupo retail · {Model.Input.NombreGrupoRetail}")</h3>
                    <button type="button" class="btn-ghost" data-drawer-close aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>
                <form asp-page="./Index" asp-page-handler="Guardar" asp-route-editando="@Model.EditandoId" method="post">
                    <input type="hidden" name="FiltroTexto" value="@Model.FiltroTexto" />
                    <input type="hidden" name="FiltroIdLocalizacion" value="@Model.FiltroIdLocalizacion" />
                    <div class="drawer-body">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>
                        <div class="drawer-grid">
                            <div class="mb-3">
                                <label asp-for="Input.IDGrupoRetail" class="form-label">ID</label>
                                <input asp-for="Input.IDGrupoRetail" type="number" class="form-control" readonly="@(Model.EditandoId is not null)" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.NombreGrupoRetail" class="form-label">Nombre</label>
                                <input asp-for="Input.NombreGrupoRetail" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.Propietario" class="form-label">Propietario</label>
                                <input asp-for="Input.Propietario" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.IDLocalizacion" class="form-label">Localización</label>
                                <select asp-for="Input.IDLocalizacion" asp-items="Model.LocalizacionesDisponibles" class="form-select">
                                    <option value="">Seleccionar...</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="drawer-footer">
                        <button type="button" class="btn-secondary" data-drawer-close>Cancelar</button>
                        <button type="submit" class="btn-primary">@(Model.EditandoId is null ? "Crear" : "Guardar")</button>
                    </div>
                </form>
            </aside>
        </div>
    }
</div>
