@page "{id:guid}"
@model PortalSaas.Host.Pages.Admin.Organizations.Companies.EditModel
@{
    ViewData["Title"] = $"Editar compañía · {Model.Organization.LegalName}";
}

<partial name="~/Pages/Admin/Organizations/_OrganizationSubnav.cshtml" model="@(new OrganizationSubnavViewModel { OrganizationId = Model.Organization.Id, OrganizationName = Model.Organization.LegalName, Mode = Model.Organization.Mode, ActivePage = "Companies" })" />

@* .card-surface + grid Bootstrap, no .doc-form/.doc-tab-seccion -- ver el mismo
   comentario en Organizations/Edit.cshtml (patrón denso de motor de documento
   aplicado a un formulario de campos anchos, produce celdas angostas descuadradas). *@
<div class="card-surface mb-4">
    <h2 class="h5 mb-3">Editar compañía · @Model.Organization.LegalName</h2>
    <form method="post" asp-antiforgery="true">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Input.Id" />

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Input.InstanceId" class="form-label"></label>
                <select asp-for="Input.InstanceId" class="form-select" asp-items="Model.Instances"></select>
                <span asp-validation-for="Input.InstanceId" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.Code" class="form-label"></label>
                <input asp-for="Input.Code" class="form-control" autofocus />
                <span asp-validation-for="Input.Code" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Input.DatabaseName" class="form-label"></label>
                <input asp-for="Input.DatabaseName" class="form-control" />
                <span asp-validation-for="Input.DatabaseName" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Input.ServiceLayerUrl" class="form-label"></label>
                <input asp-for="Input.ServiceLayerUrl" class="form-control" />
                <span asp-validation-for="Input.ServiceLayerUrl" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.IntegrationUsername" class="form-label"></label>
                <input asp-for="Input.IntegrationUsername" class="form-control" />
                <span asp-validation-for="Input.IntegrationUsername" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.IntegrationSecretKey" class="form-label"></label>
                <input asp-for="Input.IntegrationSecretKey" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.IntegrationSecretKey" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.Country" class="form-label"></label>
                <input asp-for="Input.Country" class="form-control" />
                <span asp-validation-for="Input.Country" class="text-danger"></span>
            </div>

            <div class="col-12 d-flex align-items-center">
                <div class="form-check">
                    <input asp-for="Input.IsActive" class="form-check-input" />
                    <label asp-for="Input.IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-primary">Guardar</button>
            <a asp-page="/Admin/Organizations/Companies/Index" asp-route-organizationId="@Model.Organization.Id" class="btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
