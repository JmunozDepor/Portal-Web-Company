<?xml version="1.0" encoding="utf-8"?>
<!--
  Base para el web.config que genera "dotnet publish": el SDK web (Microsoft.NET.Sdk.Web)
  detecta este archivo en el proyecto y lo usa como plantilla (solo reescribe el nodo
  aspNetCore, respeta el resto), en vez de generar uno desde cero. Sin este archivo,
  cada publish pisa cualquier configuración manual hecha directo en el web.config del
  servidor IIS.

  requestLimits/maxAllowedContentLength: el default de IIS (~28.6MB) es una capa de
  filtrado de IIS independiente del límite de ASP.NET Core (ver Program.cs,
  IISServerOptions.MaxRequestBodySize); hay que subir los dos, o el de IIS sigue
  cortando antes de que la app vea el request. Bug real: Rendiciones/Gastos/Importar
  (OCR) sube hasta 5 fotos de celular por vez y devolvía HTTP 400 al pasarse del límite.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\PortalSaas.Host.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
