@page "/wms/confirmaciones"
@model Modulo.Wms.Pages.Confirmaciones.IndexModel
@{
    ViewData["Title"] = Model.TipoLabel;

    string BadgeEstado(string status) => status switch
    {
        "ProcesadoWms" or "Procesado" or "OK" => "badge-status--success",
        "ErrorWms" or "Error" => "badge-status--danger",
        "Enviado" => "badge-status--neutral",
        _ => "badge-status--warning",
    };
}
@* Migrado al Design System unificado (2026-09-07) -- misma estructura que el
   listado de documentos del Host (/ventas/ordenes): .card-ps .doc-list +
   .document-list-table .line-items-table + .badge-status, todo sobre tokens del
   tema activo, sin .table/.badge sueltos ni CSS de módulo. *@

<div class="card-ps doc-list">
    <div class="doc-list-header">
        <h2 class="h4 mb-0">@Model.TipoLabel</h2>
        <div class="btn-group">
            <a class="btn btn-sm @(Model.Tipo == Modulo.Wms.Models.WmsTipoTransaccion.ConfirmacionOrdenes ? "btn-primary" : "btn-secondary")" asp-route-Tipo="ConfirmacionOrdenes">Órdenes</a>
            <a class="btn btn-sm @(Model.Tipo == Modulo.Wms.Models.WmsTipoTransaccion.ConfirmacionIngreso ? "btn-primary" : "btn-secondary")" asp-route-Tipo="ConfirmacionIngreso">Ingreso</a>
        </div>
    </div>

    @if (Model.SuccessMessage is not null)
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="document-list-table-wrapper">
        <table class="table table-striped document-list-table line-items-table align-middle">
            <thead><tr><th>Documento</th><th>Estado</th><th class="text-end">Líneas</th><th>Error</th><th class="doc-list-col-detalle"></th></tr></thead>
            <tbody>
            @foreach (var fila in Model.Resultado.Items)
            {
                <tr>
                    <td>@fila.Documento</td>
                    <td><span class="badge-status @BadgeEstado(fila.Status)">@fila.Status</span></td>
                    <td class="text-end">@fila.LineasCount</td>
                    <td class="small text-danger">@fila.ErrorMsg</td>
                    <td class="doc-list-col-detalle">
                        <form method="post" asp-page-handler="Resetear" class="d-inline">
                            <input type="hidden" name="tipo" value="@((int)Model.Tipo)" />
                            <input type="hidden" name="documento" value="@fila.Documento" />
                            <button type="submit" class="btn btn-sm btn-secondary">Resetear</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Resultado.Items.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-4">Sin registros.</td></tr>
            }
            </tbody>
        </table>
    </div>

    @{
        var pagerRoute = new Dictionary<string, string?>
        {
            ["Tipo"] = Model.Tipo.ToString(),
            ["Estado"] = Model.Estado,
            ["Documento"] = Model.Documento,
        };
        var pager = Modulo.Wms.Pages.Shared.WmsPagerModel.Desde(Model.Resultado, "Pagina", pagerRoute);
    }
    <partial name="_WmsPager" model="pager" />
</div>
