@page "/sellout/localizaciones"
@model Modulo.SellOut.Pages.Localizaciones.IndexModel
@{
    ViewData["Title"] = "Localizaciones";
}

<div class="card-ps admin-card">
    <div class="admin-card-header">
        <h2>Localizaciones</h2>
    </div>

    <partial name="_MensajesSellOut" model="Model" />

    @if (!Model.PuedeVer)
    {
        <p class="admin-muted">No tenés permiso para ver esta pantalla.</p>
    }
    else
    {
        @if (Model.PuedeCrear || Model.PuedeEditar)
        {
            <div class="doc-tab-seccion sellout-panel-edicion">
                <h3>@(Model.EditandoId is null ? "Nueva localización" : $"Editar localización · {Model.Input.Ciudad}")</h3>

                <form asp-page="./Index" asp-page-handler="Guardar" asp-route-editando="@Model.EditandoId" method="post">
                    <input type="hidden" name="FiltroTexto" value="@Model.FiltroTexto" />
                    <input type="hidden" name="FiltroIdGeografia" value="@Model.FiltroIdGeografia" />
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="sellout-grid">
                        <div class="form-group">
                            <label asp-for="Input.IDLocalizacion">ID</label>
                            <input asp-for="Input.IDLocalizacion" type="number" class="form-control" readonly="@(Model.EditandoId is not null)" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.Ciudad">Ciudad</label>
                            <input asp-for="Input.Ciudad" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.Comuna">Comuna</label>
                            <input asp-for="Input.Comuna" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.CodigoComuna">Código comuna</label>
                            <input asp-for="Input.CodigoComuna" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.IDGeografia">Geografía</label>
                            <select asp-for="Input.IDGeografia" asp-items="Model.GeografiasDisponibles" class="form-control">
                                <option value="">Sin asignar</option>
                            </select>
                        </div>
                    </div>
                    <button type="submit" class="btn-erp-primary">@(Model.EditandoId is null ? "Crear" : "Guardar")</button>
                    @if (Model.EditandoId is not null)
                    {
                        <a href="~/sellout/localizaciones?filtroTexto=@Model.FiltroTexto&filtroIdGeografia=@Model.FiltroIdGeografia" class="btn-module-action">Cancelar</a>
                    }
                </form>
            </div>
        }

        <form method="get" class="doc-list-filtros">
            <div class="form-group doc-list-busqueda">
                <label for="filtro-texto">Buscar</label>
                <input id="filtro-texto" name="FiltroTexto" class="form-control" value="@Model.FiltroTexto" placeholder="Ciudad o comuna..." />
            </div>
            <div class="form-group">
                <label for="filtro-geografia">Geografía</label>
                <select id="filtro-geografia" name="FiltroIdGeografia" class="form-control" asp-items="Model.GeografiasDisponibles">
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="form-group doc-list-filtros-acciones">
                <button type="submit" class="btn-module-action">Buscar</button>
                <a href="~/sellout/localizaciones" class="btn-module-action">Limpiar</a>
            </div>
        </form>

        <table class="admin-table">
            <thead><tr><th>ID</th><th>Ciudad</th><th>Comuna</th><th>Cod. comuna</th><th>Geografía</th><th class="admin-col-accion"></th></tr></thead>
            <tbody>
                @foreach (var l in Model.Localizaciones)
                {
                    <tr>
                        <td>@l.IDLocalizacion</td>
                        <td>@l.Ciudad</td>
                        <td>@l.Comuna</td>
                        <td>@l.CodigoComuna</td>
                        <td>@l.Region</td>
                        <td class="admin-col-accion">
                            <div class="admin-row-actions">
                                @if (Model.PuedeEditar)
                                {
                                    <a href="~/sellout/localizaciones?editando=@l.IDLocalizacion&filtroTexto=@Model.FiltroTexto&filtroIdGeografia=@Model.FiltroIdGeografia" class="btn-module-action">Editar</a>
                                }
                                @if (Model.PuedeEliminar)
                                {
                                    <form asp-page="./Index" asp-page-handler="Eliminar" asp-route-id="@l.IDLocalizacion" method="post" style="display:inline-block;"
                                          onsubmit="return confirm('¿Eliminar la localización &quot;@l.Ciudad&quot;?');">
                                        <button type="submit" class="btn-module-action btn-module-danger">Eliminar</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
