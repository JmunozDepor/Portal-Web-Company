@page "/wms/transacciones"
@model Modulo.Wms.Pages.Transacciones.IndexModel
@using Modulo.Wms.Models
@{
    ViewData["Title"] = Model.TipoLabel;
    var esProducto = Model.Tipo == WmsTipoTransaccion.EnvioProducto;

    string BadgeEstado(string status) => status switch
    {
        "ProcesadoWms" => "badge-status--success",
        "ErrorWms" => "badge-status--danger",
        "Enviado" => "badge-status--neutral",
        _ => "badge-status--warning",
    };
}
@* Migrado al Design System unificado (2026-09-07): se elimina el <style> propio y
   la paleta --wms-* (hex Bootstrap a fuego). La vista adopta la MISMA estructura
   que el listado de documentos del Host (/ventas/ordenes): una sola tarjeta
   .card-ps .doc-list con .filter-card + .document-list-table .line-items-table, de
   modo que hereda color, tipografía y densidad del tema activo sin CSS de módulo. *@

<div class="card-ps doc-list">
    <div class="doc-list-header">
        <h2 class="h4 mb-0">Envío SAP &rarr; WMS</h2>
        <a class="btn btn-secondary" asp-page="/Confirmaciones/Index">Ver Confirmación WMS &rarr; SAP &rarr;</a>
    </div>

    <div class="btn-group mb-3">
        <a class="btn btn-sm @(Model.Tipo == WmsTipoTransaccion.EnvioProducto ? "btn-primary" : "btn-secondary")" asp-route-Tipo="EnvioProducto">Productos</a>
        <a class="btn btn-sm @(Model.Tipo == WmsTipoTransaccion.EnvioSucursal ? "btn-primary" : "btn-secondary")" asp-route-Tipo="EnvioSucursal">Sucursales</a>
        <a class="btn btn-sm @(Model.Tipo == WmsTipoTransaccion.EnvioOrdenes ? "btn-primary" : "btn-secondary")" asp-route-Tipo="EnvioOrdenes">Órdenes</a>
        <a class="btn btn-sm @(Model.Tipo == WmsTipoTransaccion.EnvioIngresoAsn ? "btn-primary" : "btn-secondary")" asp-route-Tipo="EnvioIngresoAsn">Ingresos ASN</a>
    </div>

    @if (Model.SuccessMessage is not null)
    {
        <div class="alert alert-success py-2">@Model.SuccessMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
    }

    <form method="get" class="filter-card">
        <input type="hidden" name="Tipo" value="@((int)Model.Tipo)" />
        <div class="col-auto">
            <label class="form-label">Estado</label>
            <select name="Estado" class="form-select">
                <option value="">Todos</option>
                @foreach (var estado in new[] { "Pendiente", "Enviado", "ProcesadoWms", "ErrorWms" })
                {
                    <option value="@estado" selected="@(Model.Estado == estado ? "selected" : null)">@estado</option>
                }
            </select>
        </div>
        <div class="col-auto flex-grow-1">
            <label class="form-label">@(esProducto ? "Código / nombre / marca" : "Documento")</label>
            <input type="text" name="Documento" value="@Model.Documento" class="form-control" placeholder="Buscar..." />
        </div>
        <div class="col-auto">
            <label class="form-label">Desde</label>
            <input type="date" name="Desde" value="@(Model.Desde?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-auto">
            <label class="form-label">Hasta</label>
            <input type="date" name="Hasta" value="@(Model.Hasta?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Buscar</button>
            <a class="btn btn-secondary" asp-route-Tipo="@Model.Tipo">Limpiar</a>
        </div>
    </form>

    <form method="post" asp-page-handler="Resetear">
        <input type="hidden" name="tipo" value="@((int)Model.Tipo)" />
        <div class="doc-list-header">
            <span class="doc-list-contador mb-0"><strong>@Model.Resultado.TotalCount.ToString("N0")</strong> registro(s) encontrado(s)</span>
            <button type="submit" class="btn btn-sm btn-secondary">Resetear seleccionados a Pendiente</button>
        </div>
        <div class="document-list-table-wrapper">
            <table class="table table-striped document-list-table line-items-table align-middle">
                <thead>
                    <tr>
                        <th style="width: 2rem;"></th>
                        @if (esProducto)
                        {
                            <th>Producto</th>
                            <th>Marca</th>
                            <th>Código barra</th>
                        }
                        else
                        {
                            <th>Documento</th>
                        }
                        <th>Estado</th>
                        <th class="text-end">Reintentos</th>
                        <th>Error</th>
                        <th>Creado</th>
                        <th>Sincronizado</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var fila in Model.Resultado.Items)
                {
                    var esError = fila.Status == "ErrorWms";
                    var esPendienteCritico = fila.RetryCount >= 15;
                    <tr>
                        <td><input type="checkbox" name="lineIds" value="@fila.LineId" /></td>
                        @if (esProducto)
                        {
                            <td>
                                <div class="fw-semibold">@fila.Documento</div>
                                @if (!string.IsNullOrEmpty(fila.ItemName))
                                {
                                    <div class="small text-muted text-truncate" style="max-width: 260px;" title="@fila.ItemName">@fila.ItemName</div>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(fila.Marca))
                                {
                                    <span class="badge-status badge-status--neutral">@fila.Marca</span>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                            <td><span class="sap-code">@(fila.BarCode ?? "—")</span></td>
                        }
                        else
                        {
                            <td>@fila.Documento</td>
                        }
                        <td><span class="badge-status @BadgeEstado(fila.Status)">@fila.Status</span></td>
                        <td class="text-end">
                            <span class="sap-code @(esPendienteCritico ? "text-warning fw-bold" : null)">@fila.RetryCount/20</span>
                        </td>
                        <td class="small text-truncate @(esError ? "text-danger" : "text-muted")" style="max-width: 260px;" title="@fila.ErrorMsg">@(fila.ErrorMsg ?? "—")</td>
                        <td class="small">@fila.CreatedAt.ToLocalTime().ToString("dd-MM HH:mm")</td>
                        <td class="small">@(fila.SyncedAt?.ToLocalTime().ToString("dd-MM HH:mm") ?? "—")</td>
                    </tr>
                }
                @if (Model.Resultado.Items.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Sin registros para los filtros seleccionados.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </form>

    @{
        var pagerRoute = new Dictionary<string, string?>
        {
            ["Tipo"] = Model.Tipo.ToString(),
            ["Estado"] = Model.Estado,
            ["Documento"] = Model.Documento,
            ["Desde"] = Model.Desde?.ToString("yyyy-MM-dd"),
            ["Hasta"] = Model.Hasta?.ToString("yyyy-MM-dd"),
        };
        var pager = Modulo.Wms.Pages.Shared.WmsPagerModel.Desde(Model.Resultado, "Page", pagerRoute);
    }
    <partial name="_WmsPager" model="pager" />
</div>
