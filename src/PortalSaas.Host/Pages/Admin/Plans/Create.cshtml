@page
@model PortalSaas.Host.Pages.Admin.Plans.CreateModel
@{
    ViewData["Title"] = "Nuevo plan";
}

<div class="card-surface mb-4">
    <h2 class="h5 mb-3">Nuevo plan</h2>
    <form method="post" asp-antiforgery="true">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Input.Code" class="form-label"></label>
                <input asp-for="Input.Code" class="form-control" autofocus />
                <span asp-validation-for="Input.Code" class="text-danger"></span>
            </div>

            <div class="col-md-5">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.UserLimit" class="form-label"></label>
                <input asp-for="Input.UserLimit" class="form-control" />
                <span asp-validation-for="Input.UserLimit" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.CompanyLimit" class="form-label"></label>
                <input asp-for="Input.CompanyLimit" class="form-control" />
                <span asp-validation-for="Input.CompanyLimit" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.MonthlyTransactionLimit" class="form-label"></label>
                <input asp-for="Input.MonthlyTransactionLimit" class="form-control" />
                <span asp-validation-for="Input.MonthlyTransactionLimit" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.MonthlyPrice" class="form-label"></label>
                <input asp-for="Input.MonthlyPrice" class="form-control" />
                <span asp-validation-for="Input.MonthlyPrice" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.Currency" class="form-label"></label>
                <input asp-for="Input.Currency" class="form-control" />
                <span asp-validation-for="Input.Currency" class="text-danger"></span>
            </div>

            <div class="col-md-4 d-flex align-items-center">
                <div class="form-check">
                    <input asp-for="Input.IsActive" class="form-check-input" />
                    <label asp-for="Input.IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-primary">Crear</button>
            <a asp-page="/Admin/Plans/Index" class="btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
