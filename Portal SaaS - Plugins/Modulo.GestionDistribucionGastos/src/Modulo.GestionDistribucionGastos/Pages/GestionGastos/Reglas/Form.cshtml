@page "/gestiongastos/reglas/form"
@model Modulo.GestionDistribucionGastos.Pages.GestionGastos.Reglas.FormModel
@section Styles {
    <link rel="stylesheet" href="~/css/gestiongastos.css" />
}
@{ ViewData["Title"] = Model.EsNuevo ? "Nueva regla" : "Editar regla"; }

<partial name="_MensajesGestionGastos" model="Model" />
<partial name="_NavInterna" />

<div class="card">
    <form asp-page-handler="Guardar" asp-route-id="@(Model.EsNuevo ? null : Model.Regla.Id)" method="post">
        <input type="hidden" asp-for="Regla.Id" />
        <!--
            Muestra los errores "generales" (ModelState.AddModelError(string.Empty, ...)) que arma
            el catch de OnPostGuardarAsync -- ej. "String or binary data would be truncated" si
            BaseDistribucion no entra en la columna. Antes no había dónde mostrarlos: la página
            volvía a Guardar sin avanzar y sin ningún mensaje visible (los <span asp-validation-for>
            de abajo solo cubren errores de un campo puntual, no estos).
        -->
        <div asp-validation-summary="ModelOnly" style="color:var(--danger); font-size:13px; margin-bottom:8px;"></div>
        <div style="display:flex; flex-direction:column; gap:12px; max-width:420px;">
            <div>
                <label>Cuenta</label><br />
                <input asp-for="Regla.NroCuenta" type="text" style="width:100%" placeholder="61-01-001-01" />
                <span asp-validation-for="Regla.NroCuenta" style="color:var(--danger); font-size:12px;"></span>
                <br /><small style="color:var(--text-muted);">Podés usar <code>%</code> como comodín para cubrir varias cuentas con una sola regla: <code>61-09-%</code> matchea todas las cuentas que empiezan con "61-09-".</small>
            </div>
            <div>
                <label>Centro de costo (opcional, vacío = toda la cuenta)</label><br />
                <input asp-for="Regla.CodCentroCosto" type="text" style="width:100%" />
            </div>
            <div>
                <label>Base de distribución</label><br />
                <select asp-for="Regla.BaseDistribucion" asp-items="Model.OpcionesBaseDistribucion" style="width:100%"></select>
                <br /><small style="color:var(--text-muted);">Las opciones se administran en la tabla <code>Catalogo_BaseDistribucion</code> (Sql/Catalogo_BaseDistribucion.sql) -- agregar una base nueva no requiere tocar esta pantalla.</small>
            </div>
            <div>
                <label>Comentario</label><br />
                <input asp-for="Regla.Comentario" type="text" style="width:100%" />
            </div>
        </div>
        <div style="margin-top:16px; display:flex; gap:8px;">
            <a asp-page="/GestionGastos/Reglas/Index" class="btn">Cancelar</a>
            <button type="submit" class="btn-primary">@(Model.EsNuevo ? "Guardar" : "Guardar cambios")</button>
        </div>
    </form>
</div>
