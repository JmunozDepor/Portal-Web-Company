@page "/despachos/configuracion/destinatarios-avisos"
@model Modulo.Despachos.Pages.Despachos.Configuracion.DestinatariosAvisos.IndexModel
@section Styles {
    <link rel="stylesheet" href="~/css/despachos.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = "Destinatarios de avisos";
}
@* Mantenedor: grilla compacta con búsqueda y orden por columna; alta/edición en drawer
   (data-drawer-open + despachos-maestros.js); eliminar con confirmación. *@

<div class="card-surface">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
        <h2 class="mb-0">Destinatarios de avisos</h2>
        @if (Model.CanCreate)
        {
            <button type="button" class="btn-primary" data-drawer-open="drawer-destinatarios-avisos" data-maestro-new="form-destinatarios-avisos">+ Nuevo destinatario</button>
        }
    </div>

    @if (Model.SuccessMessage is not null)
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="filter-card mb-3">
        <div class="col-auto flex-grow-1" style="max-width:360px;">
            <label for="buscar-destinatarios-avisos" class="form-label">Buscar</label>
            <input type="search" id="buscar-destinatarios-avisos" class="form-control" placeholder="Escriba para filtrar..." autocomplete="off" data-maestro-search="tabla-destinatarios-avisos" />
        </div>
    </div>

    <table class="table-ps" id="tabla-destinatarios-avisos" data-maestro-table>
        <thead><tr><th data-sort="text">Usuario</th><th data-sort="text">Correo</th><th data-sort="text">Estado</th><th class="col-actions"></th></tr></thead>
        <tbody>
            @foreach (var x in Model.Items)
            {
                <tr class="@(x.IsActive ? "" : "row-inactive")" data-buscable="@(($"{Model.UserName(x.UserId)} {Model.UserEmail(x.UserId)}").ToLowerInvariant())">
                    <td>@Model.UserName(x.UserId)</td>
                    <td>@Model.UserEmail(x.UserId)</td>
                    <td>@if (x.IsActive) { <span class="badge-status badge-status--success">Activo</span> } else { <span class="badge-status badge-status--neutral">Inactivo</span> }</td>
                    <td class="col-actions">
                        <div class="admin-row-actions">
                            @if (Model.CanEdit)
                            {
                                <button type="button" class="btn-ghost" title="Editar" data-drawer-open="drawer-destinatarios-avisos" data-maestro-edit data-row="@Model.RowJson(new { x.Id, x.UserId, x.IsActive })"><i class="bi bi-pencil"></i></button>
                            }
                            @if (Model.CanDelete)
                            {
                                <form method="post" asp-page-handler="Delete" asp-route-id="@x.Id" asp-antiforgery="true" class="d-inline-block" data-confirm="@($"¿Eliminar {Model.UserName(x.UserId)}?")">
                                    <button type="submit" class="btn-ghost btn-ghost--danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr data-table-empty><td colspan="4" class="text-muted">Sin destinatarios de avisos todavía.</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.CanCreate || Model.CanEdit)
{
    <div id="drawer-destinatarios-avisos" class="drawer-overlay" data-drawer>
        <aside class="drawer-panel">
            <div class="drawer-header">
                <h3 data-drawer-title data-title-new="Nuevo destinatario" data-title-edit="Editar destinatario">Nuevo destinatario</h3>
                <button type="button" class="btn-ghost" data-drawer-close aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <form method="post" asp-page-handler="Save" asp-antiforgery="true" id="form-destinatarios-avisos">
                <div class="drawer-body">
                    <input type="hidden" name="Input.Id" value="0" />
                    <div class="drawer-grid">
                    <div class="mb-3 span-2">
                        <label class="form-label" for="f-UserId">Usuario del portal</label>
                        <select id="f-UserId" name="Input.UserId" class="form-select" required>
                            <option value="">— Elegir usuario —</option>
                            @foreach (var u in Model.Users)
                            {
                                <option value="@u.Id">@u.Username (@u.Email)@(u.IsActive ? "" : " - inactivo")</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3 d-flex align-items-end ">
                        <label class="d-flex align-items-center gap-2"><input type="checkbox" name="Input.IsActive" value="true" checked /> Activo</label>
                    </div>
                    </div>
                <p class="text-muted">Estos usuarios reciben en la campana del portal los avisos del módulo (despachos, retornos, cierres).</p>
                </div>
                <div class="drawer-footer">
                    <button type="button" class="btn-secondary" data-drawer-close>Cancelar</button>
                    <button type="submit" class="btn-primary" data-submit-label data-label-new="Crear" data-label-edit="Guardar">Crear</button>
                </div>
            </form>
        </aside>
    </div>
}

@section Scripts {
    <script src="~/js/table-tools.js"></script>
    <script src="~/js/despachos-maestros.js" asp-append-version="true"></script>
}
