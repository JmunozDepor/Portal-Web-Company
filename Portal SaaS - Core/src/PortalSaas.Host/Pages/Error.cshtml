@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="card-ps doc-tab-seccion" style="max-width: 720px; margin: 2rem auto;">
    <div style="text-align: center; padding: 1rem 0;">
        <i class="bi bi-exclamation-triangle" style="font-size: 3rem; color: var(--bs-danger, #dc3545);"></i>
        <h1 class="h4 mt-3 mb-2">No pudimos completar la operación</h1>
        <p class="text-muted mb-0">
            Algo salió mal de nuestro lado. Ya quedó registrado -- si el problema sigue, compartí
            el código de abajo con soporte.
        </p>
        <p class="mt-2">
            <span class="badge bg-secondary">Código: @Model.RequestId</span>
        </p>
    </div>

    @{
        // El destino de "Volver" depende de dónde ocurrió la excepción: una
        // sesión de administrador de plataforma (/Admin/*) no tiene shell de
        // tenant, así que mandarla a /Home la saca de su contexto. Se usa la
        // ruta real del fallo (IExceptionHandlerPathFeature.Path) para elegir.
        var esContextoAdmin = Model.RoutePath?.StartsWith("/Admin", StringComparison.OrdinalIgnoreCase) == true;
        // Url.Content resuelve el "~/" contra el PathBase real de la app -- un href="~/..."
        // crudo el navegador lo toma literal y termina en 404 (ej.
        // /inventario/solicitudes-traslado/~/Home/Index) al abrir la página de error
        // desde una ruta anidada de un plugin.
        var volverUrl = Url.Content(esContextoAdmin ? "~/Admin/Organizations" : "~/Home/Index");
        var volverTexto = esContextoAdmin ? "Volver a Organizaciones" : "Volver al inicio";
    }

    <div class="d-flex justify-content-center gap-2 mb-3">
        <a href="@volverUrl" class="btn-erp-primary">@volverTexto</a>
        <button type="button" class="btn btn-outline-secondary" onclick="history.back()">Volver atrás</button>
    </div>

    @if (Model.ShowDetails)
    {
        <hr />
        <details class="mt-2">
            <summary class="text-danger" style="cursor: pointer;">
                Detalle técnico (solo visible en Development -- nunca aparece así en producción)
            </summary>
            <div class="mt-2">
                <p><strong>Ruta:</strong> <code>@Model.RoutePath</code></p>
                <p><strong>Tipo:</strong> <code>@Model.ExceptionType</code></p>
                <p><strong>Mensaje:</strong> @Model.ExceptionMessage</p>
                <pre style="white-space: pre-wrap; font-size: 0.8rem; background: var(--bs-tertiary-bg, #f8f9fa); padding: 1rem; border-radius: 6px; max-height: 400px; overflow-y: auto;">@Model.StackTrace</pre>
            </div>
        </details>
    }
</div>
