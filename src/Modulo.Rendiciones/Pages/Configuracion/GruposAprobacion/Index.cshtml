@page "/rendiciones/configuracion/grupos"
@model Modulo.Rendiciones.Pages.Configuracion.GruposAprobacion.IndexModel
@{
    ViewData["Title"] = "Grupos de aprobación";
}
@section Styles {
    <link rel="stylesheet" href="~/css/rendiciones.css" asp-append-version="true" />
}

<div class="card-ps admin-card">
    <div class="admin-card-header">
        <h2>Grupos de aprobación</h2>
    </div>

@if (Model.SuccessMessage is not null)
{
    <div class="admin-alert admin-alert-success">@Model.SuccessMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="admin-alert admin-alert-danger">@Model.ErrorMessage</div>
}

<div class="admin-master-detail">
    <div>
        <div class="admin-master-list">
            @foreach (var g in Model.Groups)
            {
                <a href="~/rendiciones/configuracion/grupos?groupId=@g.Id"
                   class="@(Model.GroupId == g.Id ? "admin-master-activo" : "")">
                    <span>@g.Name</span>
                </a>
            }
        </div>

        <div class="admin-master-nuevo">
            <span class="admin-subtitulo">Nuevo grupo</span>
            <form method="post" asp-page-handler="CrearGrupo" class="admin-form-asignar">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Group.Name">Nombre</label>
                    <input asp-for="Group.Name" class="form-control" />
                </div>
                <button type="submit" class="btn-erp-primary btn-erp-primary--sm">Crear grupo</button>
            </form>
        </div>
    </div>

    <div>
        @if (Model.GroupId is { } groupId)
        {
            <div class="admin-subcard">
                <h3>Equipo</h3>
                <p class="admin-muted">Quiénes solicitan rendiciones bajo este grupo (se asume 1 grupo por colaborador).</p>
                <table class="admin-table">
                    <thead><tr><th>Colaborador</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var userId in Model.GroupMembers)
                        {
                            <tr>
                                <td>@(Model.NameByUserId.GetValueOrDefault(userId, userId.ToString()))</td>
                                <td>
                                    <form asp-page="./Index" asp-page-handler="QuitarMiembro" asp-route-groupId="@groupId" asp-route-userId="@userId" method="post">
                                        <button type="submit" class="btn-module-action btn-module-danger">Quitar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (Model.GroupMembers.Count == 0)
                        {
                            <tr><td colspan="2" class="admin-muted">Sin colaboradores asignados todavía.</td></tr>
                        }
                    </tbody>
                </table>

                <form asp-page="./Index" asp-page-handler="AgregarMiembro" asp-route-groupId="@groupId" method="post" class="admin-form-asignar">
                    <div class="form-group">
                        <label>Colaborador</label>
                        <select asp-for="SelectedUserId" asp-items="Model.AvailableUsers" class="form-control">
                            <option value="">-- Seleccionar --</option>
                        </select>
                    </div>
                    <button type="submit" class="btn-module-action">+ Agregar al equipo</button>
                </form>
            </div>

            <div class="admin-subcard">
                <h3>Cadena de aprobación</h3>
                <p class="admin-muted">2 niveles fijos, nunca en paralelo. Nivel 1 = jefe, Nivel 2 = gerente final.</p>
                <table class="admin-table">
                    <thead><tr><th>Nivel</th><th>Aprobador</th><th></th></tr></thead>
                    <tbody>
                        @for (var nivel = 1; nivel <= 2; nivel++)
                        {
                            <tr>
                                <td>@nivel</td>
                                <td>
                                    @if (Model.GroupLevels.TryGetValue(nivel, out var approverId))
                                    {
                                        @Model.NameByUserId.GetValueOrDefault(approverId, approverId.ToString())
                                    }
                                    else
                                    {
                                        <span class="admin-muted">Sin asignar</span>
                                    }
                                </td>
                                <td>
                                    @if (Model.GroupLevels.ContainsKey(nivel))
                                    {
                                        <form asp-page="./Index" asp-page-handler="QuitarNivel" asp-route-groupId="@groupId" asp-route-nivel="@nivel" method="post" style="display:inline-block;">
                                            <button type="submit" class="btn-module-action btn-module-danger">Quitar</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <form asp-page="./Index" asp-page-handler="AsignarNivel" asp-route-groupId="@groupId" method="post" class="admin-form-asignar">
                    <div class="form-group">
                        <label>Nivel</label>
                        <select name="nivel" class="form-control">
                            <option value="1">1</option>
                            <option value="2">2</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Aprobador</label>
                        <select asp-for="SelectedUserId" asp-items="Model.AvailableUsers" class="form-control">
                            <option value="">-- Seleccionar --</option>
                        </select>
                    </div>
                    <button type="submit" class="btn-module-action">Asignar nivel</button>
                </form>
            </div>
        }
        else
        {
            <p class="admin-muted">Seleccioná un grupo de la lista o creá uno nuevo.</p>
        }
    </div>
</div>
</div>
