@page "{id:long}"
@model PortalSaas.Host.Pages.Admin.Organizations.Subscriptions.EditModel
@{
    ViewData["Title"] = $"Editar suscripción · {Model.Organization.LegalName}";
}

<partial name="~/Pages/Admin/Organizations/_OrganizationSubnav.cshtml" model="@(new OrganizationSubnavViewModel { OrganizationId = Model.Organization.Id, OrganizationName = Model.Organization.LegalName, Mode = Model.Organization.Mode, ActivePage = "License" })" />

<div class="card-surface mb-4">
    <h2 class="h5 mb-1">Editar suscripción</h2>
    <p class="text-muted mb-3">Plan: @Model.PlanLabel (el plan asignado no se cambia acá -- crea una nueva suscripción para cambiar de plan).</p>
    <form method="post" asp-antiforgery="true">
        <input type="hidden" asp-for="Input.Id" />
        <input type="hidden" asp-for="Input.OrganizationId" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Input.Status" class="form-label"></label>
                <select asp-for="Input.Status" class="form-select" asp-items="PortalSaas.Data.Entities.SubscriptionStatus.All.Select(s => new SelectListItem(s, s))"></select>
                <span asp-validation-for="Input.Status" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.EndedAt" class="form-label"></label>
                <input asp-for="Input.EndedAt" type="date" class="form-control" />
                <span asp-validation-for="Input.EndedAt" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.PaymentProvider" class="form-label"></label>
                <input asp-for="Input.PaymentProvider" class="form-control" placeholder="stripe / flow / transbank" />
                <span asp-validation-for="Input.PaymentProvider" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.ExternalPaymentReference" class="form-label"></label>
                <input asp-for="Input.ExternalPaymentReference" class="form-control" />
                <span asp-validation-for="Input.ExternalPaymentReference" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-primary">Guardar</button>
            <a asp-page="/Admin/Organizations/Subscriptions/Index" asp-route-organizationId="@Model.Organization.Id" class="btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
