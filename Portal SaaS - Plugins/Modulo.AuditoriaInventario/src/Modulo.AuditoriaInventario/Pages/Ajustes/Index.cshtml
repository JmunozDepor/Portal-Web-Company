@page "/auditoria-inventario/ajustes"
@model Modulo.AuditoriaInventario.Pages.Ajustes.IndexModel
@{
    ViewData["Title"] = "Ajustes";
}

<div class="card-surface">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-1 flex-wrap">
        <h2 class="mb-0">Ajustes de Inventario</h2>
        @if (Model.Ajustes.Any(a => a.SapQueueStatus is not null))
        {
            <a class="btn btn-secondary" asp-page-handler="Exportar">
                <i class="bi bi-file-earmark-excel"></i> Exportar a SAP
            </a>
        }
    </div>
    <p class="text-muted mb-3">
        Ajustes propuestos a partir de una diferencia detectada. Requieren aprobación
        manual antes de encolarse hacia SAP -- este módulo nunca llama a SAP
        directamente; "Exportar a SAP" baja un Excel con los campos que SAP necesita
        (compañía/almacén/material/cantidad, separado en ingreso/salida) para tipear
        en la transacción estándar (MIGO/MI07).
    </p>

    @if (Model.SuccessMessage is not null)
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.Ajustes.Count == 0)
    {
        <p class="text-muted">Todavía no hay ajustes propuestos.</p>
    }
    else
    {
        <div class="document-list-table-wrapper">
            <table class="table document-list-table mb-0">
                <thead>
                    <tr>
                        <th>Sucursal</th>
                        <th>Nro. Inventario</th>
                        <th>Código de barra</th>
                        <th>Movimiento</th>
                        <th class="text-end">Cantidad</th>
                        <th>Estado</th>
                        <th>Estado SAP</th>
                        <th>Propuesto</th>
                        <th>Aprobado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Ajustes)
                    {
                        <tr>
                            <td>@a.BranchName</td>
                            <td>@a.InventoryNumber</td>
                            <td>@a.Barcode</td>
                            <td>
                                <span class="tag @(a.EsIngreso ? "tag--active" : "tag--closed")" title="@a.TipoMovimientoSugerido">
                                    @(a.EsIngreso ? "Ingreso" : "Salida")
                                </span>
                            </td>
                            <td class="text-end">@a.CantidadAbsoluta.ToString("N0")</td>
                            <td>@a.Status</td>
                            <td>@(a.SapQueueStatus ?? "-")</td>
                            <td>@a.ProposedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                            <td>@(a.ApprovedAt?.ToLocalTime().ToString("dd-MM-yyyy HH:mm") ?? "-")</td>
                            <td>
                                @if (a.Status == "PROPOSED")
                                {
                                    <form method="post" asp-page-handler="Aprobar" asp-route-id="@a.Id" class="d-inline" asp-antiforgery="true">
                                        <button type="submit" class="btn btn-sm btn-success">Aprobar</button>
                                    </form>
                                    <form method="post" asp-page-handler="Rechazar" asp-route-id="@a.Id" class="d-inline" asp-antiforgery="true">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Rechazar</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
