@page "/rendiciones/configuracion/tipos-gasto"
@model Modulo.Rendiciones.Pages.Configuracion.TiposGasto.IndexModel
@{
    ViewData["Title"] = "Tipos de gasto";
}
@* Migrado al Design System unificado (2026-08-19) -- ya no carga rendiciones.css.
   "Nuevo tipo de gasto" pasó de formulario inline gigante a slide-over drawer
   (drawer.js/components.css, patrón único de creación en todo el portal). *@
@* Grilla compacta + búsqueda + orden por columna + acciones en una sola línea
   (pedido explícito, 2026-10-20) -- ver .rnd-admin-compact y el script al final. *@
<style>
    .rnd-admin-compact .form-control { padding: 4px 8px; font-size: 13px; min-height: auto; }
    .rnd-admin-compact td, .rnd-admin-compact th { padding: 4px 8px; }
    .rnd-admin-compact .admin-row-actions { flex-wrap: nowrap; }
    .rnd-admin-compact th[data-sort] { cursor: pointer; user-select: none; white-space: nowrap; }
    .rnd-admin-compact th[data-sort] .bi { opacity: .45; font-size: 11px; }
    .rnd-cuenta-nombre { font-size: 11px; color: var(--text-muted); margin-top: 2px; }
</style>

<div class="card-surface">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-3 flex-wrap">
        <h2 class="mb-0">Tipos de gasto</h2>
        <button type="button" class="btn btn-primary" data-drawer-open="drawer-nuevo-tipo-gasto">+ Nuevo tipo de gasto</button>
    </div>

@if (Model.SuccessMessage is not null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="d-flex align-items-center gap-2 mb-2">
    <input type="search" id="rndBuscarTipoGasto" class="form-control" style="max-width:280px;" placeholder="Buscar por nombre o cuenta…" autocomplete="off" />
</div>

<div class="table-responsive-lg">
    <table class="table-ps rnd-admin-compact" id="rndTablaTiposGasto">
        <thead>
            <tr>
                <th data-sort="nombre">Nombre <i class="bi bi-arrow-down-up"></i></th>
                <th data-sort="cuenta">Cuenta contable SAP <i class="bi bi-arrow-down-up"></i></th>
                <th>Kilometraje</th>
                <th data-sort="tarifa">Tarifa/km <i class="bi bi-arrow-down-up"></i></th>
                <th>Requiere cantidad</th>
                <th>Rótulo</th>
                <th data-sort="estado">Estado <i class="bi bi-arrow-down-up"></i></th>
                <th class="col-actions"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Types)
            {
                var formId = $"tipo-{t.Id}";
                var cuentaNombre = t.SapGlAccount is not null ? Model.AccountNames.GetValueOrDefault(t.SapGlAccount) : null;
                <tr class="@(t.IsActive ? "" : "row-inactive")"
                    data-nombre="@t.Name.ToLowerInvariant()" data-cuenta="@(t.SapGlAccount ?? "").ToLowerInvariant()"
                    data-key-nombre="@t.Name.ToLowerInvariant()" data-key-cuenta="@(t.SapGlAccount ?? "").ToLowerInvariant()"
                    data-key-tarifa="@(t.RatePerKm ?? 0)" data-key-estado="@(t.IsActive ? 0 : 1)">
                    <td><input type="text" name="nombre" value="@t.Name" class="form-control" form="@formId" /></td>
                    <td>
                        <input type="text" name="cuentaContableSap" value="@t.SapGlAccount" class="form-control tipo-gasto-cuenta-sap" list="tipos-gasto-cuentas-datalist" placeholder="Buscar…" form="@formId" />
                        @if (!string.IsNullOrWhiteSpace(cuentaNombre))
                        {
                            <div class="rnd-cuenta-nombre">@cuentaNombre</div>
                        }
                    </td>
                    <td><input type="checkbox" name="esKilometraje" value="true" checked="@t.IsMileage" form="@formId" /></td>
                    @* Mismo bug que Políticas de Gasto: es-CL (coma decimal) + interpolación
                       directa en un <input type="number"> (que exige punto) lo deja vacío. *@
                    <td><input type="number" step="0.01" name="tarifaPorKm" value="@(t.RatePerKm?.ToString(System.Globalization.CultureInfo.InvariantCulture))" class="form-control" placeholder="CLP/km" form="@formId" /></td>
                    <td><input type="checkbox" name="requiereCantidad" value="true" checked="@t.RequiresQuantity" form="@formId" /></td>
                    <td><input type="text" name="rotuloCantidad" value="@t.QuantityLabel" class="form-control" placeholder="Ej. Días" form="@formId" /></td>
                    <td>
                        <input type="hidden" name="activo" value="@t.IsActive" form="@formId" />
                        @if (t.IsActive)
                        {
                            <span class="badge-status badge-status--success">Activo</span>
                        }
                        else
                        {
                            <span class="badge-status badge-status--neutral">Inactivo</span>
                        }
                    </td>
                    <td class="col-actions">
                        <div class="admin-row-actions">
                            <button type="submit" class="btn-ghost" title="Guardar" form="@formId"><i class="bi bi-check-lg"></i></button>
                            @if (t.IsActive)
                            {
                                <form asp-page="./Index" asp-page-handler="Desactivar" asp-route-id="@t.Id" asp-route-nombre="@t.Name" asp-route-cuentaContableSap="@t.SapGlAccount" asp-route-esKilometraje="@t.IsMileage" asp-route-tarifaPorKm="@t.RatePerKm" asp-route-requiereCantidad="@t.RequiresQuantity" asp-route-rotuloCantidad="@t.QuantityLabel" method="post" class="d-inline-block">
                                    <button type="submit" class="btn-ghost btn-ghost--danger" title="Desactivar"><i class="bi bi-slash-circle"></i></button>
                                </form>
                            }
                            else
                            {
                                <form asp-page="./Index" asp-page-handler="Activar" asp-route-id="@t.Id" asp-route-nombre="@t.Name" asp-route-cuentaContableSap="@t.SapGlAccount" asp-route-esKilometraje="@t.IsMileage" asp-route-tarifaPorKm="@t.RatePerKm" asp-route-requiereCantidad="@t.RequiresQuantity" asp-route-rotuloCantidad="@t.QuantityLabel" method="post" class="d-inline-block">
                                    <button type="submit" class="btn-ghost" title="Activar"><i class="bi bi-check-circle"></i></button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Types.Count == 0)
            {
                <tr><td colspan="8" class="text-muted">Sin tipos de gasto todavía.</td></tr>
            }
        </tbody>
    </table>
</div>
<p class="text-muted" id="rndSinResultadosTipoGasto" hidden>Ningún tipo de gasto coincide con la búsqueda.</p>

@* Un <form> no puede abrirse en una <td> y cerrarse en otra (el parser lo corta en
   el primer </td>), y tampoco puede ser hijo directo de <tr> -- por eso viven acá
   afuera, vacíos, y los inputs/botones de cada fila se asocian por id vía form="...". *@
@foreach (var t in Model.Types)
{
    <form id="tipo-@t.Id" asp-page="./Index" asp-page-handler="Guardar" asp-route-id="@t.Id"></form>
}
</div>

<datalist id="tipos-gasto-cuentas-datalist"></datalist>

@* Slide-over drawer -- "Nuevo tipo de gasto". Se auto-abre si el POST a
   "Crear" falló validación (ModelState inválido) y la página se re-renderiza
   con los errores -- si no, el usuario nunca vería por qué falló. *@
@{ var tipoGastoFormInvalido = !ViewData.ModelState.IsValid; }
<div id="drawer-nuevo-tipo-gasto" class="drawer-overlay @(tipoGastoFormInvalido ? "is-open" : "")" data-drawer>
    <aside class="drawer-panel @(tipoGastoFormInvalido ? "is-open" : "")">
        <div class="drawer-header">
            <h3>Nuevo tipo de gasto</h3>
            <button type="button" class="btn-ghost" data-drawer-close aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
        </div>
        <form method="post" asp-page-handler="Crear" id="form-nuevo-tipo-gasto">
            <div class="drawer-body">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="drawer-grid">
                    <div class="mb-3 span-2">
                        <label asp-for="New.Name" class="form-label">Nombre</label>
                        <input asp-for="New.Name" class="form-control" placeholder="Ej. Combustible, Peaje..." />
                    </div>
                    <div class="mb-3 span-2">
                        <label asp-for="New.SapGlAccount" class="form-label">Cuenta contable SAP</label>
                        <input asp-for="New.SapGlAccount" class="form-control tipo-gasto-cuenta-sap" list="tipos-gasto-cuentas-datalist" placeholder="Buscar…" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="New.RatePerKm" class="form-label">Tarifa/km (CLP)</label>
                        <input asp-for="New.RatePerKm" class="form-control" placeholder="Ej. 500" />
                    </div>
                    <div class="mb-3 d-flex align-items-end">
                        <label class="d-flex align-items-center gap-2"><input asp-for="New.IsMileage" type="checkbox" /> Es kilometraje</label>
                    </div>
                    <div class="mb-3 d-flex align-items-end">
                        <label class="d-flex align-items-center gap-2"><input asp-for="New.RequiresQuantity" type="checkbox" /> Requiere cantidad</label>
                    </div>
                    <div class="mb-3">
                        <label asp-for="New.QuantityLabel" class="form-label">Rótulo</label>
                        <input asp-for="New.QuantityLabel" class="form-control" placeholder="Ej. Días" />
                    </div>
                </div>
                <p class="text-muted">Marcá "Es kilometraje" para un tipo como "Uso vehículo particular" -- el gasto se captura con origen/destino en vez de comprobante, y el monto se calcula solo (distancia de ruta × tarifa).</p>
                <p class="text-muted">Marcá "Requiere cantidad" para un tipo como "Movilización (Bip)" -- la línea del gasto va a pedir una cantidad (ej. "3 días") además del monto.</p>
            </div>
            <div class="drawer-footer">
                <button type="button" class="btn btn-secondary" data-drawer-close>Cancelar</button>
                <button type="submit" class="btn btn-primary">Crear</button>
            </div>
        </form>
    </aside>
</div>

@section Scripts {
    <script src="~/js/catalog-search.js"></script>
    <script>
        wireCatalogSearch({
            inputSelector: '.tipo-gasto-cuenta-sap',
            datalistId: 'tipos-gasto-cuentas-datalist',
            handlerName: 'SearchAccounts',
            minChars: 0,
            getValue: function (item) { return item.accountCode; },
            getLabel: function (item) { return item.accountCode + ' — ' + item.accountName; },
        });
    </script>
    <script>
        (function () {
            var tabla = document.getElementById('rndTablaTiposGasto');
            if (!tabla) return;
            var tbody = tabla.querySelector('tbody');
            var buscador = document.getElementById('rndBuscarTipoGasto');
            var sinResultados = document.getElementById('rndSinResultadosTipoGasto');
            var filas = Array.prototype.slice.call(tbody.querySelectorAll('tr[data-nombre]'));

            buscador?.addEventListener('input', function () {
                var texto = buscador.value.trim().toLowerCase();
                var visibles = 0;
                filas.forEach(function (fila) {
                    var coincide = !texto || fila.dataset.nombre.includes(texto) || fila.dataset.cuenta.includes(texto);
                    fila.hidden = !coincide;
                    if (coincide) visibles++;
                });
                if (sinResultados) sinResultados.hidden = visibles !== 0;
            });

            tabla.querySelectorAll('th[data-sort]').forEach(function (th) {
                th.addEventListener('click', function () {
                    var key = th.dataset.sort;
                    var dirActual = th.dataset.dir === 'asc' ? 1 : -1;
                    tabla.querySelectorAll('th[data-sort]').forEach(function (otro) { if (otro !== th) delete otro.dataset.dir; });
                    th.dataset.dir = dirActual === 1 ? 'desc' : 'asc';
                    var dir = dirActual === 1 ? 1 : -1;
                    var esNumerico = key === 'tarifa' || key === 'estado';
                    var campo = 'key' + key.charAt(0).toUpperCase() + key.slice(1);
                    filas.sort(function (a, b) {
                        var va = a.dataset[campo] || '';
                        var vb = b.dataset[campo] || '';
                        if (esNumerico) return ((parseFloat(va) || 0) - (parseFloat(vb) || 0)) * dir;
                        return va.localeCompare(vb) * dir;
                    });
                    filas.forEach(function (fila) { tbody.appendChild(fila); });
                });
            });
        })();
    </script>
}
