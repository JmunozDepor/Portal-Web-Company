# Copia este archivo a "build-secrets.local.ps1" (mismo directorio) y completa los
# valores reales. build-secrets.local.ps1 NO debe subirse nunca a git -- si en algún
# momento esta carpeta raíz pasa a ser un repo, agrégalo a .gitignore de inmediato.
#
# build-all.ps1 lo carga con dot-sourcing (". $root\build-secrets.local.ps1") y falla
# con un mensaje claro si no lo encuentra, en vez de tener las credenciales reales
# hardcodeadas directamente en el script.

# Desde 20 ago 2026 los dos roles corren contra PostgreSQL (172.16.122.171), no SQL
# Server -- ver docs/10-DOCKER-POSTGRES-PRODUCCION.md de Portal SaaS - Core.
# MasterSecretKey debe ser IGUAL en los dos roles si "Central" (portalsaas_saas_prod)
# aloja configuración de organizaciones (instances/companies/module_external_connections)
# cuyos secretos se cifraron con la clave de "ComercialDepor" -- una clave distinta deja
# esos secretos indescifrables en silencio.
$Secrets = @{
    Central = @{
        ConnectionString      = "Host=172.16.122.171;Port=5432;Database=portalsaas_saas_prod;Username=CAMBIAR;Password=CAMBIAR"
        MasterSecretKey       = "CAMBIAR"
        LicensingSigningKey   = "CAMBIAR"
        LicensingPublicKey    = "CAMBIAR"
    }
    ComercialDepor = @{
        ConnectionString      = "Host=172.16.122.171;Port=5432;Database=ps_comdepor;Username=CAMBIAR;Password=CAMBIAR"
        MasterSecretKey       = "CAMBIAR"
        LicensingPublicKey    = "CAMBIAR"
        # ActivationKey de la fila real de on_premise_licenses de esta organización --
        # necesaria para el heartbeat de licenciamiento (ver build-all.ps1).
        LicensingActivationKey = "CAMBIAR"
    }
}
