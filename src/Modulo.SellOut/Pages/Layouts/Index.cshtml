@page "/sellout/layouts"
@model Modulo.SellOut.Pages.Layouts.IndexModel
@{
    ViewData["Title"] = "Configuración de layouts";
}

<div class="card-ps admin-card">
    <div class="admin-card-header">
        <h2>Configuración de layouts (CfgClienteLayoutInput)</h2>
    </div>

    <p class="admin-muted">
        Define cómo el pipeline SSIS interpreta el archivo de cada cliente retail. Cada campo "Map*" acepta:
        una referencia a columna de staging (<code>Col17</code>), una fórmula de lectura sobre esas columnas donde
        <code>ColN</code> se reemplaza por el valor real del archivo al leerlo
        (<code>CONCAT(Col3, ' | ', Col6, ' | ', Col7)</code>, <code>TRY_CAST(Col22 AS NUMERIC(18,0)) / 1.19</code>),
        o el literal <code>Calcular</code> (el servicio de importación calcula ese campo). Cualquier otra cosa se
        rechaza al guardar -- este portal no ejecuta este texto, solo lo guarda para que el SSIS lo use.
    </p>

    <partial name="_MensajesSellOut" model="Model" />

    @if (!Model.PuedeVer)
    {
        <p class="admin-muted">No tenés permiso para ver esta pantalla.</p>
    }
    else
    {
        @if (Model.PuedeCrear || Model.PuedeEditar)
        {
            <div class="doc-tab-seccion sellout-panel-edicion">
                <h3>@(Model.Editando is null ? "Nueva configuración" : $"Editar configuración · {Model.Input.Cliente} / {Model.Input.TipoArchivo}")</h3>

                <form asp-page="./Index" asp-page-handler="Guardar" method="post">
                    <input type="hidden" name="FiltroIdCliente" value="@Model.FiltroIdCliente" />
                    <input type="hidden" name="FiltroTexto" value="@Model.FiltroTexto" />
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="sellout-grid">
                        <div class="form-group">
                            <label asp-for="Input.IdCliente">Cliente</label>
                            @if (Model.Editando is null)
                            {
                                <select id="select-cliente-layout" asp-for="Input.IdCliente" asp-items="Model.ClientesDisponibles" class="form-control">
                                    <option value="">Seleccionar...</option>
                                </select>
                            }
                            else
                            {
                                <input type="hidden" asp-for="Input.IdCliente" />
                                <input class="form-control" value="@Model.Input.Cliente" readonly />
                            }
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.TipoArchivo">Tipo de archivo</label>
                            @if (Model.Editando is null)
                            {
                                <select asp-for="Input.TipoArchivo" class="form-control">
                                    <option value="">Seleccionar...</option>
                                    @foreach (var tipo in Model.TiposArchivo)
                                    {
                                        <option value="@tipo">@tipo</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="hidden" asp-for="Input.TipoArchivo" />
                                <input class="form-control" value="@Model.Input.TipoArchivo" readonly />
                            }
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.Cliente">Nombre cliente (texto libre)</label>
                            <input id="input-nombre-cliente-layout" asp-for="Input.Cliente" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.FilePattern">Patrón de archivo</label>
                            <input asp-for="Input.FilePattern" class="form-control" placeholder="ej. Falabella*ecat*" />
                        </div>
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <label style="text-transform:none;font-weight:500;"><input asp-for="Input.Activo" type="checkbox" /> Activo</label>
                        </div>
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <label style="text-transform:none;font-weight:500;"><input asp-for="Input.CalcSkuBarcode" type="checkbox" /> Calcular barcode desde SKU</label>
                        </div>
                    </div>

                    <h4 style="margin:14px 0 6px;font-size:12.5px;">Identificación</h4>
                    <div class="sellout-grid">
                        <div class="form-group"><label asp-for="Input.MapFecha">Fecha</label><input asp-for="Input.MapFecha" class="form-control" /></div>
                        <div class="form-group"><label asp-for="Input.MapSku">SKU</label><input asp-for="Input.MapSku" class="form-control" /></div>
                        <div class="form-group"><label asp-for="Input.MapBarcode">Barcode</label><input asp-for="Input.MapBarcode" class="form-control" /></div>
                        <div class="form-group"><label asp-for="Input.MapDescripcionCliente">Descripción</label><input asp-for="Input.MapDescripcionCliente" class="form-control" /></div>
                        <div class="form-group"><label asp-for="Input.MapDepartamento">Departamento</label><input asp-for="Input.MapDepartamento" class="form-control" /></div>
                        <div class="form-group"><label asp-for="Input.MapIdSucursal">ID sucursal</label><input asp-for="Input.MapIdSucursal" class="form-control" /></div>
                        <div class="form-group"><label asp-for="Input.MapSucursal">Sucursal</label><input asp-for="Input.MapSucursal" class="form-control" /></div>
                        <div class="form-group"><label asp-for="Input.MapDefinicion1">Definición 1</label><input asp-for="Input.MapDefinicion1" class="form-control" /></div>
                        <div class="form-group"><label asp-for="Input.MapDefinicion2">Definición 2</label><input asp-for="Input.MapDefinicion2" class="form-control" /></div>
                    </div>

                    <h4 style="margin:14px 0 6px;font-size:12.5px;">Precios</h4>
                    <div class="sellout-grid">
                        <div class="form-group"><label asp-for="Input.MapPrcCostoUnit">Costo unitario</label><input asp-for="Input.MapPrcCostoUnit" class="form-control" /></div>
                        <div class="form-group"><label asp-for="Input.MapPrcVtaUnit">Venta unitaria</label><input asp-for="Input.MapPrcVtaUnit" class="form-control" /></div>
                        <div class="form-group"><label asp-for="Input.MapPrcVtaFull">Venta full</label><input asp-for="Input.MapPrcVtaFull" class="form-control" /></div>
                    </div>

                    <h4 style="margin:14px 0 6px;font-size:12.5px;">Venta</h4>
                    <div class="sellout-grid">
                        <div class="form-group"><label asp-for="Input.MapVtaUN">Unidades</label><input asp-for="Input.MapVtaUN" class="form-control" /></div>
                        <div class="form-group"><label asp-for="Input.MapVtaNeta">Venta neta</label><input asp-for="Input.MapVtaNeta" class="form-control" /></div>
                        <div class="form-group"><label asp-for="Input.MapVtaBruta">Venta bruta</label><input asp-for="Input.MapVtaBruta" class="form-control" /></div>
                        <div class="form-group"><label asp-for="Input.MapVtaBrutaFull">Venta bruta full</label><input asp-for="Input.MapVtaBrutaFull" class="form-control" /></div>
                        <div class="form-group"><label asp-for="Input.MapVtaCosto">Costo de venta</label><input asp-for="Input.MapVtaCosto" class="form-control" /></div>
                    </div>

                    <h4 style="margin:14px 0 6px;font-size:12.5px;">Stock</h4>
                    <div class="sellout-grid">
                        <div class="form-group"><label asp-for="Input.MapStkUN">Unidades</label><input asp-for="Input.MapStkUN" class="form-control" /></div>
                        <div class="form-group"><label asp-for="Input.MapStkVtaNeta">Venta neta</label><input asp-for="Input.MapStkVtaNeta" class="form-control" /></div>
                        <div class="form-group"><label asp-for="Input.MapStkVtaBruta">Venta bruta</label><input asp-for="Input.MapStkVtaBruta" class="form-control" /></div>
                        <div class="form-group"><label asp-for="Input.MapStkCosto">Costo</label><input asp-for="Input.MapStkCosto" class="form-control" /></div>
                    </div>

                    <button type="submit" class="btn-erp-primary">@(Model.Editando is null ? "Crear" : "Guardar")</button>
                    @if (Model.Editando is not null)
                    {
                        <a href="~/sellout/layouts?filtroIdCliente=@Model.FiltroIdCliente&filtroTexto=@Model.FiltroTexto" class="btn-module-action">Cancelar</a>
                    }
                </form>
            </div>
        }

        <form method="get" class="doc-list-filtros">
            <div class="form-group">
                <label for="filtro-cliente">Cliente</label>
                <select id="filtro-cliente" name="FiltroIdCliente" class="form-control" onchange="this.form.submit()" asp-items="Model.ClientesDisponibles">
                    <option value="">Todos los clientes</option>
                </select>
            </div>
            <div class="form-group doc-list-busqueda">
                <label for="filtro-texto">Buscar</label>
                <input id="filtro-texto" name="FiltroTexto" class="form-control" value="@Model.FiltroTexto" placeholder="Tipo, patrón o cliente..." />
            </div>
            <div class="form-group doc-list-filtros-acciones">
                <button type="submit" class="btn-module-action">Buscar</button>
                <a href="~/sellout/layouts" class="btn-module-action">Limpiar</a>
            </div>
        </form>

        <table class="admin-table">
            <thead><tr><th>Cliente</th><th>Tipo archivo</th><th>File pattern</th><th>Activo</th><th class="admin-col-accion"></th></tr></thead>
            <tbody>
                @foreach (var l in Model.Layouts)
                {
                    <tr class="@((l.Activo ?? true) ? "" : "admin-fila-inactiva")">
                        <td>@l.NomCliente</td>
                        <td>@l.TipoArchivo</td>
                        <td>@l.FilePattern</td>
                        <td>@((l.Activo ?? true) ? "Sí" : "No")</td>
                        <td class="admin-col-accion">
                            <div class="admin-row-actions">
                                @if (Model.PuedeEditar)
                                {
                                    <a href="~/sellout/layouts?editandoCliente=@l.IdCliente&editandoTipo=@l.TipoArchivo&filtroIdCliente=@Model.FiltroIdCliente&filtroTexto=@Model.FiltroTexto" class="btn-module-action">Editar</a>
                                }
                                @if (Model.PuedeEliminar)
                                {
                                    <form asp-page="./Index" asp-page-handler="Eliminar" asp-route-idCliente="@l.IdCliente" asp-route-tipoArchivo="@l.TipoArchivo" method="post" style="display:inline-block;"
                                          onsubmit="return confirm('¿Eliminar la configuración de &quot;@l.NomCliente&quot; / &quot;@l.TipoArchivo&quot;?');">
                                        <button type="submit" class="btn-module-action btn-module-danger">Eliminar</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <script>
        // Comodidad de UI, no autoritativo -- precarga el texto libre "Cliente" con el
        // nombre real al elegir del select, el usuario lo puede pisar despues.
        (function () {
            var select = document.getElementById('select-cliente-layout');
            var nombre = document.getElementById('input-nombre-cliente-layout');
            if (!select || !nombre) { return; }
            select.addEventListener('change', function () {
                if (!nombre.value) {
                    var texto = select.options[select.selectedIndex]?.text;
                    if (texto && texto !== 'Seleccionar...') { nombre.value = texto; }
                }
            });
        })();
    </script>
}
