<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Proyecto de solo herramientas: nunca se referencia desde el plugin en
         runtime. dotnet ef necesita un ModelSnapshot único por ensamblado, dos
         proveedores en el mismo ensamblado generan snapshots ambiguos, mismo motivo
         que Modulo.Rendiciones.Migrations.Postgres / Modulo.Wms.Migrations.Postgres. -->
    <ProjectReference Include="..\Modulo.AuditoriaInventario\Modulo.AuditoriaInventario.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
