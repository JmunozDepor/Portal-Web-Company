@page "/sellout/geografias"
@model Modulo.SellOut.Pages.Geografias.IndexModel
@{
    ViewData["Title"] = "Geografías";
    var puedeAbrirFormulario = Model.PuedeVer && (Model.PuedeCrear || Model.PuedeEditar);
    var formularioAbierto = Model.EditandoId is not null || !ViewData.ModelState.IsValid;
}

<div class="card-surface">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
        <h2 class="mb-0">Geografías</h2>
        @if (Model.PuedeVer && Model.PuedeCrear)
        {
            <button type="button" class="btn-primary" data-drawer-open="drawer-geografia">+ Nueva geografía</button>
        }
    </div>

    <partial name="_MensajesSellOut" model="Model" />

    @if (!Model.PuedeVer)
    {
        <p class="text-muted">No tenés permiso para ver esta pantalla.</p>
    }
    else
    {
        <form method="get" class="d-flex align-items-end gap-3 flex-wrap mb-3">
            <div class="mb-0 flex-grow-1" style="max-width:320px;">
                <label for="filtro-texto" class="form-label">Buscar</label>
                <input id="filtro-texto" name="FiltroTexto" class="form-control" value="@Model.FiltroTexto" placeholder="Región, región corto o país..." />
            </div>
            <button type="submit" class="btn-secondary">Buscar</button>
            <a href="~/sellout/geografias" class="btn-ghost">Limpiar</a>
        </form>

        <table class="table-ps">
            <thead><tr><th>ID</th><th>Región</th><th>Región corto</th><th>Grupo región</th><th>País</th><th>Código postal</th><th class="col-actions"></th></tr></thead>
            <tbody>
                @foreach (var g in Model.Geografias)
                {
                    <tr>
                        <td>@g.IDGeografia</td>
                        <td>@g.Region</td>
                        <td>@g.RegionCorto</td>
                        <td>@g.GrupoRegion</td>
                        <td>@g.Pais (@g.CodigoPais)</td>
                        <td>@g.CodigoPostal</td>
                        <td class="col-actions">
                            @if (Model.PuedeEditar)
                            {
                                <a href="~/sellout/geografias?editando=@g.IDGeografia&filtroTexto=@Model.FiltroTexto" class="btn-ghost" title="Editar"><i class="bi bi-pencil"></i></a>
                            }
                            @if (Model.PuedeEliminar)
                            {
                                <form asp-page="./Index" asp-page-handler="Eliminar" asp-route-id="@g.IDGeografia" method="post" class="d-inline-block"
                                      onsubmit="return confirm('¿Eliminar la geografía &quot;@g.Region&quot;?');">
                                    <button type="submit" class="btn-ghost btn-ghost--danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Geografias.Count == 0)
                {
                    <tr><td colspan="7" class="text-muted">Sin geografías todavía.</td></tr>
                }
            </tbody>
        </table>
    }

    @if (puedeAbrirFormulario)
    {
        <div id="drawer-geografia" class="drawer-overlay @(formularioAbierto ? "is-open" : "")" data-drawer>
            <aside class="drawer-panel @(formularioAbierto ? "is-open" : "")">
                <div class="drawer-header">
                    <h3>@(Model.EditandoId is null ? "Nueva geografía" : $"Editar geografía · {Model.Input.Region}")</h3>
                    <button type="button" class="btn-ghost" data-drawer-close aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>
                <form asp-page="./Index" asp-page-handler="Guardar" asp-route-editando="@Model.EditandoId" method="post">
                    <input type="hidden" name="FiltroTexto" value="@Model.FiltroTexto" />
                    <div class="drawer-body">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>
                        <div class="drawer-grid">
                            <div class="mb-3">
                                <label asp-for="Input.IDGeografia" class="form-label">ID</label>
                                <input asp-for="Input.IDGeografia" type="number" class="form-control" readonly="@(Model.EditandoId is not null)" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.Region" class="form-label">Región</label>
                                <input asp-for="Input.Region" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.RegionCorto" class="form-label">Región corto</label>
                                <input asp-for="Input.RegionCorto" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.GrupoRegion" class="form-label">Grupo región</label>
                                <input asp-for="Input.GrupoRegion" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.CodigoPais" class="form-label">Código país</label>
                                <input asp-for="Input.CodigoPais" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.Pais" class="form-label">País</label>
                                <input asp-for="Input.Pais" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.CodigoPostal" class="form-label">Código postal</label>
                                <input asp-for="Input.CodigoPostal" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="drawer-footer">
                        <button type="button" class="btn-secondary" data-drawer-close>Cancelar</button>
                        <button type="submit" class="btn-primary">@(Model.EditandoId is null ? "Crear" : "Guardar")</button>
                    </div>
                </form>
            </aside>
        </div>
    }
</div>
