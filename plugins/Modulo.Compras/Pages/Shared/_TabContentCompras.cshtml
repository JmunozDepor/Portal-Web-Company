@model Modulo.Compras.Pages.DetailGenericPurchaseDocumentModelBase
@{
    var readOnly = Model.Document.ReadOnly;
    // Al crear, se muestran las líneas ya cargadas (normalmente 1 en blanco) más un
    // puñado de filas vacías extra para no necesitar un botón "Agregar línea" con JS
    // -- las filas sin ItemCode se descartan solas en el POST (ver
    // DetailGenericPurchaseDocumentModelBase.OnPostAsync).
    var rowCount = readOnly ? Model.Input.Lines.Count : Math.Max(Model.Input.Lines.Count, 1) + 9;
}

<table class="table table-sm" id="purchase-document-lines">
    <thead>
        <tr>
            <th>Artículo</th>
            <th>Descripción</th>
            <th>Cantidad</th>
            <th>Precio unitario</th>
            <th>% Desc.</th>
            <th>Almacén</th>
        </tr>
    </thead>
    <tbody>
        @for (var i = 0; i < rowCount; i++)
        {
            var line = i < Model.Input.Lines.Count ? Model.Input.Lines[i] : new Modulo.Compras.Pages.DetailGenericPurchaseDocumentModelBase.LineInput();
            <tr>
                <td>
                    <input name="Input.Lines[@i].ItemCode" value="@line.ItemCode" class="form-control form-control-sm purchase-document-item-code" list="purchase-document-items-datalist" disabled="@readOnly" />
                </td>
                <td>
                    <input name="Input.Lines[@i].Description" value="@line.Description" class="form-control form-control-sm" disabled="@readOnly" />
                </td>
                <td style="max-width:100px">
                    <input name="Input.Lines[@i].Quantity" type="number" step="0.01" value="@(line.Quantity == 0 ? "" : line.Quantity.ToString())" class="form-control form-control-sm" disabled="@readOnly" />
                </td>
                <td style="max-width:120px">
                    <input name="Input.Lines[@i].UnitPrice" type="number" step="0.01" value="@line.UnitPrice" class="form-control form-control-sm" placeholder="Lista de precio" disabled="@readOnly" />
                </td>
                <td style="max-width:90px">
                    <input name="Input.Lines[@i].DiscountPercent" type="number" step="0.01" value="@(line.DiscountPercent == 0 ? "" : line.DiscountPercent.ToString())" class="form-control form-control-sm" disabled="@readOnly" />
                </td>
                <td>
                    <select name="Input.Lines[@i].WarehouseCode" class="form-select form-select-sm" disabled="@readOnly">
                        <option value="">Seleccionar…</option>
                        @foreach (var warehouse in Model.Warehouses)
                        {
                            <option value="@warehouse.Value" selected="@(warehouse.Value == line.WarehouseCode)">@warehouse.Text</option>
                        }
                    </select>
                </td>
            </tr>
        }
    </tbody>
</table>

<datalist id="purchase-document-items-datalist"></datalist>

@if (!readOnly)
{
    <script src="~/js/catalog-search.js"></script>
    <script>
        wireCatalogSearch({
            inputSelector: '.purchase-document-item-code',
            datalistId: 'purchase-document-items-datalist',
            handlerName: 'SearchItems',
            getValue: function (item) { return item.itemCode; },
            getLabel: function (item) { return item.itemCode + ' — ' + item.itemName; },
        });
    </script>
}
