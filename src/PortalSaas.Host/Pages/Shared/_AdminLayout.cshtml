@{
    // Detección de sección activa -- el navbar nunca marcó cuál de los 7 links
    // corresponde a la página actual (bug de UX real, no solo estético: en un ERP el
    // usuario espera saber siempre "dónde estoy"). Comparación por prefijo de ruta
    // (no por nombre de página exacto) para que también funcione dentro de subpáginas
    // (ej. /Admin/Organizations/Users/Index sigue marcando "Organizaciones" activo).
    var currentPath = Context.Request.Path.Value ?? "";
    bool IsActiveSection(string prefix) => currentPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);

    var adminName = User.Identity?.Name ?? "";
    var adminInitials = string.Concat(
        adminName.Split(new[] { '@', '.', ' ' }, StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])));
    if (string.IsNullOrEmpty(adminInitials))
    {
        adminInitials = "A";
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Portal SaaS · Administración</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark admin-navbar">
            <div class="container">
                <a class="navbar-brand admin-brand" asp-page="/Admin/Organizations/Index">
                    <span class="admin-brand-product">Portal SaaS</span>
                    <span class="admin-brand-divider" aria-hidden="true"></span>
                    <span class="admin-brand-area">Administración</span>
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1 admin-nav">
                            <li class="nav-item"><a class="nav-link @(IsActiveSection("/Admin/Organizations") ? "active" : "")" asp-page="/Admin/Organizations/Index">Organizaciones</a></li>
                            <li class="nav-item"><a class="nav-link @(IsActiveSection("/Admin/Plans") ? "active" : "")" asp-page="/Admin/Plans/Index">Planes</a></li>
                            <li class="nav-item"><a class="nav-link @(IsActiveSection("/Admin/Profiles") ? "active" : "")" asp-page="/Admin/Profiles/Index">Perfiles</a></li>
                            <li class="nav-item"><a class="nav-link @(IsActiveSection("/Admin/MenuGroups") ? "active" : "")" asp-page="/Admin/MenuGroups/Index">Grupos de menú</a></li>
                            <li class="nav-item"><a class="nav-link @(IsActiveSection("/Admin/PlatformModules") ? "active" : "")" asp-page="/Admin/PlatformModules/Index">Módulos</a></li>
                            <li class="nav-item"><a class="nav-link @(IsActiveSection("/Admin/Sessions") ? "active" : "")" asp-page="/Admin/Sessions/Index">Clientes conectados</a></li>
                            <li class="nav-item"><a class="nav-link @(IsActiveSection("/Admin/Integraciones") ? "active" : "")" asp-page="/Admin/Integraciones/Index">Integraciones</a></li>
                            <li class="nav-item"><a class="nav-link @(IsActiveSection("/Admin/Sistema") ? "active" : "")" asp-page="/Admin/Sistema/Index">Sistema</a></li>
                        </ul>
                        <ul class="navbar-nav admin-user-cluster align-items-sm-center">
                            <li class="nav-item d-flex align-items-center gap-2">
                                <span class="admin-user-avatar">@adminInitials</span>
                                <span class="admin-user-name">@adminName</span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Admin/Logout">
                                    <button type="submit" class="btn admin-logout-btn">Cerrar sesión</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
