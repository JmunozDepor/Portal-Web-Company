@page "/rendiciones/informes"
@model Modulo.Rendiciones.Pages.Informes.IndexModel
@using Modulo.Rendiciones.Pages
@{
    ViewData["Title"] = "Informes";
}
@section Styles {
    <link rel="stylesheet" href="~/css/rendiciones.css" asp-append-version="true" />
}

<div class="rnd-header">
    <h2><i class="bi bi-file-earmark-spreadsheet"></i> Informes</h2>
</div>

@if (Model.SuccessMessage is not null)
{
    <div class="admin-alert admin-alert-success">@Model.SuccessMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="admin-alert admin-alert-danger">@Model.ErrorMessage</div>
}

@if (Model.Reports.Count == 0)
{
    <div class="rnd-card-empty">
        <i class="bi bi-file-earmark-spreadsheet"></i>
        Todavía no tenés informes creados.
    </div>
}
else
{
    <div class="rnd-card-list mb-4">
        @foreach (var r in Model.Reports)
        {
            <a asp-page="./Detalle" asp-route-id="@r.Id" class="rnd-card-row">
                <div class="rnd-card-icon"><i class="bi bi-folder2-open"></i></div>
                <div class="rnd-card-main">
                    <div class="rnd-card-title">
                        Informe #@r.Id
                        @if (!string.IsNullOrWhiteSpace(r.InternalNumber)) { <text>· N.º @r.InternalNumber</text> }
                        @(r.Round > 1 ? $"· ronda {r.Round}" : "")
                    </div>
                    <div class="rnd-card-sub">
                        @(!string.IsNullOrWhiteSpace(r.Purpose) ? r.Purpose + " · " : "")@r.CreatedAt.ToString("dd-MM-yyyy") · @(r.CostCenterName ?? r.CostCenterCode ?? "sin centro de costo") · @r.Lines.Count gasto(s)
                    </div>
                </div>
                <div class="rnd-card-meta">
                    <span class="rnd-badge @RendicionesUi.BadgeClass(r.Status)">@r.Status</span>
                    <span class="rnd-card-amount"><rnd-amount value="@r.Lines.Sum(d => d.Amount)" /></span>
                </div>
            </a>
        }
    </div>
}

<div class="admin-subcard">
    <h3>Nuevo informe</h3>
    <p class="admin-muted">Elegí los gastos sueltos que querés agrupar y enviar a aprobación.</p>

    <form method="post" asp-page-handler="Crear">
        @if (Model.LooseExpenses.Count == 0)
        {
            <p class="admin-muted">No tenés gastos sueltos todavía -- registrá alguno en "Mis Gastos" primero.</p>
        }
        else
        {
            @* Mismas columnas que Pages/Gastos/Index ("Mis Gastos") -- pedido explícito de que un
               gasto se vea con la misma información en los dos lugares, en vez del resumen resumido
               que tenía antes (solo fecha + categoría). *@
            <div class="rnd-table-wrapper mb-3">
                <table class="table-ps">
                    <thead>
                        <tr>
                            <th class="rnd-col-check"></th>
                            <th>Proveedor / Fecha</th>
                            <th>Política</th>
                            <th>Categoría</th>
                            <th>Glosa</th>
                            <th class="rnd-col-total">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in Model.LooseExpenses)
                        {
                            var detalleUrl = Url.Page("/Gastos/Detalle", new { id = g.Id });
                            <tr>
                                <td class="rnd-col-check"><input type="checkbox" name="SelectedExpenseIds" value="@g.Id" /></td>
                                <td>
                                    <a href="@detalleUrl" class="rnd-row-link" title="Ver / editar este gasto">
                                        <span class="rnd-card-icon"><i class="bi @RendicionesUi.CategoryIcon(g.ExpenseType?.Name)"></i></span>
                                        <span class="rnd-row-text">
                                            <span class="rnd-card-title">@(g.SupplierName ?? g.ExpenseType?.Name ?? "Gasto")</span>
                                            <span class="rnd-card-sub">
                                                @g.Date.ToString("dd-MM-yyyy")
                                                @if (g.ExpenseReceiptId is not null)
                                                {
                                                    <i class="bi bi-paperclip" title="Tiene comprobante"></i>
                                                }
                                                @if (g.ExpenseTypeId is null)
                                                {
                                                    <span class="text-danger"> · Falta categoría</span>
                                                }
                                            </span>
                                        </span>
                                    </a>
                                </td>
                                <td class="rnd-col-muted">@Model.PolicyLabel(g)</td>
                                <td class="rnd-col-muted">@(g.ExpenseType?.Name ?? "—")</td>
                                <td class="rnd-col-muted">@(string.IsNullOrWhiteSpace(g.Notes) ? "—" : g.Notes)</td>
                                <td class="rnd-col-total rnd-card-amount"><rnd-amount value="@g.Amount" currency="@g.Currency" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="form-group">
                <label asp-for="CostCenterCode">Centro de costo</label>
                <select asp-for="CostCenterCode" class="form-control">
                    <option value="">-- Sin especificar --</option>
                    @foreach (var c in Model.CostCenters)
                    {
                        <option value="@c.Code">@c.Code - @c.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="ExpenseFundId">Fondo por rendir asociado</label>
                <select asp-for="ExpenseFundId" class="form-control">
                    <option value="">-- Sin fondo (reembolso directo) --</option>
                    @foreach (var f in Model.OpenFunds)
                    {
                        <option value="@f.Id">@f.Currency <rnd-amount value="@f.Amount" /> - @f.DeliveredAt.ToString("dd-MM-yyyy")</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn-erp-primary">Crear informe</button>
        }
    </form>
</div>
