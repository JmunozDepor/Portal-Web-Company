@model PortalSaas.Host.ViewComponents.CompanySwitcherViewModel
@if (Model.Companies.Count == 1)
{
    @* Una sola compañía accesible -- no hay nada para cambiar, pero igual se muestra
       cuál es (antes acá no se renderizaba nada y el wrapper .sidebar-company quedaba
       solo con el ícono de edificio). *@
    <span class="company-switcher-single" title="Compañía activa">@Model.Companies[0].Text</span>
}
else if (Model.Companies.Count > 1)
{
    @* asp-page dispara la inyección automática del antiforgery token (FormTagHelper) --
       igual criterio que SelectCompany.cshtml, ver su comentario histórico. El submit es
       automático al elegir (onchange), no hace falta botón "Continuar" acá: es un
       cambio rápido desde cualquier página, no un paso de login. *@
    <form method="post" asp-page="/Account/SwitchCompany" class="company-switcher">
        @* Request.PathBase + Request.Path, no Request.Path solo -- hosteado como
           subaplicación de IIS (ej. /portalsaas-comercialdepor), Request.Path YA viene
           sin ese prefijo; omitirlo genera un returnUrl que cae fuera de la app (404
           real de IIS al cambiar de compañía). Mismo criterio ya aplicado en
           DetailUrl/CreateUrl/BackUrl de los 3 motores genéricos de documento. *@
        <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" />
        <label for="company-switcher-select" class="company-switcher-label">Compañía</label>
        @* activeValue = el Value EXACTO (mismo string que va en <option value>) de la
           compañía activa -- se compara con OrdinalIgnoreCase por el problema histórico
           de casing del GUID (ver comentario abajo). onCompanySwitchChange lo usa para
           revertir el <select> si el usuario cancela el aviso de confirmación. *@
        @{
            var activeValue = Model.Companies
                .FirstOrDefault(i => string.Equals(i.Value, Model.CurrentCompanyId, StringComparison.OrdinalIgnoreCase))
                ?.Value;
        }
        @* <option> armadas a mano, NO asp-items -- más transparente que confiar en cómo
           el SelectTagHelper infiere "selected" sin asp-for.
           Bug real (2026-08-08): la comparación de acá era "==" (ordinal case-sensitive)
           entre item.Value (CompanySwitcherViewComponent arma la lista con
           c.Id.ToString(), que EF Core traduce a CONVERT(varchar(36), [c].[id]) DEL LADO
           DE SQL SERVER -- eso devuelve el GUID en MAYÚSCULAS) y Model.CurrentCompanyId
           (el claim CompanyId, armado en C# con company.Id.ToString() en
           CompanySessionActivator -- eso devuelve minúsculas). Ningún item empataba
           nunca -> ningún <option> quedaba "selected" -> el navegador mostraba la
           primera opción de la lista por default (comportamiento nativo del <select>
           sin ninguna opción marcada), no la compañía real de la sesión (que sí estaba
           bien resuelta -- el subtítulo "Portal SaaS / CÓDIGO", que compara distinto,
           mostraba el valor correcto). OrdinalIgnoreCase evita depender de que las dos
           fuentes generen el mismo casing. *@
        <select id="company-switcher-select" name="companyId" class="form-select form-select-sm"
                data-current="@activeValue" onchange="onCompanySwitchChange(this)">
            @foreach (var item in Model.Companies)
            {
                if (string.Equals(item.Value, Model.CurrentCompanyId, StringComparison.OrdinalIgnoreCase))
                {
                    <option value="@item.Value" selected="selected">✓ @item.Text</option>
                }
                else
                {
                    <option value="@item.Value">@item.Text</option>
                }
            }
        </select>
    </form>
    @* Aviso antes de cambiar de compañía: el cambio recarga la sesión de trabajo
       (nueva compañía activa en todos los claims), así que se confirma primero. Si el
       usuario cancela, el <select> vuelve a la compañía actual (data-current) y no se
       envía nada. El prefijo "✓ " de la opción activa se saca del texto para el aviso. *@
    <script>
        function onCompanySwitchChange(sel) {
            var label = (sel.options[sel.selectedIndex].text || '').replace(/^✓\s*/, '');
            if (window.confirm('¿Cambiar la compañía activa a «' + label + '»?\nSe recargará tu sesión de trabajo.')) {
                sel.form.submit();
            } else {
                sel.value = sel.getAttribute('data-current');
            }
        }
    </script>
}
