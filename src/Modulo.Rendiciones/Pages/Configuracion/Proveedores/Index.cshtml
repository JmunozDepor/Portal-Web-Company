@page "/rendiciones/configuracion/proveedores"
@model Modulo.Rendiciones.Pages.Configuracion.Proveedores.IndexModel
@{
    ViewData["Title"] = "Proveedores de servicios externos";
}
@section Styles {
    <link rel="stylesheet" href="~/css/rendiciones.css" asp-append-version="true" />
}

<div class="card-ps admin-card">
    <div class="admin-card-header">
        <h2>Proveedores de servicios externos</h2>
        <a asp-page="/Configuracion/ConsumoServicios/Index" class="btn-module-action">Ver consumo</a>
    </div>

@if (Model.SuccessMessage is not null)
{
    <div class="admin-alert admin-alert-success">@Model.SuccessMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="admin-alert admin-alert-danger">@Model.ErrorMessage</div>
}

<p class="admin-muted">
    Cada tipo de servicio (Azure Maps, Azure Document Intelligence) puede tener más de
    una cuenta configurada -- cuando la de mayor prioridad (número más bajo) agota su
    cuota mensual gratuita, el sistema prueba automáticamente la siguiente antes de
    dar el servicio por no disponible. La clave se guarda cifrada y nunca se vuelve a
    mostrar -- dejar el campo en blanco al editar no la cambia.
</p>

<table class="admin-table">
    <thead>
        <tr>
            <th>Servicio</th>
            <th>Nombre</th>
            <th>Endpoint</th>
            <th>Clave</th>
            <th>Límite mensual</th>
            <th>Prioridad</th>
            <th>Activo</th>
            <th class="admin-col-accion"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Providers)
        {
            var formId = $"prov-{p.Id}";
            <tr class="@(p.IsActive ? "" : "admin-fila-inactiva")">
                <td>@p.ServiceType</td>
                <td><input type="text" name="nombre" value="@p.Name" class="form-control" form="@formId" /></td>
                <td><input type="text" name="endpoint" value="@p.Endpoint" class="form-control" placeholder="Solo Document Intelligence" form="@formId" /></td>
                <td><input type="password" name="apiKey" class="form-control" placeholder="Dejar en blanco para no cambiar" form="@formId" autocomplete="new-password" /></td>
                <td><input type="number" name="monthlyLimit" value="@p.MonthlyLimit" class="form-control" form="@formId" /></td>
                <td><input type="number" name="priority" value="@p.Priority" class="form-control" form="@formId" /></td>
                <td><input type="checkbox" name="activo" value="true" checked="@p.IsActive" form="@formId" /></td>
                <td class="admin-col-accion">
                    <div class="admin-row-actions">
                        <button type="submit" class="btn-module-action" form="@formId">Guardar</button>
                        <form asp-page="./Index" asp-page-handler="Eliminar" asp-route-id="@p.Id" method="post" style="display:inline-block;"
                              onsubmit="return confirm('¿Eliminar este proveedor?');">
                            <button type="submit" class="btn-module-action btn-module-danger">Eliminar</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        @if (Model.Providers.Count == 0)
        {
            <tr><td colspan="8" class="admin-muted">Sin proveedores configurados todavía.</td></tr>
        }
    </tbody>
</table>

@* Un <form> no puede abrirse en una <td> y cerrarse en otra, ni ser hijo directo de
   <tr> -- viven acá afuera, vacíos, asociados por form="prov-{id}". *@
@foreach (var p in Model.Providers)
{
    <form id="prov-@p.Id" asp-page="./Index" asp-page-handler="Guardar" asp-route-id="@p.Id"></form>
}

<span class="admin-subtitulo">Nuevo proveedor</span>
<form method="post" asp-page-handler="Crear" class="admin-form-asignar">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="New.ServiceType">Servicio</label>
        <select asp-for="New.ServiceType" class="form-control">
            <option value="">-- Seleccionar --</option>
            @foreach (var s in Model.ServiceTypes)
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label asp-for="New.Name">Nombre</label>
        <input asp-for="New.Name" class="form-control" placeholder="Ej. Azure Maps - Cuenta 1" />
    </div>
    <div class="form-group">
        <label asp-for="New.Endpoint">Endpoint</label>
        <input asp-for="New.Endpoint" class="form-control" placeholder="Solo Document Intelligence" />
    </div>
    <div class="form-group">
        <label asp-for="New.ApiKey">Clave</label>
        <input asp-for="New.ApiKey" type="password" class="form-control" autocomplete="new-password" />
    </div>
    <div class="form-group">
        <label asp-for="New.MonthlyLimit">Límite mensual</label>
        <input asp-for="New.MonthlyLimit" class="form-control" placeholder="Ej. 250000" />
    </div>
    <div class="form-group">
        <label asp-for="New.Priority">Prioridad</label>
        <input asp-for="New.Priority" class="form-control" placeholder="0 = primero" />
    </div>
    <button type="submit" class="btn-erp-primary btn-erp-primary--sm">Crear</button>
</form>
</div>
