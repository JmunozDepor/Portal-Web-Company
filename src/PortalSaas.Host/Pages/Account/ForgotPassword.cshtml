@page
@model PortalSaas.Host.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-3">Recuperar contraseña</h1>

        @if (Model.RequestSubmitted)
        {
            <div class="alert alert-info">
                Si la organización y el correo existen, te enviamos un link para elegir una contraseña nueva.
            </div>
            <a asp-page="/Account/Login">Volver a iniciar sesión</a>
        }
        else
        {
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Input.OrganizationSlug" class="form-label"></label>
                    <input asp-for="Input.OrganizationSlug" class="form-control" autofocus />
                    <span asp-validation-for="Input.OrganizationSlug" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Enviar link de recuperación</button>
            </form>
        }
    </div>
</div>
