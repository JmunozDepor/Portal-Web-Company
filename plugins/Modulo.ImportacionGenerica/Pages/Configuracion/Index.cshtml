@page "/importacion-generica/configuracion"
@model Modulo.ImportacionGenerica.Pages.Configuracion.IndexModel
@{
    ViewData["Title"] = "Configuración de Importación Genérica";
}

<h1 class="h3 mb-3">Configuración de Importación Genérica</h1>
<p class="text-muted">
    Una configuración sin Socio de negocio es el formato ESTÁNDAR de la organización para ese
    Módulo+Tipo de documento+Tipo de línea. Una configuración con Socio de negocio es la
    excepción de un cliente/proveedor puntual cuyo archivo no sigue el estándar.
</p>

@if (Model.SuccessMessage is not null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="card-ps doc-tab-seccion mb-4">
    <span class="doc-resumen-total-titulo">@(Model.EditId is null ? "Nueva configuración" : "Editar configuración")</span>
    <form method="post" asp-page-handler="Save" asp-route-editId="@Model.EditId" asp-antiforgery="true">
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Input.Module" class="form-label"></label>
                <select asp-for="Input.Module" asp-items="Model.Modules" class="form-select" disabled="@(Model.EditId is not null)"></select>
            </div>
            <div class="form-group">
                <label asp-for="Input.DocumentType" class="form-label"></label>
                <input asp-for="Input.DocumentType" class="form-control" placeholder="ej. SalesOrder, PurchaseQuotation, StockTransfer" disabled="@(Model.EditId is not null)" />
                <span asp-validation-for="Input.DocumentType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.LineType" class="form-label"></label>
                <select asp-for="Input.LineType" asp-items="Model.LineTypes" class="form-select" disabled="@(Model.EditId is not null)"></select>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Input.Alias" class="form-label"></label>
                <input asp-for="Input.Alias" class="form-control" />
                <span asp-validation-for="Input.Alias" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.BusinessPartnerCardCode" class="form-label"></label>
                @if (Model.EditId is not null)
                {
                    <input asp-for="Input.BusinessPartnerCardCode" class="form-control" disabled />
                }
                else
                {
                    <input asp-for="Input.BusinessPartnerCardCode" class="form-control import-config-business-partner-code" list="import-config-business-partners-datalist" autocomplete="off" />
                    <datalist id="import-config-business-partners-datalist"></datalist>
                }
            </div>
            <div class="form-group">
                <label asp-for="Input.GroupingColumn" class="form-label"></label>
                <input asp-for="Input.GroupingColumn" class="form-control" placeholder="ej. A" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group form-check">
                <input asp-for="Input.SkuIsCustomerOwn" class="form-check-input" />
                <label asp-for="Input.SkuIsCustomerOwn" class="form-check-label"></label>
            </div>
            @if (Model.EditId is not null)
            {
                <div class="form-group form-check">
                    <input asp-for="Input.IsActive" class="form-check-input" />
                    <label asp-for="Input.IsActive" class="form-check-label"></label>
                </div>
            }
        </div>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Input.PriceSource" class="form-label"></label>
                <select asp-for="Input.PriceSource" asp-items="Model.PriceSources" class="form-select"></select>
            </div>
            <div class="form-group">
                <label asp-for="Input.SystemPriceListCode" class="form-label"></label>
                <input asp-for="Input.SystemPriceListCode" type="number" class="form-control" />
            </div>
        </div>

        <h5 class="mt-4">Campos núcleo</h5>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Campo</th>
                    <th>Columna Excel</th>
                    <th>Obligatorio</th>
                    <th>Valor fijo</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Input.Fields.Count; i++)
                {
                    var field = Model.Input.Fields[i];
                    <tr>
                        <td>
                            @field.LogicalField
                            <input type="hidden" name="Input.Fields[@i].LogicalField" value="@field.LogicalField" />
                        </td>
                        <td><input name="Input.Fields[@i].ExcelColumn" value="@field.ExcelColumn" class="form-control form-control-sm" style="max-width:80px" /></td>
                        <td><input type="checkbox" name="Input.Fields[@i].IsRequired" value="true" class="form-check-input" checked="@field.IsRequired" /><input type="hidden" name="Input.Fields[@i].IsRequired" value="false" /></td>
                        <td><input name="Input.Fields[@i].FixedValue" value="@field.FixedValue" class="form-control form-control-sm" /></td>
                    </tr>
                }
            </tbody>
        </table>

        <h5 class="mt-4">Campos de usuario</h5>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Campo de usuario</th>
                    <th>Columna Excel</th>
                    <th>Obligatorio</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Input.UserFieldMappings.Count; i++)
                {
                    var mapping = Model.Input.UserFieldMappings[i];
                    <tr>
                        <td>
                            <select name="Input.UserFieldMappings[@i].UserFieldId" class="form-select form-select-sm">
                                <option value="">Sin asignar</option>
                                @foreach (var option in Model.UserFieldOptions)
                                {
                                    <option value="@option.Value" selected="@(option.Value == mapping.UserFieldId?.ToString())">@option.Text</option>
                                }
                            </select>
                        </td>
                        <td><input name="Input.UserFieldMappings[@i].ExcelColumn" value="@mapping.ExcelColumn" class="form-control form-control-sm" style="max-width:80px" /></td>
                        <td><input type="checkbox" name="Input.UserFieldMappings[@i].IsRequired" value="true" class="form-check-input" checked="@mapping.IsRequired" /><input type="hidden" name="Input.UserFieldMappings[@i].IsRequired" value="false" /></td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-primary">@(Model.EditId is null ? "Crear" : "Guardar")</button>
        @if (Model.EditId is not null)
        {
            <a asp-page="/Configuracion/Index" class="btn btn-outline-secondary">Cancelar</a>
        }
    </form>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Alias</th>
            <th>Módulo</th>
            <th>Tipo de documento</th>
            <th>Tipo de línea</th>
            <th>Socio de negocio</th>
            <th>Activo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var config in Model.Configs)
        {
            <tr>
                <td>@config.Alias</td>
                <td>@config.Module</td>
                <td>@config.DocumentType</td>
                <td>@config.LineType</td>
                <td>@(config.BusinessPartnerCardCode ?? "Estándar")</td>
                <td>@(config.IsActive ? "Sí" : "No")</td>
                <td>
                    <a asp-page="/Configuracion/Index" asp-route-editId="@config.Id">Editar</a>
                    <form method="post" asp-page-handler="Delete" asp-antiforgery="true" style="display:inline" onsubmit="return confirm('¿Eliminar esta configuración?');">
                        <input type="hidden" name="id" value="@config.Id" />
                        <button type="submit" class="btn btn-sm btn-link text-danger p-0 ms-2">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Configs.Count == 0)
{
    <p class="text-muted">Todavía no hay configuraciones -- un archivo se puede igual descargar/importar con el layout genérico por defecto.</p>
}

@if (Model.EditId is null)
{
    <script src="~/js/catalog-search.js"></script>
    <script>
        // Ver el comentario completo en Pages/Importar/Index.cshtml, mismo criterio
        // (Cliente si Módulo=Venta, Proveedor en cualquier otro caso).
        wireCatalogSearch({
            inputSelector: '.import-config-business-partner-code',
            datalistId: 'import-config-business-partners-datalist',
            handlerName: 'SearchBusinessPartners',
            minChars: 2,
            extraParams: function () { return { module: document.querySelector('[name="Input.Module"]').value }; },
            getValue: function (item) { return item.cardCode; },
            getLabel: function (item) { return item.cardCode + ' — ' + item.cardName; },
        });
    </script>
}
