@model Modulo.FacturasProveedor.Servicios.ReviewDetail
@* Contenido del drawer "Vista previa" de la bandeja: estado y resultado, el documento con la distribución del visor de
   FACELE (_DocumentoDte) y las acciones. Lo trae facturas-proveedor.js desde IndexModel.OnGetVistaPreviaAsync. *@
@{
    var r = Model.Row;
}

<div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
    <span class="badge-status @FacturasProveedorUi.StatusBadgeClass(r.Status)">@FacturasProveedorUi.StatusLabel(r.Status)</span>
    @if (r.Summary is { } summary)
    {
        <span class="text-muted small">@summary</span>
    }
</div>

<partial name="_DocumentoDte" model="Model" />

<div class="d-flex gap-2 flex-wrap mt-3">
    @if (Model.SupportsPdf)
    {
        <a class="btn btn-secondary" target="_blank" rel="noopener" href="~/facturas-proveedor/bandeja/@r.Id?handler=Pdf"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
    }
    <a class="btn btn-primary" href="~/facturas-proveedor/bandeja/@r.Id"><i class="bi bi-box-arrow-up-right"></i> Abrir revisión</a>
</div>
