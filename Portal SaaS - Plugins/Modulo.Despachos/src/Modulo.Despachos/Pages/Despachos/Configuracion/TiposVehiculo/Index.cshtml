@page "/despachos/configuracion/tipos-vehiculo"
@model Modulo.Despachos.Pages.Despachos.Configuracion.TiposVehiculo.IndexModel
@section Styles {
    <link rel="stylesheet" href="~/css/despachos.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = "Tipos de vehículo";
}
@* Mantenedor: grilla compacta con búsqueda y orden por columna; alta/edición en drawer
   (data-drawer-open + despachos-maestros.js); eliminar con confirmación. *@

<div class="card-surface">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
        <h2 class="mb-0">Tipos de vehículo</h2>
        @if (Model.CanCreate)
        {
            <button type="button" class="btn-primary" data-drawer-open="drawer-tipos-vehiculo" data-maestro-new="form-tipos-vehiculo">+ Nuevo tipo de vehículo</button>
        }
    </div>

    @if (Model.SuccessMessage is not null)
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="filter-card mb-3">
        <div class="col-auto flex-grow-1" style="max-width:360px;">
            <label for="buscar-tipos-vehiculo" class="form-label">Buscar</label>
            <input type="search" id="buscar-tipos-vehiculo" class="form-control" placeholder="Escriba para filtrar..." autocomplete="off" data-maestro-search="tabla-tipos-vehiculo" />
        </div>
    </div>

    <table class="table-ps" id="tabla-tipos-vehiculo" data-maestro-table>
        <thead><tr><th data-sort="text">Código</th><th data-sort="text">Nombre</th><th data-sort="number">Capacidad m³</th><th data-sort="number">Capacidad kg</th><th data-sort="text">Estado</th><th class="col-actions"></th></tr></thead>
        <tbody>
            @foreach (var x in Model.Items)
            {
                <tr class="@(x.IsActive ? "" : "row-inactive")" data-buscable="@(($"{x.Code} {x.Name}").ToLowerInvariant())">
                    <td>@x.Code</td>
                    <td>@x.Name</td>
                    <td data-value="@(x.CapacityM3?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")">@(x.CapacityM3?.ToString("0.##") ?? "—")</td>
                    <td data-value="@(x.CapacityKg?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")">@(x.CapacityKg?.ToString("0.##") ?? "—")</td>
                    <td>@if (x.IsActive) { <span class="badge-status badge-status--success">Activo</span> } else { <span class="badge-status badge-status--neutral">Inactivo</span> }</td>
                    <td class="col-actions">
                        <div class="admin-row-actions">
                            @if (Model.CanEdit)
                            {
                                <button type="button" class="btn-ghost" title="Editar" data-drawer-open="drawer-tipos-vehiculo" data-maestro-edit data-row="@Model.RowJson(new { x.Id, x.Code, x.Name, x.CapacityM3, x.CapacityKg, x.IsActive })"><i class="bi bi-pencil"></i></button>
                            }
                            @if (Model.CanDelete)
                            {
                                <form method="post" asp-page-handler="Delete" asp-route-id="@x.Id" asp-antiforgery="true" class="d-inline-block" data-confirm="@($"¿Eliminar {x.Name}?")">
                                    <button type="submit" class="btn-ghost btn-ghost--danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr data-table-empty><td colspan="6" class="text-muted">Sin tipos de vehículo todavía.</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.CanCreate || Model.CanEdit)
{
    <div id="drawer-tipos-vehiculo" class="drawer-overlay" data-drawer>
        <aside class="drawer-panel">
            <div class="drawer-header">
                <h3 data-drawer-title data-title-new="Nuevo tipo de vehículo" data-title-edit="Editar tipo de vehículo">Nuevo tipo de vehículo</h3>
                <button type="button" class="btn-ghost" data-drawer-close aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <form method="post" asp-page-handler="Save" asp-antiforgery="true" id="form-tipos-vehiculo">
                <div class="drawer-body">
                    <input type="hidden" name="Input.Id" value="0" />
                    <div class="drawer-grid">
                    <div class="mb-3">
                        <label class="form-label" for="f-Code">Código</label>
                        <input type="text" id="f-Code" name="Input.Code" class="form-control" placeholder="Ej. CAM-3-4" autocomplete="off" required  />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="f-Name">Nombre</label>
                        <input type="text" id="f-Name" name="Input.Name" class="form-control" placeholder="Ej. Camión 3/4" autocomplete="off" required  />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="f-CapacityM3">Capacidad (m³)</label>
                        <input type="number" step="0.01" min="0" id="f-CapacityM3" name="Input.CapacityM3" class="form-control" placeholder="Ej. 12.5" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="f-CapacityKg">Capacidad (kg)</label>
                        <input type="number" step="0.01" min="0" id="f-CapacityKg" name="Input.CapacityKg" class="form-control" placeholder="Ej. 3500" />
                    </div>
                    <div class="mb-3 d-flex align-items-end ">
                        <label class="d-flex align-items-center gap-2"><input type="checkbox" name="Input.IsActive" value="true" checked /> Activo</label>
                    </div>
                    </div>
                </div>
                <div class="drawer-footer">
                    <button type="button" class="btn-secondary" data-drawer-close>Cancelar</button>
                    <button type="submit" class="btn-primary" data-submit-label data-label-new="Crear" data-label-edit="Guardar">Crear</button>
                </div>
            </form>
        </aside>
    </div>
}

@section Scripts {
    <script src="~/js/table-tools.js"></script>
    <script src="~/js/despachos-maestros.js" asp-append-version="true"></script>
}
