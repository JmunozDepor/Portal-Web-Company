@page
@model PortalSaas.Host.Pages.Account.LoginModel
@{
    // Layout = null -- pantalla propia de punta a punta (split-screen), no el shell de
    // tenant/admin. Estructura portada de referencia-original/PortalSAP_v2
    // (Pages/Login.cshtml + theme.css .login-*), branding genérico de la plataforma
    // -- acá todavía no se conoce la organización (recién se resuelve por
    // Input.OrganizationSlug al enviar el formulario), a diferencia del original
    // (single-tenant, marca fija de un solo cliente).
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión — Portal SaaS</title>
    <script>
        document.documentElement.setAttribute('data-theme', localStorage.getItem('ps-theme') || 'claro');
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-bg">
    <div class="login-brand-panel">
        <div class="login-brand">
            <div class="login-brand-mark">PS</div>
            <div class="login-brand-text">
                <h1>Portal SaaS</h1>
                <p>Plataforma multiempresa para SAP Business One</p>
            </div>
        </div>

        <div class="login-pitch">
            <h2>Un portal, todas tus organizaciones conectadas a SAP</h2>
            <p>Ventas, compras, logística e importación de datos en un solo lugar, con acceso independiente por organización y compañía.</p>
        </div>

        <p class="login-footer">&copy; @DateTime.Now.Year Portal SaaS — Acceso restringido a usuarios autorizados.</p>
    </div>

    <div class="login-form-panel">
        <div class="login-shell">
            <div class="login-card">
                <h2>Iniciar sesión</h2>
                <p class="login-subtitle">Ingresá los datos de tu organización para continuar.</p>

                @if (Model.ErrorMessage is not null)
                {
                    <div class="text-danger validation-summary-errors" style="display:block; color: var(--bs-danger); font-size: 12.5px; background: color-mix(in srgb, var(--bs-danger) 12%, transparent); border: 1px solid color-mix(in srgb, var(--bs-danger) 35%, transparent); border-radius: var(--radius-sm); padding: 9px 11px; margin: -6px 0 16px;">
                        @Model.ErrorMessage
                    </div>
                }

                <form method="post">
                    <input type="hidden" asp-for="Input.ReturnUrl" />

                    <div class="form-group mb-3">
                        <label asp-for="Input.OrganizationSlug" class="form-label">Organización</label>
                        <input asp-for="Input.OrganizationSlug" class="form-control" autocomplete="organization" autofocus />
                        <span asp-validation-for="Input.OrganizationSlug" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Input.EmailOrUsername" class="form-label">Usuario</label>
                        <input asp-for="Input.EmailOrUsername" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Input.EmailOrUsername" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Input.Password" class="form-label">Contraseña</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="login-submit">Iniciar sesión</button>
                </form>

                <p class="text-center mt-3 mb-0">
                    <a asp-page="/Account/ForgotPassword" style="font-size: 12.5px;">¿Olvidaste tu contraseña?</a>
                </p>

                <div class="theme-row justify-content-center">
                    <button type="button" data-theme-switch="claro" title="Claro"></button>
                    <button type="button" data-theme-switch="oscuro" title="Oscuro"></button>
                    <button type="button" data-theme-switch="teal" title="Teal"></button>
                    <button type="button" data-theme-switch="violeta" title="Violeta"></button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/theme-switcher.js" asp-append-version="true"></script>
</body>
</html>
