# Copiar a .env.prod (NUNCA versionar ese archivo) y completar con valores reales
# antes de `docker compose -f docker-compose.prod.yml --env-file .env.prod up -d`.
#
# 2 bases independientes en el mismo servidor cloud -- separadas de
# sqlsap.cdepor.cl (SQL Server de SAP, no se toca):
#   - "test": para QA/pruebas, sin exponer datos productivos reales sin cuidado.
#   - "prod": la base real que consume el PortalSaas.Host de IIS en producción.
# Usar contraseñas DISTINTAS para cada una.

TEST_POSTGRES_DB=portalsaas_saas_test
TEST_POSTGRES_USER=portalsaas
TEST_POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_REAL_TEST
TEST_POSTGRES_PORT=5433

PROD_POSTGRES_DB=portalsaas_saas_prod
PROD_POSTGRES_USER=portalsaas
PROD_POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_REAL_PROD
PROD_POSTGRES_PORT=5432
