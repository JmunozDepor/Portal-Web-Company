@model Modulo.Compras.Pages.DetailGenericPurchaseDocumentModelBase
@using System.Globalization
@{
    var readOnly = Model.Document.ReadOnly;
    // Ya NO se pre-renderizan filas extra en blanco -- "+ Agregar línea" real (JS,
    // ver document-lines-editor.js), mismo criterio aplicado primero en
    // Modulo.Ventas/_TabContentVentas.cshtml (regla de paridad entre motores).
    var rowCount = readOnly ? Model.Input.Lines.Count : Math.Max(Model.Input.Lines.Count, 1);
    var lineTypeClass = Model.Input.LineType == PortalSaas.Abstractions.Modelos.DocumentLineType.Service ? "line-type-service" : "line-type-item";
}

<div class="line-items-wrapper">
@* Una sola altura de fila: el nombre del artículo va en Descripción y la moneda al lado
   del precio (antes se apilaban debajo del input y desalineaban la fila). Las columnas
   del tipo de línea que no corresponde se ocultan vía line-type-item/line-type-service
   (ver site.css y aplicarTipoLinea en document-lines-editor.js). *@
<table class="table table-sm line-items-table @lineTypeClass" id="purchase-document-lines">
    <thead>
        <tr>
            <th class="col-item line-item-only">Artículo</th>
            <th class="col-desc" data-form-field="linea-descripcion">Descripción</th>
            <th class="col-qty">Cantidad</th>
            <th class="col-price" data-form-field="linea-precio">Precio unitario</th>
            <th class="col-disc" data-form-field="linea-descuento">% Desc.</th>
            <th class="col-wh line-item-only">Almacén</th>
            <th class="col-acct line-service-only">Cuenta mayor</th>
            <th class="col-cc line-service-only">Centro de costos</th>
            <th class="col-cc line-service-only" data-form-field="linea-marca">Marca <small class="text-muted">(opcional)</small></th>
            <th class="col-cc line-service-only" data-form-field="linea-tipo-gasto">Tipo de gasto <small class="text-muted">(opcional)</small></th>
            @if (!readOnly)
            {
                <th class="col-actions"></th>
            }
        </tr>
    </thead>
    <tbody id="purchase-document-lines-body">
        @for (var i = 0; i < rowCount; i++)
        {
            var line = i < Model.Input.Lines.Count ? Model.Input.Lines[i] : new Modulo.Compras.Pages.DetailGenericPurchaseDocumentModelBase.LineInput();
            <tr>
                <td class="col-item line-item-only">
                    <input name="Input.Lines[@i].ItemCode" value="@line.ItemCode" class="form-control form-control-sm purchase-document-item-code" list="purchase-document-items-datalist" placeholder="Código o nombre" autocomplete="off" disabled="@readOnly" />
                </td>
                <td class="col-desc" data-form-field="linea-descripcion">
                    <div class="line-service-only">
                        <input name="Input.Lines[@i].Description" value="@line.Description" class="form-control form-control-sm" disabled="@readOnly" />
                    </div>
                    <span class="line-item-only line-item-description" title="@line.Description">@line.Description</span>
                </td>
                <td class="col-qty">
                    <input name="Input.Lines[@i].Quantity" type="number" step="0.01" value="@(line.Quantity is null or 0 ? "" : line.Quantity.Value.ToString(CultureInfo.InvariantCulture))" class="form-control form-control-sm line-qty" disabled="@readOnly" />
                </td>
                <td class="col-price" data-form-field="linea-precio">
                    <div class="line-price-cell">
                        <input name="Input.Lines[@i].UnitPrice" type="number" step="0.01" value="@line.UnitPrice?.ToString(CultureInfo.InvariantCulture)" class="form-control form-control-sm line-price" placeholder="Lista" disabled="@readOnly" />
                        <input type="hidden" name="Input.Lines[@i].Currency" value="@line.Currency" class="line-currency" disabled="@readOnly" />
                        <span class="line-currency-label">@line.Currency</span>
                    </div>
                </td>
                <td class="col-disc" data-form-field="linea-descuento">
                    <input name="Input.Lines[@i].DiscountPercent" type="number" step="0.01" value="@(line.DiscountPercent is null or 0 ? "" : line.DiscountPercent.Value.ToString(CultureInfo.InvariantCulture))" class="form-control form-control-sm line-discount" disabled="@readOnly" />
                </td>
                <td class="col-wh line-item-only">
                    <input name="Input.Lines[@i].WarehouseCode" value="@line.WarehouseCode" class="form-control form-control-sm purchase-document-warehouse-code" list="purchase-document-warehouses-datalist" placeholder="Buscar…" disabled="@readOnly" />
                </td>
                <td class="col-acct line-service-only">
                    <input name="Input.Lines[@i].AccountCode" value="@line.AccountCode" class="form-control form-control-sm purchase-document-account-code" list="purchase-document-accounts-datalist" placeholder="Buscar…" disabled="@readOnly" />
                </td>
                <td class="col-cc line-service-only">
                    <input name="Input.Lines[@i].CostCenterCode" value="@line.CostCenterCode" class="form-control form-control-sm purchase-document-cost-center-code" list="purchase-document-cost-centers-datalist" placeholder="Buscar…" disabled="@readOnly" />
                </td>
                <td class="col-cc line-service-only" data-form-field="linea-marca">
                    <input name="Input.Lines[@i].CostCenterCode2" value="@line.CostCenterCode2" class="form-control form-control-sm purchase-document-cost-center2-code" list="purchase-document-cost-centers2-datalist" placeholder="Buscar…" disabled="@readOnly" />
                </td>
                <td class="col-cc line-service-only" data-form-field="linea-tipo-gasto">
                    <input name="Input.Lines[@i].CostCenterCode3" value="@line.CostCenterCode3" class="form-control form-control-sm purchase-document-cost-center3-code" list="purchase-document-cost-centers3-datalist" placeholder="Buscar…" disabled="@readOnly" />
                </td>
                @if (!readOnly)
                {
                    <td class="col-actions"><button type="button" class="btn btn-sm btn-outline-danger line-remove-btn purchase-document-remove-line" title="Quitar línea" aria-label="Quitar línea"><i class="bi bi-x-lg"></i></button></td>
                }
            </tr>
        }
    </tbody>
</table>
</div>

@* Resumen total -- mismo bloque que Modulo.Ventas/_TabContentVentas.cshtml, con
   recálculo en vivo (regla de paridad). *@
<div class="doc-resumen-total">
    <span class="doc-resumen-total-titulo">Resumen total</span>
    <div class="doc-resumen-total-fila">
        <label>Total antes del descuento</label>
        <span id="purchase-document-total-before-discount">@Model.TotalBeforeDiscount.ToString("N2")</span>
    </div>
    <div class="doc-resumen-total-fila">
        <label>Descuento</label>
        <span id="purchase-document-discount">@Model.Discount.ToString("N2")</span>
    </div>
    <div class="doc-resumen-total-fila">
        <label>Gastos adicionales</label>
        <span>@Model.AdditionalExpenses.ToString("N2")</span>
    </div>
    <div class="doc-resumen-total-fila">
        <label>Impuesto</label>
        <span>@Model.Tax.ToString("N2")</span>
    </div>
    <div class="doc-resumen-total-fila doc-resumen-total-final">
        <label>Total del documento <span id="purchase-document-document-currency">@(Model.Input.DocCurrency ?? Model.LocalCurrency)</span></label>
        <span id="purchase-document-document-total">@Model.DocumentTotal.ToString("N2")</span>
    </div>
</div>

<datalist id="purchase-document-items-datalist"></datalist>
<datalist id="purchase-document-warehouses-datalist"></datalist>
<datalist id="purchase-document-accounts-datalist"></datalist>
<datalist id="purchase-document-cost-centers-datalist"></datalist>
<datalist id="purchase-document-cost-centers2-datalist"></datalist>
<datalist id="purchase-document-cost-centers3-datalist"></datalist>

@if (!readOnly)
{
    <div class="admin-row-actions mb-2 mt-2">
        <button type="button" id="purchase-document-add-line" class="btn btn-sm btn-outline-secondary">+ Agregar línea</button>
        <button type="button" id="purchase-document-download-template" class="btn btn-sm btn-outline-secondary">Descargar plantilla Excel</button>
        <button type="button" id="purchase-document-import-csv" class="btn btn-sm btn-outline-secondary">Importar Excel</button>
        <button type="button" id="purchase-document-clear-lines" class="btn btn-sm btn-outline-danger">Vaciar todas las líneas</button>
        <input type="file" id="purchase-document-csv-file" accept=".xlsx,.xls" style="display:none" />
    </div>
    <div id="purchase-document-csv-result"></div>

    <template id="purchase-document-line-template">
        <tr>
            <td class="col-item line-item-only"><input name="Input.Lines[__INDEX__].ItemCode" class="form-control form-control-sm purchase-document-item-code" list="purchase-document-items-datalist" placeholder="Código o nombre" autocomplete="off" /></td>
            <td class="col-desc" data-form-field="linea-descripcion">
                <div class="line-service-only"><input name="Input.Lines[__INDEX__].Description" class="form-control form-control-sm" /></div>
                <span class="line-item-only line-item-description"></span>
            </td>
            <td class="col-qty"><input name="Input.Lines[__INDEX__].Quantity" type="number" step="0.01" class="form-control form-control-sm line-qty" /></td>
            <td class="col-price" data-form-field="linea-precio">
                <div class="line-price-cell">
                    <input name="Input.Lines[__INDEX__].UnitPrice" type="number" step="0.01" class="form-control form-control-sm line-price" placeholder="Lista" />
                    <input type="hidden" name="Input.Lines[__INDEX__].Currency" class="line-currency" />
                    <span class="line-currency-label"></span>
                </div>
            </td>
            <td class="col-disc" data-form-field="linea-descuento"><input name="Input.Lines[__INDEX__].DiscountPercent" type="number" step="0.01" class="form-control form-control-sm line-discount" /></td>
            <td class="col-wh line-item-only"><input name="Input.Lines[__INDEX__].WarehouseCode" class="form-control form-control-sm purchase-document-warehouse-code" list="purchase-document-warehouses-datalist" placeholder="Buscar…" /></td>
            <td class="col-acct line-service-only"><input name="Input.Lines[__INDEX__].AccountCode" class="form-control form-control-sm purchase-document-account-code" list="purchase-document-accounts-datalist" placeholder="Buscar…" /></td>
            <td class="col-cc line-service-only"><input name="Input.Lines[__INDEX__].CostCenterCode" class="form-control form-control-sm purchase-document-cost-center-code" list="purchase-document-cost-centers-datalist" placeholder="Buscar…" /></td>
            <td class="col-cc line-service-only" data-form-field="linea-marca"><input name="Input.Lines[__INDEX__].CostCenterCode2" class="form-control form-control-sm purchase-document-cost-center2-code" list="purchase-document-cost-centers2-datalist" placeholder="Buscar…" /></td>
            <td class="col-cc line-service-only" data-form-field="linea-tipo-gasto"><input name="Input.Lines[__INDEX__].CostCenterCode3" class="form-control form-control-sm purchase-document-cost-center3-code" list="purchase-document-cost-centers3-datalist" placeholder="Buscar…" /></td>
            <td class="col-actions"><button type="button" class="btn btn-sm btn-outline-danger line-remove-btn purchase-document-remove-line" title="Quitar línea" aria-label="Quitar línea"><i class="bi bi-x-lg"></i></button></td>
        </tr>
    </template>

    <script src="~/js/catalog-search.js"></script>
    <script src="~/lib/sheetjs/xlsx.full.min.js"></script>
    <script src="~/js/document-lines-editor.js"></script>
    <script>
        wireCatalogSearch({
            inputSelector: '.purchase-document-item-code',
            datalistId: 'purchase-document-items-datalist',
            handlerName: 'SearchItems',
            minChars: 2,
            getValue: function (item) { return item.itemCode; },
            getLabel: function (item) { return item.itemCode + ' — ' + item.itemName; },
        });

        // Catálogos chicos (Almacén/Cuenta Mayor/Centro de Costos) -- minChars: 0.
        wireCatalogSearch({
            inputSelector: '.purchase-document-warehouse-code',
            datalistId: 'purchase-document-warehouses-datalist',
            handlerName: 'SearchWarehouses',
            minChars: 0,
            getValue: function (item) { return item.warehouseCode; },
            getLabel: function (item) { return item.warehouseCode + ' — ' + item.warehouseName; },
        });

        wireCatalogSearch({
            inputSelector: '.purchase-document-account-code',
            datalistId: 'purchase-document-accounts-datalist',
            handlerName: 'SearchAccounts',
            minChars: 0,
            getValue: function (item) { return item.accountCode; },
            getLabel: function (item) { return item.accountCode + ' — ' + item.accountName; },
        });

        wireCatalogSearch({
            inputSelector: '.purchase-document-cost-center-code',
            datalistId: 'purchase-document-cost-centers-datalist',
            handlerName: 'SearchCostCenters',
            minChars: 0,
            getValue: function (item) { return item.code; },
            getLabel: function (item) { return item.code + ' — ' + item.name; },
        });

        wireCatalogSearch({
            inputSelector: '.purchase-document-cost-center2-code',
            datalistId: 'purchase-document-cost-centers2-datalist',
            handlerName: 'SearchCostCenters2',
            minChars: 0,
            getValue: function (item) { return item.code; },
            getLabel: function (item) { return item.code + ' — ' + item.name; },
        });

        wireCatalogSearch({
            inputSelector: '.purchase-document-cost-center3-code',
            datalistId: 'purchase-document-cost-centers3-datalist',
            handlerName: 'SearchCostCenters3',
            minChars: 0,
            getValue: function (item) { return item.code; },
            getLabel: function (item) { return item.code + ' — ' + item.name; },
        });

        wireDocumentLinesEditor({
            tableBodyId: 'purchase-document-lines-body',
            templateId: 'purchase-document-line-template',
            addButtonId: 'purchase-document-add-line',
            clearButtonId: 'purchase-document-clear-lines',
            removeButtonSelector: '.purchase-document-remove-line',
            startIndex: @Model.Input.Lines.Count,
            itemCodeSelector: '.purchase-document-item-code',
            datalistId: 'purchase-document-items-datalist',
            csvColumns: ['ItemCode', 'Description', 'Quantity', 'UnitPrice', 'DiscountPercent', 'WarehouseCode', 'AccountCode', 'CostCenterCode', 'CostCenterCode2', 'CostCenterCode3'],
            downloadTemplateButtonId: 'purchase-document-download-template',
            importCsvButtonId: 'purchase-document-import-csv',
            csvFileInputId: 'purchase-document-csv-file',
            csvResultId: 'purchase-document-csv-result',
            lineType: {
                selectId: 'Input_LineType',
                itemValue: '@PortalSaas.Abstractions.Modelos.DocumentLineType.Item',
                itemOnlySelector: '.line-item-only',
                serviceOnlySelector: '.line-service-only',
            },
            totals: {
                qtySelector: '.line-qty',
                priceSelector: '.line-price',
                discountSelector: '.line-discount',
                totalBeforeDiscountId: 'purchase-document-total-before-discount',
                discountId: 'purchase-document-discount',
                documentTotalId: 'purchase-document-document-total',
            },
        });
    </script>
}
