@page "/sellout/clientesku"
@model Modulo.SellOut.Pages.ClienteSku.IndexModel
@{
    ViewData["Title"] = "SKU por cliente";

    string ConstruirUrlPagina(int pagina) =>
        $"~/sellout/clientesku?pagina={pagina}&tamanoPagina={Model.TamanoPagina}&filtroIdCliente={Model.FiltroIdCliente}&filtroTexto={Uri.EscapeDataString(Model.FiltroTexto ?? string.Empty)}&filtroSoloSinParidad={Model.FiltroSoloSinParidad}";
}

<div class="card-ps admin-card">
    <div class="admin-card-header">
        <h2>SKU por cliente</h2>
    </div>

    <partial name="_MensajesSellOut" model="Model" />

    @if (!Model.PuedeVer)
    {
        <p class="admin-muted">No tenés permiso para ver esta pantalla.</p>
    }
    else
    {
        @if (Model.PuedeCrear || Model.PuedeEditar)
        {
            <div class="doc-tab-seccion sellout-panel-edicion">
                <h3>@(Model.Editando is null ? "Nuevo SKU" : $"Editar SKU · {Model.Input.Sku}")</h3>

                <form asp-page="./Index" asp-page-handler="Guardar" method="post">
                    <input type="hidden" name="FiltroIdCliente" value="@Model.FiltroIdCliente" />
                    <input type="hidden" name="FiltroTexto" value="@Model.FiltroTexto" />
                    <input type="hidden" name="FiltroSoloSinParidad" value="@Model.FiltroSoloSinParidad" />
                    <input type="hidden" name="Pagina" value="@Model.Pagina" />
                    <input type="hidden" name="TamanoPagina" value="@Model.TamanoPagina" />
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="sellout-grid">
                        <div class="form-group">
                            <label asp-for="Input.IdCliente">Cliente</label>
                            @if (Model.Editando is null)
                            {
                                <select asp-for="Input.IdCliente" asp-items="Model.ClientesDisponibles" class="form-control">
                                    <option value="">Seleccionar...</option>
                                </select>
                            }
                            else
                            {
                                <input type="hidden" asp-for="Input.IdCliente" />
                                <input class="form-control" value="@Model.Input.IdCliente" readonly />
                            }
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.Sku">SKU</label>
                            @if (Model.Editando is null)
                            {
                                <input asp-for="Input.Sku" class="form-control" />
                            }
                            else
                            {
                                <input type="hidden" asp-for="Input.Sku" />
                                <input class="form-control" value="@Model.Input.Sku" readonly />
                            }
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.Barcode">Barcode</label>
                            <input asp-for="Input.Barcode" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.DescripcionCliente">Descripción</label>
                            <input asp-for="Input.DescripcionCliente" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.DeptoCliente">Depto. cliente</label>
                            <input asp-for="Input.DeptoCliente" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.Producto">Producto (paridad SAP)</label>
                            <input asp-for="Input.Producto" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.CostoUnit">Costo unit.</label>
                            <input asp-for="Input.CostoUnit" type="number" step="0.01" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.VentaUnit">Venta unit.</label>
                            <input asp-for="Input.VentaUnit" type="number" step="0.01" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.PrecioFull">Precio full</label>
                            <input asp-for="Input.PrecioFull" type="number" step="0.01" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <label style="text-transform:none;font-weight:500;"><input asp-for="Input.Activo" type="checkbox" /> Activo</label>
                        </div>
                    </div>
                    <button type="submit" class="btn-erp-primary">@(Model.Editando is null ? "Crear" : "Guardar")</button>
                    @if (Model.Editando is not null)
                    {
                        <a href="@ConstruirUrlPagina(Model.Pagina)" class="btn-module-action">Cancelar</a>
                    }
                </form>
            </div>

            <div class="doc-tab-seccion sellout-panel-edicion">
                <h3>Actualizar paridad masivamente</h3>
                <p class="admin-muted">
                    CSV con columnas <code>IdCliente</code>, <code>Sku</code>, <code>Producto</code> (encabezado, cualquier orden) --
                    actualiza la paridad de SKU ya existentes, no crea filas nuevas.
                </p>
                <form asp-page="./Index" asp-page-handler="ImportarParidad" method="post" enctype="multipart/form-data">
                    <input type="file" name="archivoParidad" accept=".csv" class="form-control" required style="max-width:320px;display:inline-block;" />
                    <button type="submit" class="btn-module-action">Importar CSV</button>
                </form>

                @if (Model.ErroresImportacion is { Count: > 0 })
                {
                    <div class="admin-alert admin-alert-danger" style="margin-top:10px;">
                        <strong>@Model.ErroresImportacion.Count fila(s) con error:</strong>
                        <ul style="margin:6px 0 0 18px;">
                            @foreach (var error in Model.ErroresImportacion.Take(50))
                            {
                                <li>@error</li>
                            }
                        </ul>
                        @if (Model.ErroresImportacion.Count > 50)
                        {
                            <p>... y @(Model.ErroresImportacion.Count - 50) más.</p>
                        }
                    </div>
                }
            </div>
        }

        <form method="get" class="doc-list-filtros">
            <div class="form-group">
                <label for="filtro-cliente">Cliente</label>
                <select id="filtro-cliente" name="FiltroIdCliente" class="form-control" asp-items="Model.ClientesDisponibles">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="form-group doc-list-busqueda">
                <label for="filtro-texto">Buscar</label>
                <input id="filtro-texto" name="FiltroTexto" class="form-control" value="@Model.FiltroTexto" placeholder="SKU, descripción o barcode..." />
            </div>
            <div class="form-group">
                <label>&nbsp;</label>
                <label style="text-transform:none;font-weight:500;display:block;padding:11px 0 0;">
                    <input type="checkbox" name="FiltroSoloSinParidad" value="true" checked="@Model.FiltroSoloSinParidad" /> Solo sin paridad
                </label>
            </div>
            <div class="form-group">
                <label for="tamano-pagina">Por página</label>
                <select id="tamano-pagina" name="TamanoPagina" class="form-control">
                    @foreach (var tamano in Model.AvailablePageSizes)
                    {
                        <option value="@tamano" selected="@(tamano == Model.TamanoPagina)">@tamano</option>
                    }
                </select>
            </div>
            <div class="form-group doc-list-filtros-acciones">
                <button type="submit" class="btn-module-action">Buscar</button>
                <a href="~/sellout/clientesku" class="btn-module-action">Limpiar</a>
            </div>
        </form>

        <div class="doc-list-contador">@Model.TotalRegistros registro(s) -- página @Model.Pagina de @Model.TotalPaginas</div>

        <table class="admin-table">
            <thead><tr><th>Cliente</th><th>SKU</th><th>Descripción</th><th>Barcode</th><th>Producto (paridad)</th><th>Costo</th><th>Venta</th><th>Activo</th><th class="admin-col-accion"></th></tr></thead>
            <tbody>
                @foreach (var s in Model.Skus)
                {
                    <tr class="@((s.Activo ?? true) ? "" : "admin-fila-inactiva")">
                        <td>@s.NomCliente</td>
                        <td>@s.Sku</td>
                        <td>@s.DescripcionCliente</td>
                        <td>@s.Barcode</td>
                        <td>@s.Producto</td>
                        <td>@s.CostoUnit</td>
                        <td>@s.VentaUnit</td>
                        <td>@((s.Activo ?? true) ? "Sí" : "No")</td>
                        <td class="admin-col-accion">
                            <div class="admin-row-actions">
                                @if (Model.PuedeEditar)
                                {
                                    <a href="~/sellout/clientesku?editandoCliente=@s.IdCliente&editandoSku=@s.Sku&filtroIdCliente=@Model.FiltroIdCliente&filtroTexto=@Model.FiltroTexto&filtroSoloSinParidad=@Model.FiltroSoloSinParidad&pagina=@Model.Pagina&tamanoPagina=@Model.TamanoPagina" class="btn-module-action">Editar</a>
                                }
                                @if (Model.PuedeEliminar)
                                {
                                    <form asp-page="./Index" asp-page-handler="Eliminar" asp-route-idCliente="@s.IdCliente" asp-route-sku="@s.Sku" method="post" style="display:inline-block;"
                                          onsubmit="return confirm('¿Eliminar el SKU &quot;@s.Sku&quot;?');">
                                        <button type="submit" class="btn-module-action btn-module-danger">Eliminar</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="doc-list-paginacion">
            <a class="btn-module-action @(Model.Pagina <= 1 ? "disabled" : "")"
               href="@(Model.Pagina <= 1 ? "#" : ConstruirUrlPagina(Model.Pagina - 1))">« Anterior</a>
            <span>Página @Model.Pagina de @Model.TotalPaginas</span>
            <a class="btn-module-action @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")"
               href="@(Model.Pagina >= Model.TotalPaginas ? "#" : ConstruirUrlPagina(Model.Pagina + 1))">Siguiente »</a>
        </div>
    }
</div>
