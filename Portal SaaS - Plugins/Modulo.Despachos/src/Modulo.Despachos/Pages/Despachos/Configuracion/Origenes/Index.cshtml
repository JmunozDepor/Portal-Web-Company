@page "/despachos/configuracion/origenes"
@model Modulo.Despachos.Pages.Despachos.Configuracion.Origenes.IndexModel
@section Styles {
    <link rel="stylesheet" href="~/css/despachos.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = "Orígenes";
}
@* Mantenedor: grilla compacta con búsqueda y orden por columna; alta/edición en drawer
   (data-drawer-open + despachos-maestros.js); eliminar con confirmación. *@

<div class="card-surface">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-3 flex-wrap">
        <h2 class="mb-0">Orígenes</h2>
        @if (Model.CanCreate)
        {
            <button type="button" class="btn btn-primary" data-drawer-open="drawer-origenes" data-maestro-new="form-origenes">+ Nuevo origen</button>
        }
    </div>

    @if (Model.SuccessMessage is not null)
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="filter-card mb-3">
        <form method="post" asp-page-handler="SaveIssuer" asp-antiforgery="true" class="d-flex flex-wrap align-items-end gap-3">
            <div class="col-auto flex-grow-1" style="max-width:360px;">
                <label for="issuer-tax-id" class="form-label">RUT emisor de la compañía</label>
                <input type="text" id="issuer-tax-id" name="IssuerInput" class="form-control" value="@Model.IssuerTaxId" placeholder="Ej. 76123456-0" autocomplete="off" @(Model.CanEdit ? "" : "readonly") />
                <div class="form-text">Se compara con el RUT del timbre (PDF417) al agregar documentos a un manifiesto.</div>
            </div>
            @if (Model.CanEdit)
            {
                <button type="submit" class="btn btn-primary">Guardar RUT</button>
            }
        </form>
    </div>

    @* Guías de despacho electrónicas (Res. 154): el proveedor DTE (FACELE, BES...) y sus credenciales se configuran
       en Administración por compañía; aquí solo se activa la emisión al despachar y sus indicadores. *@
    <div class="filter-card mb-3">
        <form method="post" asp-page-handler="SaveGuides" asp-antiforgery="true" class="d-flex flex-wrap align-items-end gap-3">
            <div class="col-auto">
                <label class="d-flex align-items-center gap-2">
                    <input type="checkbox" name="GuidesInput.GuidesEnabled" value="true" checked="@Model.GuidesInput.GuidesEnabled" disabled="@(!Model.CanEdit)" />
                    Emitir guías de despacho electrónicas al despachar (Res. 154)
                </label>
            </div>
            <div class="col-auto">
                <label for="guides-transfer" class="form-label">Indicador de traslado</label>
                <select id="guides-transfer" name="GuidesInput.TransferIndicator" class="form-select" disabled="@(!Model.CanEdit)">
                    @foreach (var (value, label) in Modulo.Despachos.Pages.Despachos.Configuracion.Origenes.IndexModel.TransferIndicators)
                    {
                        <option value="@value" selected="@(Model.GuidesInput.TransferIndicator == value)">@label</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label for="guides-dispatch" class="form-label">Tipo de despacho</label>
                <select id="guides-dispatch" name="GuidesInput.DispatchType" class="form-select" disabled="@(!Model.CanEdit)">
                    <option value="" selected="@(Model.GuidesInput.DispatchType is null)">No informar</option>
                    @foreach (var (value, label) in Modulo.Despachos.Pages.Despachos.Configuracion.Origenes.IndexModel.DispatchTypes)
                    {
                        <option value="@value" selected="@(Model.GuidesInput.DispatchType == value)">@label</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label for="guides-grouping" class="form-label">Líneas de la guía</label>
                <select id="guides-grouping" name="GuidesInput.LineGrouping" class="form-select" disabled="@(!Model.CanEdit)">
                    @foreach (var g in GuideLineGroupings.All)
                    {
                        <option value="@g" selected="@(Model.GuidesInput.LineGrouping == g)">@GuideLineGroupings.Label(g)</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label for="guides-code" class="form-label">Código del artículo</label>
                <select id="guides-code" name="GuidesInput.ItemCodePlacement" class="form-select" disabled="@(!Model.CanEdit)">
                    @foreach (var c in GuideItemCodePlacements.All)
                    {
                        <option value="@c" selected="@(Model.GuidesInput.ItemCodePlacement == c)">@GuideItemCodePlacements.Label(c)</option>
                    }
                </select>
            </div>
            @if (Model.CanEdit)
            {
                <button type="submit" class="btn btn-primary">Guardar ajustes de guías</button>
            }
        </form>
        <div class="form-text mt-2">
            @if (Model.DteStatus is { IsConfigured: true } dte)
            {
                <span>Documentos electrónicos: <strong>@dte.ProviderCode</strong> · @(dte.Environment == "production" ? "Producción" : "Certificación") · RUT emisor @dte.IssuerTaxId</span>
            }
            else
            {
                <span class="text-danger">@(Model.DteStatus?.Error ?? "La compañía no tiene configurados los documentos electrónicos.")</span>
            }
        </div>
    </div>

    <div class="filter-card mb-3">
        <div class="col-auto flex-grow-1" style="max-width:360px;">
            <label for="buscar-origenes" class="form-label">Buscar</label>
            <input type="search" id="buscar-origenes" class="form-control" placeholder="Escriba para filtrar..." autocomplete="off" data-maestro-search="tabla-origenes" />
        </div>
    </div>

    <div class="table-responsive-lg">
        <table class="table-ps" id="tabla-origenes" data-maestro-table>
            <thead><tr><th data-sort="text">Código</th><th data-sort="text">Nombre</th><th data-sort="text">Dirección</th><th data-sort="text">Comuna</th><th data-sort="text">Bodega SAP</th><th data-sort="text">Estado</th><th class="col-actions"></th></tr></thead>
            <tbody>
                @foreach (var x in Model.Items)
                {
                    <tr class="@(x.IsActive ? "" : "row-inactive")" data-buscable="@(($"{x.Code} {x.Name} {x.Address} {Model.CommuneName(x.CommuneId)} {x.SapWarehouseCode}").ToLowerInvariant())">
                        <td>@x.Code</td>
                        <td>@x.Name</td>
                        <td>@(x.Address ?? "—")</td>
                        <td>@Model.CommuneName(x.CommuneId)</td>
                        <td>@(x.SapWarehouseCode ?? "—")</td>
                        <td>@if (x.IsActive) { <span class="badge-status badge-status--success">Activo</span> } else { <span class="badge-status badge-status--neutral">Inactivo</span> }</td>
                        <td class="col-actions">
                            <div class="admin-row-actions">
                                @if (Model.CanEdit)
                                {
                                    <button type="button" class="btn-ghost" title="Editar" data-drawer-open="drawer-origenes" data-maestro-edit data-row="@Model.RowJson(new { x.Id, x.Code, x.Name, x.Address, x.CommuneId, x.SapWarehouseCode, x.IsActive })"><i class="bi bi-pencil"></i></button>
                                }
                                @if (Model.CanDelete)
                                {
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@x.Id" asp-antiforgery="true" class="d-inline-block" data-confirm="@($"¿Eliminar {x.Name}?")">
                                        <button type="submit" class="btn-ghost btn-ghost--danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr data-table-empty><td colspan="7" class="text-muted">Sin orígenes todavía.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.CanCreate || Model.CanEdit)
{
    <div id="drawer-origenes" class="drawer-overlay" data-drawer>
        <aside class="drawer-panel">
            <div class="drawer-header">
                <h3 data-drawer-title data-title-new="Nuevo origen" data-title-edit="Editar origen">Nuevo origen</h3>
                <button type="button" class="btn-ghost" data-drawer-close aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <form method="post" asp-page-handler="Save" asp-antiforgery="true" id="form-origenes">
                <div class="drawer-body">
                    <input type="hidden" name="Input.Id" value="0" />
                    <div class="drawer-grid">
                    <div class="mb-3">
                        <label class="form-label" for="f-Code">Código</label>
                        <input type="text" id="f-Code" name="Input.Code" class="form-control" placeholder="Ej. CD-01" autocomplete="off" required  />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="f-Name">Nombre</label>
                        <input type="text" id="f-Name" name="Input.Name" class="form-control" placeholder="Ej. Centro de distribución" autocomplete="off" required  />
                    </div>
                    <div class="mb-3 span-2">
                        <label class="form-label" for="f-Address">Dirección</label>
                        <input type="text" id="f-Address" name="Input.Address" class="form-control" placeholder="Calle y número" autocomplete="off"   />
                    </div>
                    <div class="mb-3 span-2">
                        <label class="form-label" for="f-CommuneId">Comuna</label>
                        <select id="f-CommuneId" name="Input.CommuneId" class="form-select" >
                            <option value="">— Sin asignar —</option>
                            @foreach (var g in Model.Communes.GroupBy(c => c.RegionName))
                            {
                                <optgroup label="@g.Key">
                                    @foreach (var c in g)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="f-SapWarehouseCode">Bodega SAP</label>
                        <input type="text" id="f-SapWarehouseCode" name="Input.SapWarehouseCode" class="form-control" placeholder="Código de bodega" autocomplete="off"   />
                    </div>
                    <div class="mb-3 d-flex align-items-end ">
                        <label class="d-flex align-items-center gap-2"><input type="checkbox" name="Input.IsActive" value="true" checked /> Activo</label>
                    </div>
                    </div>
                <p class="text-muted">Dirección y comuna salen como origen del traslado en la Res. 154.</p>
                </div>
                <div class="drawer-footer">
                    <button type="button" class="btn btn-secondary" data-drawer-close>Cancelar</button>
                    <button type="submit" class="btn btn-primary" data-submit-label data-label-new="Crear" data-label-edit="Guardar">Crear</button>
                </div>
            </form>
        </aside>
    </div>
}

@section Scripts {
    <script src="~/js/table-tools.js"></script>
    <script src="~/js/despachos-maestros.js" asp-append-version="true"></script>
}
