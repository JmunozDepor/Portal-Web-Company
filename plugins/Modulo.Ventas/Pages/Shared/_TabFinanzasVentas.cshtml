}

<div class="doc-tab-seccion">
    <div class="form-row">
        <div class="form-group form-group-ancho-completo">
            <label asp-for="Input.PaymentTermsGroupCode" class="form-label"></label>
            <select asp-for="Input.PaymentTermsGroupCode" asp-items="Model.PaymentTerms" class="form-select" disabled="@readOnly">
                <option value="">Sin asignar (usa la condición por defecto del cliente)</option>
            </select>
        </div>
    </div>
</div>
