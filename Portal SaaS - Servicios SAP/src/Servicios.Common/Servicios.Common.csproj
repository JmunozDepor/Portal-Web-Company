<Project Sdk="Microsoft.NET.Sdk">

  <!--
    x64 obligatorio: cualquier servicio de esta familia que hable con HANA carga el
    cliente nativo Sap.Data.Hana, que no existe en Any CPU/x86 (mismo criterio que
    PortalSAP_v2 y Proyecto Saas Portal). Servicios.Common no referencia el driver
    directamente, pero cualquier proyecto que lo consuma sí, así que se fija acá para
    que la plataforma nunca quede en manos de la resolución por defecto del SDK.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Servicios.Common</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
