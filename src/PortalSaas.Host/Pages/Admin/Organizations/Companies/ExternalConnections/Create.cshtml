@page "{companyId:guid}"
@model PortalSaas.Host.Pages.Admin.Organizations.Companies.ExternalConnections.CreateModel
@{
    ViewData["Title"] = $"Nueva conexión externa · {Model.Company.Code}";
}

<h1 class="h3 mb-3">Nueva conexión externa en @Model.Company.Code &mdash; @Model.Company.Name</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post" asp-antiforgery="true">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.ModuleCode" class="form-label"></label>
                @if (Model.AvailablePlugins.Count > 0)
                {
                    <select asp-for="Input.ModuleCode" class="form-select" autofocus>
                        <option value="">Seleccionar…</option>
                        @foreach (var plugin in Model.AvailablePlugins)
                        {
                            <option value="@plugin.ModuleCode">@plugin.ModuleCode — @plugin.Name</option>
                        }
                    </select>
                }
                else
                {
                    <p class="text-muted small mb-0">
                        No hay plugins cargados sin conexión configurada para esta compañía todavía.
                    </p>
                }
                <span asp-validation-for="Input.ModuleCode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.EngineType" class="form-label"></label>
                <select asp-for="Input.EngineType" class="form-select" asp-items="Model.EngineTypes.Select(e => new SelectListItem(e, e))"></select>
                <span asp-validation-for="Input.EngineType" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Host" class="form-label"></label>
                <input asp-for="Input.Host" class="form-control" />
                <span asp-validation-for="Input.Host" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Port" class="form-label"></label>
                <input asp-for="Input.Port" class="form-control" />
                <span asp-validation-for="Input.Port" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.DatabaseName" class="form-label"></label>
                <input asp-for="Input.DatabaseName" class="form-control" />
                <span asp-validation-for="Input.DatabaseName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.TechnicalUsername" class="form-label"></label>
                <input asp-for="Input.TechnicalUsername" class="form-control" />
                <span asp-validation-for="Input.TechnicalUsername" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.TechnicalSecretKey" class="form-label"></label>
                <input asp-for="Input.TechnicalSecretKey" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.TechnicalSecretKey" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Crear</button>
            <a asp-page="/Admin/Organizations/Companies/ExternalConnections/Index" asp-route-companyId="@Model.Company.Id" class="btn btn-link">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
