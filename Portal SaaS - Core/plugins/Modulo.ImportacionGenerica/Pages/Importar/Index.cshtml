@page "/importacion-generica/importar"
@using PortalSaas.Abstractions.Modelos
@model Modulo.ImportacionGenerica.Pages.Importar.IndexModel
@{
    ViewData["Title"] = "Importar documentos";
}

<h1 class="h3 mb-3">Importar documentos</h1>

<div asp-validation-summary="All" class="text-danger"></div>

@if (Request.Query["formRetry"] == "1")
{
    @* Ver el middleware "formRetry" de Program.cs: el envío anterior fue rechazado antes
       de procesarse (token del formulario vencido/inválido o límite de tamaño). *@
    <div class="alert alert-warning">
        No se pudo procesar el envío anterior: la página estaba desactualizada o el envío fue rechazado antes de llegar al
        portal. Volvé a elegir el archivo y presioná <strong>Procesar</strong>. Si se repite, avisá a soporte (queda registrado).
    </div>
}

<div class="card-ps doc-tab-seccion mb-4">
    <span class="doc-resumen-total-titulo">Parámetros</span>
    <form method="post" asp-page-handler="Process" enctype="multipart/form-data" asp-antiforgery="true">
        <input type="hidden" asp-for="Input.JobId" />
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Input.Module" class="form-label"></label>
                <select asp-for="Input.Module" asp-items="Model.Modules" class="form-select" onchange="mostrarTipoDocumento(this.value)"></select>
            </div>
            <div class="form-group" id="tipo-doc-sales">
                <label asp-for="Input.SalesDocumentType" class="form-label"></label>
                <select asp-for="Input.SalesDocumentType" asp-items="Model.SalesDocumentTypes" class="form-select">
                    <option value="">Seleccionar…</option>
                </select>
            </div>
            <div class="form-group" id="tipo-doc-purchase" style="display:none">
                <label asp-for="Input.PurchaseDocumentType" class="form-label"></label>
                <select asp-for="Input.PurchaseDocumentType" asp-items="Model.PurchaseDocumentTypes" class="form-select">
                    <option value="">Seleccionar…</option>
                </select>
            </div>
            <div class="form-group" id="tipo-doc-inventory" style="display:none">
                <label asp-for="Input.InventoryDocumentType" class="form-label"></label>
                <select asp-for="Input.InventoryDocumentType" asp-items="Model.InventoryDocumentTypes" class="form-select">
                    <option value="">Seleccionar…</option>
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Input.LineType" class="form-label"></label>
                <select asp-for="Input.LineType" asp-items="Model.LineTypes" class="form-select"></select>
            </div>
            <div class="form-group">
                <label asp-for="Input.BusinessPartnerCardCode" class="form-label"></label>
                <input asp-for="Input.BusinessPartnerCardCode" class="form-control import-business-partner-code" list="import-business-partners-datalist" autocomplete="off" disabled="@Model.BusinessPartnerFromFile" />
                <datalist id="import-business-partners-datalist"></datalist>
                @if (Model.BusinessPartnerFromFile)
                {
                    <div class="form-text text-warning">Carga multi-socio -- dejá este campo vacío, cada fila del Excel trae su propio socio de negocio.</div>
                }
            </div>
            @* Un socio (o el estándar) puede tener varios formatos para la misma
               combinación -- se listan los del socio primero y después los estándar.
               Se recarga por fetch (cargarFormatos, más abajo) al cambiar Módulo, Tipo de
               documento, Tipo de línea o Socio. *@
            <div class="form-group">
                <label asp-for="Input.ConfigId" class="form-label"></label>
                <select asp-for="Input.ConfigId" asp-items="Model.Formats" class="form-select" id="import-format-select">
                    @if (Model.Formats.Count == 0)
                    {
                        <option value="">Sin formatos para esta combinación</option>
                    }
                </select>
            </div>
            @* Vendedor (solo Ventas): siempre visible; editable solo si el formato lo pide en
               pantalla -- en Fijo / Del socio muestra bloqueado el que se usará.
               Vendedor, sucursal y almacén (2026-10-21): texto con sugerencias (<datalist>,
               igual que el socio) en vez de <select>. Son catálogos chicos que ya vienen
               en la página, así que el navegador filtra por código o nombre sin consultar
               al servidor; la sucursal la recarga cargarCabecera al cambiar de cliente. *@
            <div class="form-group" id="import-vendedor-group" style="@(Model.Input.Module == GenericImportModule.Sales ? "" : "display:none")">
                @* Se ve y se escribe el NOMBRE; el código (lo que se envía) va en el oculto
                   Input.SalesPersonCode y lo sincroniza el JS de abajo (data-code). *@
                <label for="import-vendedor-select" class="form-label">Vendedor</label>
                <input type="text" class="form-control" id="import-vendedor-select" list="import-vendedores-datalist" autocomplete="off"
                       placeholder="Sin vendedor" disabled="@(!Model.SalesPersonEditable)"
                       value="@(Model.SalesPersons.FirstOrDefault(s => s.Value == Model.Input.SalesPersonCode?.ToString())?.Text ?? Model.Input.SalesPersonCode?.ToString())" />
                <input type="hidden" asp-for="Input.SalesPersonCode" id="import-vendedor-code" />
                <datalist id="import-vendedores-datalist">
                    @foreach (var vendedor in Model.SalesPersons)
                    {
                        <option value="@vendedor.Text" data-code="@vendedor.Value"></option>
                    }
                </datalist>
                <div class="form-text" id="import-vendedor-modo">@Model.SalesPersonModeLabel</div>
            </div>
        </div>
        @* Sucursal y almacén "en pantalla" (2026-10-21, formato genérico "solo detalle"):
           solo se muestran si el formato elegido los pide; valen para todo el archivo.
           Precargados con los del cliente y recargados por fetch (cargarCabecera). *@
        <div class="form-row">
            <div class="form-group" id="import-sucursal-group" style="@(Model.BranchAskedOnScreen ? "" : "display:none")">
                <label asp-for="Input.ShipToCode" class="form-label"></label>
                <input asp-for="Input.ShipToCode" class="form-control" id="import-sucursal-select"
                       list="import-sucursales-datalist" autocomplete="off" placeholder="Por defecto del cliente" />
                <datalist id="import-sucursales-datalist">
                    @foreach (var sucursal in Model.ShipToOptions)
                    {
                        <option value="@sucursal.Value" label="@sucursal.Text"></option>
                    }
                </datalist>
                <div class="form-text">Dirección de despacho del cliente para todo el archivo; vacío = la de por defecto.</div>
            </div>
            <div class="form-group" id="import-almacen-group" style="@(Model.WarehouseAskedOnScreen ? "" : "display:none")">
                <label asp-for="Input.WarehouseCode" class="form-label"></label>
                <input asp-for="Input.WarehouseCode" class="form-control" id="import-almacen-select"
                       list="import-almacenes-datalist" autocomplete="off" placeholder="Código o nombre del almacén" />
                <datalist id="import-almacenes-datalist">
                    @foreach (var almacen in Model.Warehouses)
                    {
                        <option value="@almacen.Value" label="@almacen.Text"></option>
                    }
                </datalist>
                <div class="form-text">Para todas las líneas; precargado con el almacén del cliente.</div>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group form-group-ancho-completo">
                <label class="form-label">Archivo (.xlsx)</label>
                <input type="file" name="file" class="form-control" accept=".xlsx,.xls" id="import-archivo" />
                @if (Model.LoadedFileName is not null)
                {
                    @* El archivo ya quedó en el servidor (borrador del trabajo): "Volver a analizar"
                       lo reprocesa con los parámetros actuales; elegir otro lo reemplaza. *@
                    <div class="form-text" id="import-archivo-cargado">
                        Archivo cargado: <strong>@Model.LoadedFileName</strong>. Cambiá los parámetros y presioná
                        <strong>Volver a analizar</strong>, sin subirlo de nuevo; elegí otro archivo solo si querés reemplazarlo.
                    </div>
                }
            </div>
        </div>
        <button type="submit" class="btn btn-primary" id="import-procesar">@(Model.LoadedFileName is not null ? "Volver a analizar" : "Procesar (vista previa)")</button>
        @* GET puro (OnGetTemplateAsync ya existe en el codebehind, portado del módulo
           original -- "Formato para importar" según Módulo+Tipo de documento+Tipo de
           línea) -- botón type="button" a propósito, no puede ir dentro de este mismo
           submit porque dispara una descarga, no un POST de Procesar. La URL se arma en
           JS con los valores ACTUALES del formulario (btnDescargarFormato más abajo),
           nunca con un <a href> fijo -- el tipo de documento depende del <select> visible
           según el Módulo elegido (mostrarTipoDocumento). *@
        <button type="button" id="btnDescargarFormato" class="btn btn-outline-secondary">Descargar formato para importar</button>
    </form>
</div>

@if (Model.PreviewResult is not null)
{
    if (!Model.PreviewResult.HasValidConfig)
    {
        <div class="alert alert-warning">@Model.PreviewResult.ErrorMessage</div>
    }
    else
    {
        <div class="card-ps doc-tab-seccion mb-4">
            <partial name="~/Pages/Importar/_ImportacionGenericaVistaPrevia.cshtml" model="Model" />

            @if (Model.PreviewResult.Documents.Any(d => d.CanCreate))
            {
                @* asp-antiforgery="true" NO alcanza acá -- confirmado en vivo (DevTools,
                   Elements): sin asp-page/asp-action/asp-page-handler en el mismo <form>
                   (este es un fetch manual, no un submit real, así que nunca los tuvo),
                   FormTagHelper no emite el <input __RequestVerificationToken> pese al
                   atributo explícito -- causa real del HTTP 400 vacío al confirmar
                   (antiforgery). @Html.AntiForgeryToken() no depende de esa lógica de
                   ruteo, genera el campo oculto siempre. Mismo criterio a futuro para
                   cualquier <form> puramente-fetch sin atributos de ruteo. *@
                <form id="formConfirmar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Input.Module" />
                    <input type="hidden" asp-for="Input.SalesDocumentType" />
                    <input type="hidden" asp-for="Input.PurchaseDocumentType" />
                    <input type="hidden" asp-for="Input.InventoryDocumentType" />
                    <input type="hidden" asp-for="Input.LineType" />
                    <input type="hidden" asp-for="Input.BusinessPartnerCardCode" />
                    <input type="hidden" asp-for="Input.ConfigId" />
                    <input type="hidden" asp-for="Input.SalesPersonCode" />
                    <input type="hidden" asp-for="Input.ShipToCode" />
                    <input type="hidden" asp-for="Input.WarehouseCode" />
                    <input type="hidden" asp-for="Input.JobId" />
                </form>
                <button type="button" class="btn btn-success" id="btnConfirmar">Confirmar creación en SAP</button>
                <div id="progresoConfirmar" class="mt-3" style="display:none">
                    <div class="progress" style="height: 1.5rem">
                        <div id="progresoConfirmarBarra" class="progress-bar" role="progressbar" style="width: 0%">0%</div>
                    </div>
                    <div id="progresoConfirmarMensaje" class="text-muted mt-1 small"></div>
                </div>
            }

            @* Reporte de validación pre-carga -- disponible siempre que haya vista previa,
               no solo cuando hay errores (a diferencia de "Descargar archivo con errores"). *@
            <form method="post" asp-page-handler="DownloadValidationReport" asp-antiforgery="true" class="mt-2 d-inline-block">
                <input type="hidden" asp-for="Input.Module" />
                <input type="hidden" asp-for="Input.SalesDocumentType" />
                <input type="hidden" asp-for="Input.PurchaseDocumentType" />
                <input type="hidden" asp-for="Input.InventoryDocumentType" />
                <input type="hidden" asp-for="Input.LineType" />
                <input type="hidden" asp-for="Input.BusinessPartnerCardCode" />
                <input type="hidden" asp-for="Input.ConfigId" />
                <input type="hidden" asp-for="Input.SalesPersonCode" />
                <input type="hidden" asp-for="Input.ShipToCode" />
                <input type="hidden" asp-for="Input.WarehouseCode" />
                <input type="hidden" asp-for="Input.JobId" />
                <button type="submit" class="btn btn-outline-secondary">Descargar reporte de validación</button>
            </form>

            @if (Model.PreviewResult.Documents.Any(d => !d.CanCreate))
            {
                @* Descarga de archivo = navegación normal, no fetch -- <form> aparte del
                   de Confirmar, con method="post" real (un <a> no puede mandar
                   el Id del trabajo -- descarga por POST). *@
                <form method="post" asp-page-handler="DownloadWithErrors" asp-antiforgery="true" class="mt-2 d-inline-block">
                    <input type="hidden" asp-for="Input.Module" />
                    <input type="hidden" asp-for="Input.SalesDocumentType" />
                    <input type="hidden" asp-for="Input.PurchaseDocumentType" />
                    <input type="hidden" asp-for="Input.InventoryDocumentType" />
                    <input type="hidden" asp-for="Input.LineType" />
                    <input type="hidden" asp-for="Input.BusinessPartnerCardCode" />
                    <input type="hidden" asp-for="Input.ConfigId" />
                    <input type="hidden" asp-for="Input.SalesPersonCode" />
                    <input type="hidden" asp-for="Input.ShipToCode" />
                    <input type="hidden" asp-for="Input.WarehouseCode" />
                    <input type="hidden" asp-for="Input.JobId" />
                    <button type="submit" class="btn btn-outline-secondary">Descargar archivo con errores</button>
                </form>
            }
        </div>
    }
}

<div id="resultadoConfirmar"></div>

<script src="~/js/importacion-resultado.js"></script>
<script>
    // "Confirmar creación en SAP" (2026-10-15): el POST solo deja el trabajo en la cola
    // del servidor y responde al instante con su Id (IndexModel.OnPostConfirmAsync) -- la
    // creación corre en segundo plano (GenericImportJobWorker), así que esta pantalla
    // solo sigue el avance por polling. Cerrar la pestaña NO corta la carga: el resultado
    // queda en "Mis importaciones" y la campana avisa al terminar.
    (function () {
        var btnConfirmar = document.getElementById('btnConfirmar');
        if (!btnConfirmar) {
            return;
        }

        var formConfirmar = document.getElementById('formConfirmar');
        var progresoDiv = document.getElementById('progresoConfirmar');
        var progresoBarra = document.getElementById('progresoConfirmarBarra');
        var progresoMensaje = document.getElementById('progresoConfirmarMensaje');
        var resultadoDiv = document.getElementById('resultadoConfirmar');
        var ir = window.importacionResultado;

        btnConfirmar.addEventListener('click', function () {
            btnConfirmar.disabled = true;
            resultadoDiv.innerHTML = '';
            progresoDiv.style.display = '';
            ir.actualizarBarra(progresoBarra, progresoMensaje, { current: 0, total: 0, message: 'Enviando a la cola…' });

            // new FormData(formConfirmar) ya trae el token antiforgery del form -- no
            // volver a agregarlo (duplicado = 400 vacío, bug real 2026-09-04).
            var formData = new FormData(formConfirmar);

            fetch('?handler=Confirm', { method: 'POST', body: formData })
                // Siempre como texto primero: un 400 de antiforgery (antes del handler)
                // no es JSON, y así se ve el error real en pantalla.
                .then(function (respuesta) {
                    return respuesta.text().then(function (texto) {
                        var data;
                        try {
                            data = JSON.parse(texto);
                        } catch (parseErr) {
                            throw new Error('HTTP ' + respuesta.status + ' ' + respuesta.statusText + ' -- ' + texto.slice(0, 500));
                        }
                        if (!respuesta.ok) {
                            throw new Error(data.message || ('HTTP ' + respuesta.status));
                        }
                        return data;
                    });
                })
                .then(function (encolado) {
                    resultadoDiv.innerHTML = '<div class="alert alert-info mt-3">' + ir.escaparHtml(encolado.message) +
                        ' <a href="' + encolado.reportUrl + '">Ver en Mis importaciones</a></div>';
                    ir.seguir('?handler=Progress&jobId=' + encodeURIComponent(encolado.jobId),
                        function (progreso) { ir.actualizarBarra(progresoBarra, progresoMensaje, progreso); },
                        function (progreso) { ir.renderizar(resultadoDiv, progreso); });
                })
                .catch(function (err) {
                    console.error('Confirmar importación: fallo al encolar', err);
                    progresoDiv.style.display = 'none';
                    btnConfirmar.disabled = false;
                    resultadoDiv.innerHTML = '<div class="alert alert-danger mt-3">No se pudo enviar la importación -- ' +
                        ir.escaparHtml(err.message || 'revisá la conexión e intentá de nuevo.') + '</div>';
                });
            // El botón queda deshabilitado tras encolar: el mismo archivo no se puede
            // volver a enviar (el servidor también lo rechaza).
        });
    })();
</script>

<script>
    function mostrarTipoDocumento(modulo) {
        document.getElementById('tipo-doc-sales').style.display = modulo === 'Sales' ? '' : 'none';
        document.getElementById('tipo-doc-purchase').style.display = modulo === 'Purchase' ? '' : 'none';
        document.getElementById('tipo-doc-inventory').style.display = modulo === 'Inventory' ? '' : 'none';
    }
    mostrarTipoDocumento(document.querySelector('[name="Input.Module"]').value);
</script>

<script>
    // "Descargar formato para importar" -- OnGetTemplateAsync (Index.cshtml.cs) ya
    // existe y genera el .xlsx en base a la configuración vigente para
    // Módulo+Tipo de documento+Tipo de línea (GenericImportService.GenerateTemplateAsync);
    // acá solo faltaba el disparador en la UI. Es un GET puro (sin antiforgery, sin
    // efectos secundarios) -- alcanza con navegar a la URL, no hace falta fetch.
    (function () {
        var btnDescargarFormato = document.getElementById('btnDescargarFormato');
        if (!btnDescargarFormato) {
            return;
        }

        btnDescargarFormato.addEventListener('click', function () {
            var modulo = document.querySelector('[name="Input.Module"]').value;
            // Mismo criterio que mostrarTipoDocumento -- el <select> real depende del
            // Módulo elegido, los otros dos quedan ocultos pero igual existen en el DOM.
            var tipoDocumentoSelectName = modulo === 'Sales' ? 'Input.SalesDocumentType'
                : modulo === 'Purchase' ? 'Input.PurchaseDocumentType'
                : 'Input.InventoryDocumentType';
            var tipoDocumento = document.querySelector('[name="' + tipoDocumentoSelectName + '"]').value;
            var tipoLinea = document.querySelector('[name="Input.LineType"]').value;
            var socio = document.querySelector('[name="Input.BusinessPartnerCardCode"]').value;

            if (!modulo || !tipoDocumento) {
                alert('Elegí Módulo y Tipo de documento antes de descargar el formato.');
                return;
            }

            var params = new URLSearchParams({
                handler: 'Template',
                module: modulo,
                documentType: tipoDocumento,
                lineType: tipoLinea,
            });
            if (socio) {
                params.append('businessPartnerCardCode', socio);
            }
            var formato = document.getElementById('import-format-select').value;
            if (formato) {
                params.append('configId', formato);
            }
            window.location.href = '?' + params.toString();
        });
    })();
</script>

<script>
    // Selector "Formato": un socio (o el estándar) puede tener varios formatos para la
    // misma combinación Módulo+Tipo de documento+Tipo de línea. Se recarga por fetch
    // (OnGetFormatsAsync) cada vez que cambia alguno de esos campos o el Socio -- el
    // render inicial ya viene del servidor (Model.Formats). Conserva la elección
    // actual si sigue disponible, si no queda el primero (mismo que elegiría la
    // resolución automática).
    (function () {
        var select = document.getElementById('import-format-select');
        if (!select) {
            return;
        }
        var timer = null;

        function valor(nombre) {
            var campo = document.querySelector('[name="' + nombre + '"]');
            return campo ? campo.value : '';
        }

        function tipoDocumentoActual(modulo) {
            return valor(modulo === 'Sales' ? 'Input.SalesDocumentType'
                : modulo === 'Purchase' ? 'Input.PurchaseDocumentType'
                : 'Input.InventoryDocumentType');
        }

        function cargarFormatos() {
            var modulo = valor('Input.Module');
            var params = new URLSearchParams({
                handler: 'Formats',
                module: modulo,
                documentType: tipoDocumentoActual(modulo),
                lineType: valor('Input.LineType'),
                businessPartnerCardCode: valor('Input.BusinessPartnerCardCode').trim(),
            });
            var seleccionPrevia = select.value;

            fetch('?' + params.toString())
                .then(function (r) {
                    if (!r.ok) {
                        throw new Error('HTTP ' + r.status + ' cargando formatos');
                    }
                    return r.json();
                })
                .then(function (formatos) {
                    select.innerHTML = '';
                    if (formatos.length === 0) {
                        var vacio = document.createElement('option');
                        vacio.value = '';
                        vacio.textContent = 'Sin formatos para esta combinación';
                        select.appendChild(vacio);
                        cargarCabecera();
                        return;
                    }
                    formatos.forEach(function (f) {
                        var option = document.createElement('option');
                        option.value = f.id;
                        option.textContent = f.label;
                        select.appendChild(option);
                    });
                    if (formatos.some(function (f) { return String(f.id) === seleccionPrevia; })) {
                        select.value = seleccionPrevia;
                    }
                    cargarVendedor();
                    cargarCabecera();
                })
                .catch(function (error) {
                    console.error('Importar: ', error);
                });
        }

        // Vendedor (solo Ventas): valor y bloqueo según el modo del formato elegido --
        // Fijo / Del socio bloqueado con el valor que se usará, "Se pide en pantalla" editable.
        var vendedorGrupo = document.getElementById('import-vendedor-group');
        var vendedorSelect = document.getElementById('import-vendedor-select');
        var vendedorCodigo = document.getElementById('import-vendedor-code');
        var vendedorModo = document.getElementById('import-vendedor-modo');
        // El campo visible muestra el nombre; el código va en el oculto (data-code de la lista).
        function nombreDeVendedor(codigo) {
            var opcion = document.querySelector('#import-vendedores-datalist option[data-code="' + codigo + '"]');
            return opcion ? opcion.value : codigo;
        }
        function cargarVendedor() {
            var esVenta = valor('Input.Module') === 'Sales';
            if (vendedorGrupo) {
                vendedorGrupo.style.display = esVenta ? '' : 'none';
            }
            if (!esVenta || !vendedorSelect) {
                return;
            }
            var params = new URLSearchParams({
                handler: 'SalesPerson',
                configId: select.value || '',
                businessPartnerCardCode: valor('Input.BusinessPartnerCardCode').trim(),
                salesPersonCode: vendedorCodigo.value || '',
            });
            fetch('?' + params.toString())
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (vendedor) {
                    if (!vendedor) {
                        return;
                    }
                    vendedorCodigo.value = vendedor.code == null ? '' : String(vendedor.code);
                    vendedorSelect.value = vendedor.code == null ? '' : nombreDeVendedor(String(vendedor.code));
                    vendedorSelect.disabled = !vendedor.editable;
                    vendedorModo.textContent = vendedor.label;
                })
                .catch(function (error) { console.error('Importar (vendedor): ', error); });
        }
        select.addEventListener('change', cargarVendedor);

        // Sucursal / almacén "en pantalla": visibles solo si el formato los pide. Al cambiar
        // de cliente (partnerChanged) se precargan con los de ese cliente.
        var sucursalGrupo = document.getElementById('import-sucursal-group');
        var sucursalSelect = document.getElementById('import-sucursal-select');
        var almacenGrupo = document.getElementById('import-almacen-group');
        var almacenSelect = document.getElementById('import-almacen-select');
        var socioCargado = valor('Input.BusinessPartnerCardCode').trim();
        function cargarCabecera() {
            if (!sucursalSelect || !almacenSelect) {
                return;
            }
            var socioActual = valor('Input.BusinessPartnerCardCode').trim();
            var socioCambio = socioActual !== socioCargado;
            socioCargado = socioActual;
            var params = new URLSearchParams({
                handler: 'ScreenHeader',
                configId: select.value || '',
                module: valor('Input.Module'),
                lineType: valor('Input.LineType'),
                businessPartnerCardCode: socioActual,
                shipToCode: sucursalSelect.value || '',
                warehouseCode: almacenSelect.value || '',
                partnerChanged: socioCambio ? 'true' : 'false',
            });
            fetch('?' + params.toString())
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (cabecera) {
                    if (!cabecera) {
                        return;
                    }
                    sucursalGrupo.style.display = cabecera.branchAsked ? '' : 'none';
                    // Sugerencias = direcciones de despacho del cliente actual.
                    var sucursales = document.getElementById('import-sucursales-datalist');
                    sucursales.innerHTML = '';
                    (cabecera.shipTos || []).forEach(function (s) {
                        var option = document.createElement('option');
                        option.value = s.code;
                        option.label = s.label;
                        sucursales.appendChild(option);
                    });
                    sucursalSelect.value = cabecera.branchAsked && cabecera.shipToCode ? cabecera.shipToCode : '';

                    // La lista de almacenes viene del render inicial (no depende del cliente).
                    almacenGrupo.style.display = cabecera.warehouseAsked ? '' : 'none';
                    almacenSelect.value = cabecera.warehouseAsked && cabecera.warehouseCode ? cabecera.warehouseCode : '';
                })
                .catch(function (error) { console.error('Importar (cabecera): ', error); });
        }
        select.addEventListener('change', cargarCabecera);

        ['Input.Module', 'Input.SalesDocumentType', 'Input.PurchaseDocumentType', 'Input.InventoryDocumentType', 'Input.LineType']
            .forEach(function (nombre) {
                var campo = document.querySelector('select[name="' + nombre + '"]');
                if (campo) {
                    campo.addEventListener('change', cargarFormatos);
                }
            });

        // Socio: con debounce mientras se tipea (input) y de inmediato al elegir una
        // sugerencia del datalist o salir del campo (change).
        var socio = document.querySelector('input[name="Input.BusinessPartnerCardCode"]');
        if (socio) {
            socio.addEventListener('input', function () {
                clearTimeout(timer);
                timer = setTimeout(cargarFormatos, 500);
            });
            socio.addEventListener('change', function () {
                clearTimeout(timer);
                cargarFormatos();
            });
        }
    })();
</script>

<script>
    // Vendedor / sucursal / almacén con sugerencias: al salir del campo, el valor tiene que
    // ser uno de la lista (se normaliza al código exacto, sin importar mayúsculas). Si no,
    // queda marcado en rojo y no se deja procesar -- evita mandar un código inexistente.
    (function () {
        var campos = ['import-vendedor-select', 'import-sucursal-select', 'import-almacen-select'];

        function validar(input) {
            var lista = document.getElementById(input.getAttribute('list'));
            var texto = input.value.trim();
            var coincidencia = null;
            if (texto && lista) {
                Array.prototype.forEach.call(lista.options, function (o) {
                    if (o.value.toLowerCase() === texto.toLowerCase()) {
                        coincidencia = o;
                    }
                });
            }
            if (coincidencia !== null) {
                input.value = coincidencia.value;
            }
            // Vendedor: el código del elegido va al campo oculto que se envía.
            if (input.id === 'import-vendedor-select' && !input.disabled) {
                document.getElementById('import-vendedor-code').value = coincidencia ? coincidencia.dataset.code : '';
            }
            var valido = !texto || input.disabled || input.closest('.form-group').style.display === 'none' || coincidencia !== null;
            input.classList.toggle('is-invalid', !valido);
            return valido;
        }

        campos.forEach(function (id) {
            var input = document.getElementById(id);
            if (input) {
                input.addEventListener('change', function () { validar(input); });
            }
        });

        var form = document.querySelector('form[enctype="multipart/form-data"]');
        if (form) {
            form.addEventListener('submit', function (evento) {
                var invalidos = campos.map(function (id) { return document.getElementById(id); })
                    .filter(function (input) { return input && !validar(input); });
                if (invalidos.length > 0) {
                    evento.preventDefault();
                    invalidos[0].focus();
                    alert('Elegí un valor de la lista de sugerencias (o dejalo vacío).');
                }
            });
        }
    })();
</script>

<script>
    // Con un archivo ya cargado, elegir otro cambia el botón de vuelta a "Procesar".
    (function () {
        var archivo = document.getElementById('import-archivo');
        var boton = document.getElementById('import-procesar');
        var aviso = document.getElementById('import-archivo-cargado');
        if (!archivo || !boton || !aviso) {
            return;
        }
        archivo.addEventListener('change', function () {
            var nuevo = archivo.files && archivo.files.length > 0;
            boton.textContent = nuevo ? 'Procesar (vista previa)' : 'Volver a analizar';
            aviso.style.display = nuevo ? 'none' : '';
        });
    })();
</script>

<script src="~/js/catalog-search.js"></script>
<script>
    // Proveedor si el Módulo elegido es Compra, Cliente en cualquier otro caso (Venta/
    // Inventario) -- ver el comentario completo en OnGetSearchBusinessPartnersAsync.
    wireCatalogSearch({
        inputSelector: '.import-business-partner-code',
        datalistId: 'import-business-partners-datalist',
        handlerName: 'SearchBusinessPartners',
        minChars: 2,
        extraParams: function () { return { module: document.querySelector('[name="Input.Module"]').value }; },
        getValue: function (item) { return item.cardCode; },
        getLabel: function (item) { return item.cardCode + ' — ' + item.cardName; },
    });
</script>
