@page "/importacion-generica/configuracion"
@model Modulo.ImportacionGenerica.Pages.Configuracion.IndexModel
@using PortalSaas.Abstractions.Modelos
@{
    ViewData["Title"] = "Configuración de Importación Genérica";

    string RuleLabel(GenericImportValidationRuleType type) => type switch
    {
        GenericImportValidationRuleType.CustomerActiveInSap => "Cliente/Proveedor activo en SAP",
        GenericImportValidationRuleType.ItemActiveInSap => "Artículo activo en SAP",
        GenericImportValidationRuleType.PriceVsFixedList => "Precio vs. lista fija",
        GenericImportValidationRuleType.PriceVsCustomerList => "Precio vs. lista del cliente",
        GenericImportValidationRuleType.StockAvailable => "Stock disponible (agregado del lote)",
        GenericImportValidationRuleType.CustomerBranchValid => "Sucursal pertenece al cliente",
        _ => type.ToString(),
    };
}

<h1 class="h3 mb-3">Configuración de Importación Genérica</h1>
<p class="text-muted">
    Una configuración sin Socio de negocio es el formato ESTÁNDAR de la organización para ese
    Módulo+Tipo de documento+Tipo de línea. Una configuración con Socio de negocio es la
    excepción de un cliente/proveedor puntual cuyo archivo no sigue el estándar.
</p>

@if (Model.SuccessMessage is not null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (!Model.MostrarFormulario)
{
    <div class="mb-3">
        <a asp-page="/Configuracion/Index" asp-route-nuevo="true" class="btn btn-primary">Nueva configuración</a>
    </div>
}

@if (Model.MostrarFormulario)
{
    <div class="card-ps doc-tab-seccion mb-4">
        <span class="doc-resumen-total-titulo">@(Model.EditId is null ? "Nueva configuración" : "Editar configuración")</span>
        <form method="post" asp-page-handler="Save" asp-antiforgery="true">
        @* EditId/CopyId/Nuevo como campos ocultos, no route values -- así viajan también en
           los postbacks de "Agregar campo"/"Quitar campo" (que usan formaction propio en el
           <button>, pisando cualquier asp-route-* puesto en el <form>). Sin esto, tocar un
           campo de usuario en medio de una edición perdía el EditId y el panel se cerraba
           solo en el siguiente render (MostrarFormulario en false). *@
        <input type="hidden" asp-for="EditId" />
        <input type="hidden" asp-for="CopyId" />
        <input type="hidden" asp-for="Nuevo" />
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Input.Module" class="form-label"></label>
                <select asp-for="Input.Module" asp-items="Model.Modules" class="form-select" disabled="@(Model.EditId is not null)" onchange="mostrarTipoDocumentoConfig(this.value)"></select>
                @* Mismo problema que los 3 <select> de Tipo de documento de abajo -- disabled
                   durante edición, así que sin este oculto Input.Module volvía como el default
                   del enum (Sales) en el POST, y la propiedad calculada DocumentType miraba
                   SalesDocumentType en vez del módulo real (ej. Inventory), reproduciendo el
                   mismo error "Elegí un tipo de documento." aunque el fix de los 3 selects de
                   tipo ya estuviera aplicado. *@
                @if (Model.EditId is not null)
                {
                    <input type="hidden" asp-for="Input.Module" />
                }
            </div>
            @* Un <select> por Módulo, filtrado por CanCreateAsync -- antes era texto libre
               ("ej. SalesOrder, PurchaseQuotation, StockTransfer"), lo que dejaba tipear un
               nombre inválido (bug real: "StockTranfer", typo, guardado sin error pero
               ResolveAsync nunca lo iba a encontrar). JS muestra solo el que corresponde al
               Módulo elegido, mismo patrón que Pages/Importar/Index.cshtml. *@
            <div class="form-group" id="config-tipo-doc-sales">
                <label class="form-label">Tipo de documento</label>
                <select asp-for="Input.SalesDocumentType" asp-items="Model.SalesDocumentTypes" class="form-select" disabled="@(Model.EditId is not null)">
                    <option value="">Seleccionar…</option>
                </select>
                @* Un <select disabled> nunca viaja en el POST -- sin este oculto, editar una
                   configuración perdía el tipo de documento al guardar (llegaba vacío,
                   "Elegí un tipo de documento." pese a verse seleccionado en pantalla).
                   Mismo criterio que EditId/CopyId/Nuevo más arriba. *@
                @if (Model.EditId is not null)
                {
                    <input type="hidden" asp-for="Input.SalesDocumentType" />
                }
                <span asp-validation-for="Input.DocumentType" class="text-danger"></span>
            </div>
            <div class="form-group" id="config-tipo-doc-purchase" style="display:none">
                <label class="form-label">Tipo de documento</label>
                <select asp-for="Input.PurchaseDocumentType" asp-items="Model.PurchaseDocumentTypes" class="form-select" disabled="@(Model.EditId is not null)">
                    <option value="">Seleccionar…</option>
                </select>
                @if (Model.EditId is not null)
                {
                    <input type="hidden" asp-for="Input.PurchaseDocumentType" />
                }
            </div>
            <div class="form-group" id="config-tipo-doc-inventory" style="display:none">
                <label class="form-label">Tipo de documento</label>
                <select asp-for="Input.InventoryDocumentType" asp-items="Model.InventoryDocumentTypes" class="form-select" disabled="@(Model.EditId is not null)">
                    <option value="">Seleccionar…</option>
                </select>
                @if (Model.EditId is not null)
                {
                    <input type="hidden" asp-for="Input.InventoryDocumentType" />
                }
            </div>
            <div class="form-group">
                <label asp-for="Input.LineType" class="form-label"></label>
                <select asp-for="Input.LineType" asp-items="Model.LineTypes" class="form-select" disabled="@(Model.EditId is not null)"></select>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Input.Alias" class="form-label"></label>
                <input asp-for="Input.Alias" class="form-control" />
                <span asp-validation-for="Input.Alias" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.BusinessPartnerCardCode" class="form-label"></label>
                @if (Model.EditId is not null)
                {
                    <input asp-for="Input.BusinessPartnerCardCode" class="form-control" disabled />
                }
                else
                {
                    <input asp-for="Input.BusinessPartnerCardCode" class="form-control import-config-business-partner-code" list="import-config-business-partners-datalist" autocomplete="off" />
                    <datalist id="import-config-business-partners-datalist"></datalist>
                }
            </div>
            <div class="form-group">
                <label asp-for="Input.GroupingColumn" class="form-label"></label>
                <input asp-for="Input.GroupingColumn" class="form-control" placeholder="ej. A" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group form-check">
                <input asp-for="Input.SkuIsCustomerOwn" class="form-check-input" />
                <label asp-for="Input.SkuIsCustomerOwn" class="form-check-label"></label>
            </div>
            <div class="form-group form-check">
                <input asp-for="Input.BusinessPartnerFromFile" class="form-check-input" />
                <label asp-for="Input.BusinessPartnerFromFile" class="form-check-label"></label>
            </div>
            @if (Model.EditId is not null)
            {
                <div class="form-group form-check">
                    <input asp-for="Input.IsActive" class="form-check-input" />
                    <label asp-for="Input.IsActive" class="form-check-label"></label>
                </div>
            }
        </div>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Input.PriceSource" class="form-label"></label>
                <select asp-for="Input.PriceSource" asp-items="Model.PriceSources" class="form-select"></select>
            </div>
            <div class="form-group">
                <label asp-for="Input.SystemPriceListCode" class="form-label"></label>
                <input asp-for="Input.SystemPriceListCode" type="number" class="form-control" />
            </div>
        </div>

        <h5 class="mt-4">Campos núcleo</h5>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Campo</th>
                    <th>Columna Excel</th>
                    <th>Obligatorio</th>
                    <th>Valor fijo</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Input.Fields.Count; i++)
                {
                    var field = Model.Input.Fields[i];
                    <tr>
                        <td>
                            @field.LogicalField
                            <input type="hidden" name="Input.Fields[@i].LogicalField" value="@field.LogicalField" />
                        </td>
                        <td><input name="Input.Fields[@i].ExcelColumn" value="@field.ExcelColumn" class="form-control form-control-sm" style="max-width:80px" /></td>
                        <td><input type="checkbox" name="Input.Fields[@i].IsRequired" value="true" class="form-check-input" checked="@field.IsRequired" /><input type="hidden" name="Input.Fields[@i].IsRequired" value="false" /></td>
                        <td><input name="Input.Fields[@i].FixedValue" value="@field.FixedValue" class="form-control form-control-sm" /></td>
                    </tr>
                }
            </tbody>
        </table>

        <h5 class="mt-4">Campos de usuario</h5>
        <p class="text-muted small">Sin límite de filas -- "Agregar campo" suma otra, "Quitar" saca esa puntual.</p>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Campo de usuario</th>
                    <th>Columna Excel</th>
                    <th>Obligatorio</th>
                    <th>Valor fijo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Input.UserFieldMappings.Count; i++)
                {
                    var mapping = Model.Input.UserFieldMappings[i];
                    <tr>
                        <td>
                            <select name="Input.UserFieldMappings[@i].UserFieldId" class="form-select form-select-sm">
                                <option value="">Sin asignar</option>
                                @foreach (var option in Model.UserFieldOptions)
                                {
                                    <option value="@option.Value" selected="@(option.Value == mapping.UserFieldId?.ToString())">@option.Text</option>
                                }
                            </select>
                        </td>
                        <td><input name="Input.UserFieldMappings[@i].ExcelColumn" value="@mapping.ExcelColumn" class="form-control form-control-sm" style="max-width:80px" /></td>
                        <td><input type="checkbox" name="Input.UserFieldMappings[@i].IsRequired" value="true" class="form-check-input" checked="@mapping.IsRequired" /><input type="hidden" name="Input.UserFieldMappings[@i].IsRequired" value="false" /></td>
                        <td><input name="Input.UserFieldMappings[@i].FixedValue" value="@mapping.FixedValue" class="form-control form-control-sm" placeholder="(opcional)" /></td>
                        <td>
                            @* asp-page-handler puesto directo en el <button>, no en el <form> -- FormActionTagHelper
                               genera un formaction que pisa la acción de ESTE submit puntual sin tocar el resto
                               del formulario (mismo criterio que el original, ver el doc-comment de la clase). *@
                            <button type="submit" asp-page-handler="QuitarCampoUsuario" asp-route-index="@i" class="btn btn-sm btn-outline-danger">Quitar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <button type="submit" asp-page-handler="AgregarCampoUsuario" class="btn btn-sm btn-outline-secondary mb-3">Agregar campo</button>

        <h5 class="mt-4">Reglas de validación</h5>
        <p class="text-muted small">Corren sobre la vista previa antes de confirmar la carga a SAP. En modo Alerta nunca bloquean; en modo Bloqueante mandan la fila a Errores. "Cantidad &gt; 0" y "Descuento 0-100" son estructurales -- siempre activas, no se configuran acá.</p>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Regla</th>
                    <th>Activa</th>
                    <th>Severidad</th>
                    <th>Parámetros</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Input.ValidationRules.Count; i++)
                {
                    var rule = Model.Input.ValidationRules[i];
                    var hasParams = rule.RuleType is GenericImportValidationRuleType.PriceVsFixedList
                        or GenericImportValidationRuleType.PriceVsCustomerList
                        or GenericImportValidationRuleType.StockAvailable;
                    <tr>
                        <td>
                            @RuleLabel(rule.RuleType)
                            <input type="hidden" name="Input.ValidationRules[@i].RuleType" value="@rule.RuleType" />
                        </td>
                        <td>
                            <input type="checkbox" name="Input.ValidationRules[@i].IsActive" value="true" class="form-check-input" checked="@rule.IsActive" data-toggle-params="params-@i" />
                            <input type="hidden" name="Input.ValidationRules[@i].IsActive" value="false" />
                        </td>
                        <td>
                            <select name="Input.ValidationRules[@i].Severity" class="form-select form-select-sm">
                                <option value="@GenericImportValidationSeverity.Warning" selected="@(rule.Severity == GenericImportValidationSeverity.Warning)">Alerta</option>
                                <option value="@GenericImportValidationSeverity.Block" selected="@(rule.Severity == GenericImportValidationSeverity.Block)">Bloqueante</option>
                            </select>
                        </td>
                        <td id="params-@i" style="@(rule.IsActive && hasParams ? "" : "display:none")">
                            @if (rule.RuleType == GenericImportValidationRuleType.PriceVsFixedList)
                            {
                                <label class="form-label small mb-0">N° Lista de precio</label>
                                <input type="number" name="Input.ValidationRules[@i].PriceListNum" value="@rule.PriceListNum" class="form-control form-control-sm" style="max-width:110px" />
                            }
                            @if (hasParams)
                            {
                                <label class="form-label small mb-0">Tolerancia %</label>
                                <input type="number" step="0.01" name="Input.ValidationRules[@i].TolerancePercent" value="@rule.TolerancePercent" class="form-control form-control-sm" style="max-width:110px" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-primary">@(Model.EditId is null ? "Crear" : "Guardar")</button>
        <a asp-page="/Configuracion/Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
    </div>

    <script>
        // Muestra solo el <select> de Tipo de documento que corresponde al Módulo elegido
        // -- mismo patrón que Pages/Importar/Index.cshtml (mostrarTipoDocumento).
        function mostrarTipoDocumentoConfig(modulo) {
            document.getElementById('config-tipo-doc-sales').style.display = modulo === 'Sales' ? '' : 'none';
            document.getElementById('config-tipo-doc-purchase').style.display = modulo === 'Purchase' ? '' : 'none';
            document.getElementById('config-tipo-doc-inventory').style.display = modulo === 'Inventory' ? '' : 'none';
        }
        mostrarTipoDocumentoConfig(document.querySelector('[name="Input.Module"]').value);

        // Muestra la celda de parámetros de una regla solo mientras esté activa.
        document.querySelectorAll('input[data-toggle-params]').forEach(function (checkbox) {
            checkbox.addEventListener('change', function () {
                var cell = document.getElementById(checkbox.dataset.toggleParams);
                if (cell) {
                    cell.style.display = checkbox.checked ? '' : 'none';
                }
            });
        });
    </script>

    @if (Model.EditId is null)
    {
        <script src="~/js/catalog-search.js"></script>
        <script>
            // Ver el comentario completo en Pages/Importar/Index.cshtml, mismo criterio
            // (Cliente si Módulo=Venta, Proveedor en cualquier otro caso).
            wireCatalogSearch({
                inputSelector: '.import-config-business-partner-code',
                datalistId: 'import-config-business-partners-datalist',
                handlerName: 'SearchBusinessPartners',
                minChars: 2,
                extraParams: function () { return { module: document.querySelector('[name="Input.Module"]').value }; },
                getValue: function (item) { return item.cardCode; },
                getLabel: function (item) { return item.cardCode + ' — ' + item.cardName; },
            });
        </script>
    }
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Alias</th>
            <th>Módulo</th>
            <th>Tipo de documento</th>
            <th>Tipo de línea</th>
            <th>Socio de negocio</th>
            <th>Activo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var config in Model.Configs)
        {
            <tr>
                <td>@config.Alias</td>
                <td>@config.Module</td>
                <td>@config.DocumentType</td>
                <td>@config.LineType</td>
                <td>@(config.BusinessPartnerCardCode ?? "Estándar")</td>
                <td>@(config.IsActive ? "Sí" : "No")</td>
                <td>
                    <a asp-page="/Configuracion/Index" asp-route-editId="@config.Id">Editar</a>
                    ·
                    <a asp-page="/Configuracion/Index" asp-route-copyId="@config.Id">Copiar</a>
                    <form method="post" asp-page-handler="Delete" asp-antiforgery="true" style="display:inline" onsubmit="return confirm('¿Eliminar esta configuración?');">
                        <input type="hidden" name="id" value="@config.Id" />
                        <button type="submit" class="btn btn-sm btn-link text-danger p-0 ms-2">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Configs.Count == 0)
{
    <p class="text-muted">Todavía no hay configuraciones -- un archivo se puede igual descargar/importar con el layout genérico por defecto.</p>
}
