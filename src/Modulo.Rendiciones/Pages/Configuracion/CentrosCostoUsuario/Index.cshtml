@page "/rendiciones/configuracion/centros-costo-usuario"
@model Modulo.Rendiciones.Pages.Configuracion.CentrosCostoUsuario.IndexModel
@{
    ViewData["Title"] = "Centros de Costo por Usuario";
}
@section Styles {
    <link rel="stylesheet" href="~/css/rendiciones.css" asp-append-version="true" />
}

<div class="card-ps admin-card">
    <div class="admin-card-header">
        <h2>Centros de Costo por Usuario</h2>
    </div>

@if (Model.SuccessMessage is not null)
{
    <div class="admin-alert admin-alert-success">@Model.SuccessMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="admin-alert admin-alert-danger">@Model.ErrorMessage</div>
}

<p class="admin-muted">
    Sin ninguna asignación acá, el colaborador ve el catálogo completo de centros de
    costo de SAP al declarar gastos o fondos. Asigná acá solo si necesitás acotarlo.
</p>

<table class="admin-table">
    <thead><tr><th>Usuario</th><th>Correo</th><th>Centros asignados</th><th class="admin-col-accion"></th></tr></thead>
    <tbody>
        @foreach (var u in Model.Users)
        {
            <tr class="@(u.Id.ToString() == Model.UserId ? "admin-fila-activa" : "")">
                <td>@u.Username</td>
                <td>@u.Email</td>
                <td>@Model.AssignedCountByUserId.GetValueOrDefault(u.Id, 0)</td>
                <td class="admin-col-accion">
                    <a asp-page="./Index" asp-route-UserId="@u.Id" class="admin-link-action">Editar</a>
                </td>
            </tr>
        }
        @if (Model.Users.Count == 0)
        {
            <tr><td colspan="4" class="admin-muted">Sin usuarios en esta organización.</td></tr>
        }
    </tbody>
</table>

@if (Model.UserId is { Length: > 0 })
{
    <div class="admin-subcard">
        <h3>Asignados a @Model.SelectedUserName</h3>
        <p class="admin-muted"><a asp-page="./Index" class="admin-link-action">‹ Volver al listado</a></p>
        <table class="admin-table">
            <thead><tr><th>Código</th><th>Nombre</th><th class="admin-col-accion"></th></tr></thead>
            <tbody>
                @foreach (var a in Model.Assigned)
                {
                    <tr>
                        <td>@a.CostCenterCode</td>
                        <td>@a.CostCenterName</td>
                        <td class="admin-col-accion">
                            <form asp-page="./Index" asp-page-handler="Quitar" asp-route-id="@a.Id" asp-route-UserId="@Model.UserId" method="post">
                                <button type="submit" class="btn-module-action btn-module-danger">Quitar</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Assigned.Count == 0)
                {
                    <tr><td colspan="3" class="admin-muted">Sin asignaciones -- usa el catálogo completo de SAP.</td></tr>
                }
            </tbody>
        </table>

        <form asp-page="./Index" asp-page-handler="Asignar" asp-route-UserId="@Model.UserId" method="post" class="admin-form-asignar">
            <div class="form-group">
                <label asp-for="SelectedCostCenterCode">Agregar centro de costo</label>
                <select asp-for="SelectedCostCenterCode" class="form-control">
                    <option value="">-- Seleccionar --</option>
                    @foreach (var c in Model.SapCostCenters)
                    {
                        <option value="@c.Code">@c.Code - @c.Name</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn-module-action">+ Asignar</button>
        </form>
    </div>
}
</div>
