@page "/auditoria-inventario/configuracion-captura"
@model Modulo.AuditoriaInventario.Pages.ConfiguracionCaptura.IndexModel
@{
    ViewData["Title"] = "Configuración de Captura";
}

<div class="card-surface">
    <h2 class="mb-1">Configuración de Captura</h2>
    <p class="text-muted mb-3">
        Formatos de código de barra que la PWA acepta al escanear. Un escaneo que no
        cumpla ninguno de los formatos habilitados se rechaza en el equipo -- con aviso
        y sonido -- antes de guardarse como captura.
    </p>

    @if (Model.SuccessMessage is not null)
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div class="mb-2 form-check">
            <input asp-for="Input.AllowEan8" type="checkbox" class="form-check-input" />
            <label asp-for="Input.AllowEan8" class="form-check-label">EAN-8 (8 dígitos)</label>
        </div>
        <div class="mb-2 form-check">
            <input asp-for="Input.AllowUpcA" type="checkbox" class="form-check-input" />
            <label asp-for="Input.AllowUpcA" class="form-check-label">UPC-A (12 dígitos)</label>
        </div>
        <div class="mb-3 form-check">
            <input asp-for="Input.AllowEan13" type="checkbox" class="form-check-input" />
            <label asp-for="Input.AllowEan13" class="form-check-label">EAN-13 (13 dígitos)</label>
        </div>
        <button type="submit" class="btn btn-primary">Guardar</button>
    </form>
</div>

<div class="card-surface mt-4">
    <h2 class="mb-1">Conectar equipo</h2>
    <p class="text-muted mb-3">
        Escaneá este código desde el lector del equipo para abrir la PWA de captura
        directo, sin tipear la URL a mano en el teclado físico.
    </p>

    <form method="post" asp-page-handler="GuardarUrl" class="mb-3 d-flex gap-2 align-items-end flex-wrap">
        <div class="flex-grow-1" style="min-width: 16rem;">
            <label asp-for="UrlInput.PwaUrl" class="form-label">URL pública de la PWA</label>
            <input asp-for="UrlInput.PwaUrl" class="form-control" placeholder="https://pwa.midominio.cl" />
        </div>
        <button type="submit" class="btn btn-primary">Guardar URL</button>
    </form>

    @if (Model.QrCodeBase64 is not null)
    {
        <div class="d-flex align-items-center gap-4 flex-wrap">
            <img src="data:image/png;base64,@Model.QrCodeBase64" alt="QR de conexión a la PWA" style="width: 200px; height: 200px;" />
            <div>
                <p class="text-muted mb-1">O escribila a mano en el navegador del equipo:</p>
                <code>@Model.UrlInput.PwaUrl</code>
            </div>
        </div>
    }
    else
    {
        <p class="text-muted">Guardá la URL de arriba para generar el código QR.</p>
    }
</div>
