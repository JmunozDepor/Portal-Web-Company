@page "{id:long}"
@model PortalSaas.Host.Pages.Admin.Organizations.Licenses.EditModel
@{
    ViewData["Title"] = $"Editar licencia · {Model.Organization.LegalName}";
}

<h1 class="h3 mb-3">Editar licencia de @Model.Organization.LegalName</h1>
<p class="text-muted">Clave de activación: <code>@Model.ActivationKey</code> (no se cambia acá).</p>

<div class="row">
    <div class="col-md-6">
        <form method="post" asp-antiforgery="true">
            <input type="hidden" asp-for="Input.Id" />
            <input type="hidden" asp-for="Input.OrganizationId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.PlanId" class="form-label"></label>
                <select asp-for="Input.PlanId" class="form-select" asp-items="Model.Plans"></select>
                <span asp-validation-for="Input.PlanId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Status" class="form-label"></label>
                <select asp-for="Input.Status" class="form-select" asp-items="PortalSaas.Data.Entities.OnPremiseLicenseStatus.All.Select(s => new SelectListItem(s, s))"></select>
                <span asp-validation-for="Input.Status" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.ExpiresAt" class="form-label"></label>
                <input asp-for="Input.ExpiresAt" type="date" class="form-control" />
                <span asp-validation-for="Input.ExpiresAt" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.InstallationFingerprint" class="form-label"></label>
                <input asp-for="Input.InstallationFingerprint" class="form-control" />
                <span asp-validation-for="Input.InstallationFingerprint" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-page="/Admin/Organizations/Licenses/Index" asp-route-organizationId="@Model.Organization.Id" class="btn btn-link">Cancelar</a>
        </form>
    </div>
</div>
