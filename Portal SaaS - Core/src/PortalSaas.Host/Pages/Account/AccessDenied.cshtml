@page
@model PortalSaas.Host.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Sin permiso";
}

<div class="card-ps" style="max-width:600px;">
    <h1 class="h5 mb-2"><i class="bi bi-shield-lock"></i> No tienes permiso para abrir esta opción</h1>
    <p class="text-muted mb-3">
        Tu sesión sigue activa: solo falta que un administrador te asigne un perfil con acceso
        a esta opción en la compañía con la que estás conectado.
    </p>
    <a href="~/Home/Index" class="btn btn-primary">Volver al inicio</a>
</div>
