@page "/despachos/guias-manuales/detalle"
@model Modulo.Despachos.Pages.Despachos.GuiasManuales.DetalleModel
@section Styles {
    <link rel="stylesheet" href="~/css/despachos.css" asp-append-version="true" />
}
@using System.Globalization
@{
    ViewData["Title"] = Model.Code;
    var g = Model.G;
    var i = Model.Input;
    var es = new CultureInfo("es-CL");
    var t = i.Transport;
}
@* Guía manual: en borrador se edita, se agrega a un manifiesto (escaneando el código GM-) o se emite sola. *@

<div class="card-surface">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-3 flex-wrap">
        <h2 class="mb-0">Guía manual @Model.Code <partial name="/Pages/Despachos/Shared/_EstadoGuia.cshtml" model="g.Status" /></h2>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-secondary" href="~/despachos/guias-manuales">Volver</a>
            @if (Model.CanEdit && Model.IsEditable)
            {
                <a class="btn btn-secondary" href="~/despachos/guias-manuales/editar?id=@g.Id"><i class="bi bi-pencil"></i> Editar</a>
            }
            @if (g.Status == TransportGuideStatuses.Issued)
            {
                <a class="btn btn-primary" target="_blank" rel="noopener" href="~/despachos/guias-manuales/detalle?id=@g.Id&handler=Pdf"><i class="bi bi-printer"></i> PDF de la guía</a>
            }
            else if (g.Status != TransportGuideStatuses.Annulled)
            {
                <a class="btn btn-secondary" target="_blank" rel="noopener" href="~/despachos/guias-manuales/detalle?id=@g.Id&handler=BorradorPdf"><i class="bi bi-file-earmark-pdf"></i> PDF borrador</a>
                @if (Model.CanCreate && Model.CanEmitNow)
                {
                    <form method="post" asp-page-handler="Emitir" asp-route-id="@g.Id" asp-antiforgery="true" class="d-inline-block"
                          data-confirm="@($"¿Emitir la guía {Model.Code} ante el SII? No se puede deshacer.")">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Emitir</button>
                    </form>
                }
            }
        </div>
    </div>

    @if (Model.SuccessMessage is not null)
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (Model.WarningMessage is not null)
    {
        <div class="alert alert-warning">@Model.WarningMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    @if (g.Status == TransportGuideStatuses.Failed && g.LastError is not null)
    {
        <div class="alert alert-danger">Rechazada por el proveedor: @g.LastError. Corrija la guía y vuelva a emitirla.</div>
    }
    @if (g.Status == TransportGuideStatuses.InManifest)
    {
        <div class="alert alert-warning">Esta guía viaja en un manifiesto: se emite al despacharlo, con el transporte del manifiesto.</div>
    }

    @* Mismo orden que el formulario: receptor, destino, fechas y condiciones, transporte, observaciones y detalle. *@
    <div class="row g-3 align-items-center mb-1">
        <div class="col-12 col-md-6 col-xl-3"><span class="text-muted">Folio</span><div><strong>@(g.Folio?.ToString(CultureInfo.InvariantCulture) ?? "—")</strong></div></div>
        <div class="col-12 col-md-6 col-xl-3"><span class="text-muted">Total</span><div><strong>$@((g.TotalAmount ?? 0).ToString("N0", es))</strong> <span class="text-muted">(neto $@((g.NetAmount ?? 0).ToString("N0", es)) + IVA $@((g.VatAmount ?? 0).ToString("N0", es)))</span></div></div>
        @if (g.AnnulReason is not null)
        {
            <div class="col-12 col-xl-6"><span class="text-muted">Motivo de anulación</span><div>@g.AnnulReason</div></div>
        }
        @if (g.Status is TransportGuideStatuses.Draft or TransportGuideStatuses.InManifest)
        {
            <div class="col-12 col-xl-6">
                <img src="~/despachos/guias-manuales/detalle?id=@g.Id&handler=Codigo" alt="@Model.Code" style="max-width:100%;height:auto;" />
                <div class="text-muted">Escanee o digite <strong>@Model.Code</strong> en el manifiesto para que viaje en él.</div>
            </div>
        }
    </div>

    <div class="doc-form-layout-section border-top pt-3 mt-3 mb-2">1. Receptor</div>
    <div class="row g-3">
        <div class="col-12 col-md-6 col-xl-3"><span class="text-muted">RUT</span><div>@i.ReceiverTaxId @(i.ReceiverCardCode is { } cc ? $"(SAP {cc})" : "")</div></div>
        <div class="col-12 col-md-12 col-xl-6"><span class="text-muted">Razón social</span><div>@i.ReceiverName</div></div>
        <div class="col-12 col-md-6 col-xl-3"><span class="text-muted">Giro</span><div>@(i.ReceiverActivity ?? "—")</div></div>
        <div class="col-12 col-md-12 col-xl-6"><span class="text-muted">Dirección</span><div>@i.ReceiverAddress</div></div>
        <div class="col-12 col-md-6 col-xl-3"><span class="text-muted">Comuna</span><div>@i.ReceiverCommune</div></div>
        <div class="col-12 col-md-6 col-xl-3"><span class="text-muted">Ciudad</span><div>@(i.ReceiverCity ?? "—")</div></div>
    </div>

    <div class="doc-form-layout-section border-top pt-3 mt-3 mb-2">2. Destino</div>
    <div class="row g-3">
        <div class="col-12 col-md-12 col-xl-6"><span class="text-muted">Dirección de destino</span><div>@i.DestinationAddress</div></div>
        <div class="col-12 col-md-6 col-xl-3"><span class="text-muted">Comuna de destino</span><div>@i.DestinationCommune</div></div>
        <div class="col-12 col-md-6 col-xl-3"><span class="text-muted">Ciudad de destino</span><div>@(i.DestinationCity ?? "—")</div></div>
    </div>

    <div class="doc-form-layout-section border-top pt-3 mt-3 mb-2">3. Fechas y condiciones</div>
    <div class="row g-3">
        <div class="col-12 col-md-6 col-xl-3"><span class="text-muted">Fecha de emisión</span><div>@i.IssueDate.ToString("dd-MM-yyyy", CultureInfo.InvariantCulture)</div></div>
        <div class="col-12 col-md-6 col-xl-3"><span class="text-muted">Motivo de traslado</span><div>@TransferIndicators.Label(i.TransferIndicator)</div></div>
        <div class="col-12 col-md-6 col-xl-3"><span class="text-muted">Tipo de despacho</span><div>@DispatchTypes.Label(i.DispatchType)</div></div>
        <div class="col-12 col-md-6 col-xl-3"><span class="text-muted">Referencia</span><div>@(i.References.Count > 0 ? string.Join("; ", i.References.Select(r => $"{r.DocumentType} N° {r.Folio}")) : "—")</div></div>
        @if (i.TransportMode != ManualTransportModes.Manifest)
        {
            <div class="col-12 col-md-6 col-xl-3"><span class="text-muted">Salida</span><div>@(t?.DepartureDate?.ToString("dd-MM-yyyy", CultureInfo.InvariantCulture) ?? "—") @(t?.DepartureTime?.ToString("HH:mm", CultureInfo.InvariantCulture))</div></div>
            <div class="col-12 col-md-6 col-xl-3"><span class="text-muted">Llegada estimada</span><div>@(t?.ArrivalDate?.ToString("dd-MM-yyyy", CultureInfo.InvariantCulture) ?? "—")</div></div>
        }
    </div>

    <div class="doc-form-layout-section border-top pt-3 mt-3 mb-2">4. Transporte (Res. 154)</div>
    @if (i.TransportMode == ManualTransportModes.Manifest)
    {
        <p class="text-muted mb-0">Del manifiesto en el que viaja (se toma al despacharlo).</p>
    }
    else
    {
        <div class="row g-3">
            <div class="col-12 col-md-6 col-xl-3"><span class="text-muted">Patente</span><div>@(t?.Plate ?? "—") @(t?.TrailerPlate is { } tp ? $"/ carro {tp}" : "")</div></div>
            <div class="col-12 col-md-6 col-xl-3"><span class="text-muted">Chofer</span><div>@(t?.DriverName ?? "—") @(t?.DriverTaxId is { } d ? $"({d})" : "")</div></div>
            <div class="col-12 col-md-6 col-xl-3"><span class="text-muted">Transportista</span><div>@(t?.CarrierName ?? "—") @(t?.CarrierTaxId is { } c ? $"({c})" : "")</div></div>
        </div>
    }

    <div class="doc-form-layout-section border-top pt-3 mt-3 mb-2">5. Observaciones</div>
    <p class="mb-0" style="white-space:pre-line;">@(i.Notes ?? "—")</p>

    <div class="doc-form-layout-section border-top pt-3 mt-3 mb-2">6. Detalle</div>
    <div class="table-responsive-lg">
        <table class="table-ps">
            <thead><tr><th>Código</th><th>Descripción</th><th class="text-end">Cantidad</th><th>Unidad</th><th class="text-end">Precio</th><th class="text-end">Monto</th></tr></thead>
            <tbody>
                @foreach (var l in i.Lines)
                {
                    <tr>
                        <td>@(l.ItemCode ?? "—")</td>
                        <td>@l.Description</td>
                        <td class="text-end">@l.Quantity.ToString("N2", es)</td>
                        <td>@(l.Unit ?? "—")</td>
                        <td class="text-end">$@l.UnitPrice.ToString("N0", es)</td>
                        <td class="text-end">$@Math.Round(l.Quantity * l.UnitPrice, 0, MidpointRounding.AwayFromZero).ToString("N0", es)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.CanDelete && g.Status == TransportGuideStatuses.Draft)
    {
        <form method="post" asp-page-handler="Anular" asp-route-id="@g.Id" asp-antiforgery="true" class="d-flex gap-2 align-items-end flex-wrap mt-3"
              data-confirm="@($"¿Anular la guía {Model.Code}?")">
            <div>
                <label class="form-label" for="reason">Motivo de anulación</label>
                <input type="text" id="reason" name="reason" class="form-control" required maxlength="200" />
            </div>
            <button type="submit" class="btn btn-danger">Anular guía</button>
        </form>
    }
</div>

@section Scripts {
    <script src="~/js/despachos-maestros.js" asp-append-version="true"></script>
}
